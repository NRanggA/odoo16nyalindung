<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_inherit_form" model="ir.ui.view">
        <field name="name">mrp.production.inherit.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//field[@name='product_qty']" position="after">
                <button string="Qty To Produce" name="get_target_production" type="object" class="btn-warning" states="draft"/>
            </xpath> -->
            <field name="user_id" position="after">
                <field name="must_have_source_mo" invisible="1"/>
                <field name="source_mo_id" attrs="{'required': [('must_have_source_mo','=', True)], 'invisible': [('must_have_source_mo','=', False)]}" options="{'no_create': True}"/>
            </field>
            <field name="origin" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_name" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="after">
                <button string="Qty To Produce" 
                        name="get_target_production" 
                        type="object" 
                        class="btn-warning" 
                        attrs="{'invisible': [
                            '|',                                      
                            ('product_id', '=', False),             
                            '|',                                     
                                ('product_name', 'not in', ['Sheet','Compo']),
                                ('state', '!=', 'draft')                 
                        ]}"/>
            </xpath>
            <page name="finished_products" position="before">
                <page name="manual_consume" string="Manual Consume">
                    <!-- attrs="{'readonly': ['|', ('state', '=', 'cancel'), '&amp;', ('state', '=', 'done'), ('is_locked', '=', True)]}" -->
                    <field name="manual_consume_ids"  readonly="1"
                            context="{'default_bom_id': bom_id, 'default_company_id': company_id}"/>
                </page>
            </page>
            <xpath expr="//header" position="inside">
                <button name="action_draft" type="object" string="Draft" states="cancel" class="btn-default"/>
            </xpath>
        </field>
    </record>


    <!-- Inherit View Form Wizard -->
    <record id="view_mrp_consumption_warning_form_inherit_ny_mrp" model="ir.ui.view">
        <field name="name">Consumption Warning - Hide Set Qty Button</field>
        <field name="model">mrp.consumption.warning</field>
        <field name="inherit_id" ref="mrp.view_mrp_consumption_warning_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='action_set_qty']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@class='m-2']" position="replace">
                <div class="m-2">
                    Anda akan mengkonsumsi quantity komponen yang berbeda dengan nilai BOM 
                    untuk produk di bawah ini, apakah Anda yakin akan melanjutkan?
                    <b attrs="{'invisible': [('consumption', '=', 'strict')]}">
                        Mohon konfirmasi jika ini memang disengaja.
                    </b>
                    <b attrs="{'invisible': [('consumption', '!=', 'strict')]}">
                        Mohon periksa kembali konsumsi komponen Anda atau minta manajer 
                        untuk memvalidasi 
                        <span attrs="{'invisible':[('mrp_production_count', '!=', 1)]}">MO ini</span>
                        <span attrs="{'invisible':[('mrp_production_count', '=', 1)]}">MO berikut</span>.
                    </b>
                </div>
            </xpath>
        </field>
    </record>


</odoo>
