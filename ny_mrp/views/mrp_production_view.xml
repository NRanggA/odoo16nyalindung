<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_inherit_form" model="ir.ui.view">
        <field name="name">mrp.production.inherit.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//field[@name='product_qty']" position="after">
                <button string="Qty To Produce" name="get_target_production" type="object" class="btn-warning" states="draft"/>
            </xpath> -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_name" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="after">
                <button string="Qty To Produce" 
                        name="get_target_production" 
                        type="object" 
                        class="btn-warning" 
                        attrs="{'invisible': [
                            '|',                                      
                            ('product_id', '=', False),             
                            '|',                                     
                            ('product_name', '!=', 'Sheet'),       
                            ('state', '!=', 'draft')                 
                        ]}"/>
            </xpath>
            <page name="finished_products" position="before">
                <page name="manual_consume" string="Manual Consume">
                    <!-- attrs="{'readonly': ['|', ('state', '=', 'cancel'), '&amp;', ('state', '=', 'done'), ('is_locked', '=', True)]}" -->
                    <field name="manual_consume_ids"  readonly="1"
                            context="{'default_bom_id': bom_id, 'default_company_id': company_id}"/>
                </page>
            </page>
            <xpath expr="//header" position="inside">
                <button name="action_draft" type="object" string="Draft" states="cancel" class="btn-default"/>
            </xpath>
        </field>
    </record>

</odoo>
