<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_mrp_sheet_to_produce_view_form" model="ir.ui.view">
        <field name="name">wizard.mrp.sheet.to.produce.view.form</field>
        <field name="model">wizard.mrp.sheet.to.produce</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="mrp_id" invisible="1"/>
                        <field name="product_latex_id" />
                        <field name="bom_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="latex_onhand_qty" />
                        <field name="sheet_to_produce" />
                    </group>
                </group>
                <footer>
                    <button string="Apply" name="action_apply" type="object" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_mrp_sheet_to_produce_action" model="ir.actions.act_window">
        <field name="name">Sheet to Produce</field>
        <field name="res_model">wizard.mrp.sheet.to.produce</field>
        <field name="view_mode">form</field>
        <field name="target" >new</field>
    </record>
</odoo>