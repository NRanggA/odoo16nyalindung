<odoo>
    <template id="invoice_report_custom">
        <t t-call="web.html_container">
            <head>
                <style>
                    table.bordered {
                        border-collapse: collapse;
                        width: 100%;
                    }
                    table.bordered th, table.bordered td {
                        border: 1px solid black;
                        padding: 5px;
                    }
                    .right-align {
                        text-align: right;
                    }
                    table.no-border {
                        border-collapse: collapse;
                        width: 100%;
                    }
                    table.no-border th, table.no-border td {
                        border: -1px solid black;
                        padding: 5px;
                    }
                    table.no-border2 {
                        border-collapse: collapse;
                        width: 100%;
                    }
                    table.no-border2 th, table.no-border2 td {
                        border: -1px solid black;
                        padding: 2px;
                    }
                </style>
            </head>
            <t t-foreach="docs" t-as="o">
                <!-- Tabel Pertama -->
                <div class="invoice-table">
                    <img t-att-src="'%s/nyalindung_report/static/img/ny_logo.png' % (request.env['ir.config_parameter'].sudo().get_param('web.base.url'))" width="225px" height="60px" alt="Logo"/>
                    <div style="border-bottom: 5px solid black; width: 100%; margin-top: 10px;"></div>
                    <h2 style="text-align: center; font-weight: bold; text-decoration: underline; font-size: 32px;">INVOICE</h2>
                    <div style="width: 100%; display: flex; justify-content: space-between; font-size: 12px;">
                        <table style="width: 100%;">
                            <tr>
                                <td style="font-weight: bold;"><t t-esc="o.partner_id.name"/></td>
                                <td style="padding-left: 70px;">No Invoice</td>
                                <td>: </td>
                                <td><t t-esc="o.name"/></td>
                            </tr>
                            <tr>
                                <td style="width: 50%; font-size: 10px;"><t t-esc="o.partner_id.contact_address"/></td>
                                <td style="padding-left: 70px;">Due Date</td>
                                <td>: </td>
                                <td><t t-esc="o.invoice_date_due"/></td>
                            </tr>
                            <tr>
                                <td><t t-esc="o.partner_id.vat or ''"/></td>
                                <td style="padding-left: 70px;">Date Invoice</td>
                                <td>: </td>
                                <td><t t-esc="o.invoice_date"/></td>
                                <!-- <td t-if="o.invoice_line_ids" rowspan="3">
                                    <t t-foreach="o.invoice_line_ids" t-as="line" t-if="line.plantation_activity_id">
                                        <span><t t-esc="line.plantation_activity_id.name or 'N/A'"/></span>
                                        <br/>
                                    </t>
                                </td> -->
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Tabel Kedua -->
                <table class="bordered" style="font-size: 12px;">
                    <tr>
                        <th>No.</th>
                        <th style="text-align: center;">Deskripsi/Product</th>
                        <th style="text-align: center;">Qty</th>
                        <th style="text-align: center;">UoM</th>
                        <th style="text-align: center;">Price</th>
                        <th style="text-align: center;">Amount</th>
                    </tr>
                    <t t-set="index" t-value="0"/>
                    <t t-foreach="o.invoice_line_ids" t-as="line">
                        <t t-set="index" t-value="index + 1"/>
                        <tr style="border: 1px solid black;">
                            <td style="border: 1px solid black;"><t t-esc="index"/></td>
                            <td><t t-esc="line.name"/></td>
                            <td style="text-align: center;"><t t-esc="line.quantity"/></td>
                            <td style="text-align: center;"><t t-esc="line.product_uom_id.name"/></td>
                            <td class="right-align">Rp <t t-esc="o.format_amount(line.price_unit)"/></td>
                            <td class="right-align">Rp <t t-esc="o.format_amount(line.price_subtotal)"/></td>
                        </tr>
                    </t>
                </table>

                <!-- Perhitungan Sub Total dan Total Diskon -->
                <t t-set="sub_total" t-value="sum(line.price_unit * line.quantity for line in o.invoice_line_ids)"/>
                <t t-set="total_discount" t-value="sum(line.price_unit * line.quantity * line.discount / 100 for line in o.invoice_line_ids)"/>

                <!-- Tabel Ketiga -->
                <table class="no-border2" style="font-size: 12px;">
                    <tr>
                        <td colspan="4" class="terbilang">Terbilang :</td>
                        <td class="right-align col-narrow">Sub Total:</td>
                        <td class="right-align"><t t-esc="o.currency_id.symbol"/></td>
                        <td class="right-align col-narrow"><t t-esc="o.format_amount(sub_total)"/></td>
                    </tr>
                    <tr>
                        <td colspan="4" class="terbilang" style="font-style: italic; font-weight: bold;"><t t-esc="o.amount_text"/> rupiah</td>
                        <td class="right-align">Disc Total:</td>
                        <td class="right-align"><t t-esc="o.currency_id.symbol"/></td>
                        <td class="right-align"><t t-esc="o.format_amount(total_discount)"/></td>
                    </tr>
                    <tr t-foreach="o.line_ids.filtered(lambda l: l.tax_ids)" t-as="line">
                        <t t-foreach="line.tax_ids" t-as="tax">
                            <tr>
                                <td colspan="4"></td>
                                <td class="right-align"><t t-esc="tax.name"/>:</td>
                                <td class="right-align"><t t-esc="o.currency_id.symbol"/></td>
                                <td class="right-align">
                                    <t t-set="tax_amount" t-value="(line.price_unit * line.quantity) * (tax.amount / 100)"/>
                                    <t t-esc="o.format_amount(tax_amount)"/>
                                </td>
                            </tr>
                        </t>
                    </tr>
                    <tr>
                        <td colspan="4"></td>
                        <td class="right-align"><strong>Grand Total:</strong></td>
                        <td class="right-align"><strong><t t-esc="o.currency_id.symbol"/></strong></td>
                        <td class="right-align"><strong><t t-esc="o.format_amount(o.amount_total)"/></strong></td>
                    </tr>
                </table>
            </t>
        </t>
    </template>
</odoo>
