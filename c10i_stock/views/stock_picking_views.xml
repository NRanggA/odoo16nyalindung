<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_inherit_c10i_stock" model="ir.ui.view">
        <field name="name">c10i_stock.stock_picking.view.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="before">
                <field name="no_kendaraan"/>
                <field name="no_expedisi"/>
            </xpath>
            <xpath expr="//button[@name='354']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', '==', 'done')]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
