<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_report_detail_receipt_view_form" model="ir.ui.view">
        <field name="name">wizard.report.detail.receipt.view.form</field>
        <field name="model">wizard.report.detail.receipt</field>
        <field name="arch" type="xml">
            <form string="Report Detail Receipt">
                <sheet>
                    <group>
                        <group>
                            <field name="from_date" required="1"/>
                        </group>
                        <group>
                            <field name="to_date" required="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="with_accounting_journal" groups="account.group_account_user"/>
                        </group>
                        <group>
                            <field name="picking_type_id" options="{'no_create': True, 'no_edit': True}" required="1" domain="[('code', '=', 'incoming')]"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Print" type="object" name="create_report" class="btn-primary"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wizard_report_detail_receipt_action" model="ir.actions.act_window">
        <field name="name">Report Detail Receipt</field>
        <field name="res_model">wizard.report.detail.receipt</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="wizard_report_detail_receipt_menu"
        name="Report Detail Receipt"
        action="wizard_report_detail_receipt_action"
        parent="stock.menu_warehouse_report"
        sequence="250"/>
</odoo>
