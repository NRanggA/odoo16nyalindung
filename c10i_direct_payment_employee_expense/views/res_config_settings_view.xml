<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.account</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/> <!--ref="c10i_direct_payment.res_config_settings_view_form"-->
            <field name="arch" type="xml">
                <xpath expr="//div[@name='fiscal_localization_setting_container']" position="after">
                    <h2>Employee Advance Account</h2>
                    <div class="row mt16 o_settings_container" name="direct_payment_employee_advance_account_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="direct_payment_employee_advance_account">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Temporary Account Inbound/Outbound</span>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                                <div class="text-muted">
                                    Employee Advance Account when creating a Employee Expense Direct Payment Entry
                                </div>
                                <!-- <div class="content-group"> -->
                                    <div class="row mt16">
                                        <label for="employee_advance_account_id" class="col-lg-3 o_light_label"/>
                                        <field name="employee_advance_account_id"/>
                                    </div>
                                <!-- </div> -->
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>