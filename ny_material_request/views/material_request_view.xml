<odoo>
    <record id="material_request_c10i_material_request" model="ir.ui.view">
        <field name="name">material.request.c10i.material.request</field>
        <field name="model">material.request</field>
        <field name="inherit_id" ref="c10i_material_request.material_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requested_by']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='requested_by']" position="after">
                <field name="requested_by_2"/>
            </xpath>
            <xpath expr="//field[@name='requested_by_2']" position="before">
                <field name="create_uid" readonly="1" options="{'force_save': True}"/>
            </xpath>
        </field>
    </record>

    <record id="material_request_c10i_material_request_tree" model="ir.ui.view">
        <field name="name">material.request.c10i.material.request.tree</field>
        <field name="model">material.request</field>
        <field name="inherit_id" ref="c10i_material_request.material_request_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requested_by']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='requested_by']" position="before">
                <field name="create_uid"/>
            </xpath>
        </field>
    </record>

    <record id="material_request_stock_picking_tree" model="ir.ui.view">
        <field name="name">material.request.stock.picking.tree</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="employee_id"/>
            </xpath>
        </field>
    </record>


    <record id="material_request_batch_form" model="ir.ui.view">
        <field name="name">material.request.form</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <button name="action_submit" string="Submit" states="draft" type="object" class="oe_highlight"/>
                    <button name="action_approved" string="Approve" states="submit" type="object" class="oe_highlight" groups="c10i_material_request.group_material_request_manager"/>
                    <button name="action_done" string="Close" type="object" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','approved'),('issue_state','!=','issued')]}"/>
                    <button name="force_close" string="Force Close" attrs="{'invisible': [('allow_force_close','=',False)]}" type="object"/>
                    <button name="action_reject" string="Reject" states="submit" type="object" groups="c10i_material_request.group_material_request_manager"/>
                    <button name="action_cancel" string="Cancel" states="draft,submit,reject,approved" type="object" groups="c10i_material_request.group_material_request_manager"/>
                    <button name="action_draft" string="Set to Draft" states="cancel,reject" type="object" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit,approved,cancel"/>
                </header>
                <sheet>
                    <field name="issue_state" invisible="1" />
                    <field name="allow_force_close" invisible="1" />
                    <div class="oe_button_box" name="button_box">
                        <div class="d-flex justify-content-end">
                            <button type="object" name="action_open_picking"
                                icon="fa-pencil-square-o" attrs="{'invisible':[('picking_count', '=', 0)]}"
                                class="oe_stat_button"
                                groups="stock.group_stock_user">
                                <field name="picking_count" widget="statinfo"/>
                            </button>
                            <button type="object" name="action_open_purchase_request"
                                icon="fa-shopping-cart" attrs="{'invisible': [('state','!=','approved'),('purchase_request_count','=',0)]}"
                                class="oe_stat_button"
                                groups="purchase_request.group_purchase_request_user">
                                <field name="purchase_request_count" widget="statinfo"/>
                            </button>
                        </div>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <!-- <field name="requested_by" options="{'no_create_edit': True, 'no_create': True}" attrs="{'readonly': [('parent.state','!=','draft')]}"/> -->
                            <!-- <field name="requested_by_2" required="1" options="{'no_create_edit': True, 'no_create': True}" attrs="{'readonly': [('parent.state','!=','draft')]}"/> -->
                            <field name="description" attrs="{'readonly': [('state','!=','draft')]}"/>
                        </group>
                        <group>
                            <field name="date_request" required="1" attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="picking_type_id" required="1" attrs="{'readonly': [('state','!=','draft')]}" options="{'no_create_edit': True, 'no_create': True}"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="line_ids" required="1" attrs="{'readonly': [('state','in',('done','reject','cancel'))]}" >
                                <tree editable="bottom">
                                    <field name="requested_by" required="1" options="{'no_create_edit': True, 'no_create': True}" attrs="{'readonly': [('parent.state','!=','draft')]}"/>
                                    <field name="product_id" required="1" options="{'no_create_edit': True, 'no_create': True}" attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
                                    <field name="product_asset" readonly="1" string="Equipment" />
                                    <field name="name" attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
                                    <field name="location_type_id" 
                                        options="{'no_create_edit': True, 'no_create': True}"/>
                                    <field name="no_line" invisible="1"/>
                                    <field name="varieties_id" 
                                        options="{'no_create_edit': True, 'no_create': True}" 
                                        attrs="{'required': [('no_line','=',False)],
                                                'readonly': [('no_line','=',True)]}"/>
                                    <!-- attrs="{'required': [('cost_allocation_mark','!=','none')]}" -->
                                    <field name="filtered_locations" invisible="1" />
                                    <field name="location_id" 
                                        domain="[('id','in',filtered_locations)]"
                                        options="{'no_create_edit': True, 'no_create': True}"
                                        attrs="{'required': [('no_line','=',False)],
                                                'readonly': [('no_line','=',True)]}"/>
                                    <field name="filtered_activities" invisible="1" />
                                    <field name="activity_id" 
                                        options="{'no_create_edit': True, 'no_create': True}" 
                                        domain="[('id','in',filtered_activities)]"
                                        attrs="{'required': [('no_line','=',False)],
                                            'readonly': [('no_line','=',True)]}"/>
                                    <field name="product_qty" attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
                                    <field name="qty_available"/>
                                    <field name="uom_id" required="1" options="{'no_create_edit': True, 'no_create': True}" attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
                                    <field name="qty_issued_method" invisible="1"/>
                                    <field name="qty_done_manual" invisible="1"/>
                                    <field name="qty_done" attrs="{'column_invisible': [('parent.state', 'not in', ('approved', 'done'))], 'readonly': [('qty_issued_method', '!=', 'manual')]}" optional="show"/>
                                    <field name="qty_to_issue" invisible="1"/>
                                </tree>
                                <form>
                                    <label for="name" />
                                    <field name="name" nolabel="1"/>
                                    <group>
                                        <group>
                                            <field name="product_id" options="{'no_create_edit': True, 'no_create': True}"/>
                                            <field name="product_qty"/>
                                            <field name="uom_id" options="{'no_create_edit': True, 'no_create': True}"/>
                                        </group>
                                        <group>
                                            <field name="qty_done"/>
                                            <field name="qty_available"/>
                                        </group>
                                    </group>
                                    <label for="move_ids" attrs="{'invisible': [('move_ids','=',[])]}"/>
                                    <field name="move_ids" attrs="{'invisible': [('move_ids','=',[])]}" readonly="1"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="action_material_request_batch">
        <field name="name">Material Requests Batch</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">material.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain"></field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="c10i_material_request.material_request_search" />
    </record>

    <record id="action_material_request_batch_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="act_window_id" ref="action_material_request_batch"/>
        <field name="view_id" ref="c10i_material_request.material_request_tree"/>
    </record>
    
    <record id="action_material_request_batch_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="act_window_id" ref="action_material_request_batch"/>
        <field name="view_id" ref="material_request_batch_form"/>
    </record>

    <menuitem
        id="submenu_material_request"
        name="Material Request Batch"
        action="action_material_request_batch"
        parent="c10i_material_request.submenu_material_request"
        sequence="10"/>
</odoo>