<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.module.category" id="module_category_material_request">
        <field name="name">Material Request</field>
        <field name="parent_id" ref="base.module_category_inventory_inventory" />
        <field name="sequence">10</field>
    </record>
    <record id="group_material_request_user" model="res.groups">
        <field name="name">Material Request User</field>
        <field name="category_id" ref="module_category_material_request" />
    </record>
    <record id="group_material_request_manager" model="res.groups">
        <field name="name">Material Request Manager</field>
        <field
            name="implied_ids"
            eval="[(4, ref('c10i_material_request.group_material_request_user'))]"
        />
        <field name="category_id" ref="module_category_material_request" />
    </record>
    <record id="group_material_request_user_inventory" model="res.groups">
        <field name="name">Material Request Inventory</field>
        <field
            name="implied_ids"
            eval="[(4, ref('c10i_material_request.group_material_request_manager'))]"
        />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="category_id" ref="module_category_material_request" />
    </record>
    <record model="ir.rule" id="material_request_comp_rule">
        <field name="name">Material Request multi-company</field>
        <field name="model_id" ref="model_material_request" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
    <record model="ir.rule" id="material_request_line_comp_rule">
        <field name="name">Material Request Line multi-company</field>
        <field name="model_id" ref="model_material_request_line" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('mr_id.company_id','=',False),('mr_id.company_id', 'in', company_ids)]
        </field>
    </record>
    <record id="material_request_followers_rule" model="ir.rule">
        <field name="name">Follow Material Request</field>
        <field name="model_id" ref="model_material_request" />
        <field name="groups" eval="[(6,0, [ref('group_material_request_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">
            ['|',('requested_by','=',user.id),
                ('message_partner_ids', 'in',[user.partner_id.id])]
        </field>
    </record>
    <record id="material_request_rule" model="ir.rule">
        <field name="name">Material Request User</field>
        <field name="model_id" ref="model_material_request" />
        <field name="groups" eval="[(6,0, [ref('group_material_request_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">[('requested_by','=',user.id)]</field>
    </record>
    <record id="material_request_manager_rule" model="ir.rule">
        <field name="name">Material Request Manager</field>
        <field name="model_id" ref="model_material_request" />
        <field name="groups" eval="[(6,0, [ref('group_material_request_manager')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
