<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_packaging_form_view" model="ir.ui.view">
        <field name="name">product.packaging.inherit.form</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="before">
                <field name="is_pisang" />
                <field name="scrap_qty" attrs="{'invisible': [('is_pisang','=',False)]}"/>
            </field>
        </field>
    </record>

    <record id="stock_ripening_pisang_view_form" model="ir.ui.view">
        <field name="name">stock_ripening_pisang.view.form</field>
        <field name="model">stock.ripening.pisang</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Confirm" name="action_confirm" type="object" class="oe_highlight" states="draft"/>
                    <button string="Validate" name="action_validate" type="object" class="oe_highlight" states="confirm"/>
                    <button string="Cancel" name="action_cancel" type="object" class="btn btn-danger" states="draft,confirm,done"/>
                    <button string="Set to draft" name="action_draft" type="object" class="btn btn-primary" states="cancel"/>
                    <button string="Return Scrap" name="create_return_scrap" type="object" class="btn btn-primary" attrs="{'invisible': [('has_qty_scrap', '=', False)]}"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,cancel,confirm,done" />
                </header>
                <sheet>
                    <field name="stock_picking_repening_count" invisible="1"/>
                    <field name="stock_picking_return_scrap_count" invisible="1"/>
                    <field name="stock_scrap_count" invisible="1"/>
                    <field name="has_qty_scrap" invisible="1"/>
                    <!-- <field name="scrap_ids" invisible="1"/> -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-exchange" 
                            string="Transfers" attrs="{'invisible': [('stock_picking_repening_count', '=', 0)]}" />
                        <button name="action_view_return_scrap" type="object" class="oe_stat_button" icon="fa-exchange" 
                            string="Return Scraps" attrs="{'invisible': [('stock_picking_return_scrap_count', '=', 0)]}"/>
                        <button name="action_view_scraps" type="object" class="oe_stat_button" icon="fa-arrows-v" 
                            string="Scraps" attrs="{'invisible': [('stock_scrap_count', '=', 0)]}"/>
                    </div>
                    <h1>
                        <field name="name" nolabel="1" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="date" attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="date_done" readonly="1" attrs="{'invisible': [('date_done','=',False)]}"/>
                            <field name="company_id" invisible="1" attrs="{'readonly': [('state','!=','draft')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="line" string="Lines">
                            <field name="line_ids" attrs="{'readonly': [('state','!=','draft')]}">
                                <tree editable="bottom">
                                    <field name="product_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                                    <field name="product_tmpl_id" invisible="1"/>
                                    <field name="product_uom_category_id" invisible="1"/>
                                    <field name="product_uom" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                                    <field name="product_qty" invisible="1"/>
                                    <field name="product_packaging_id" context="{'default_is_pisang': True, 'default_product_id': product_id}"/>
                                    <field name="product_packaging_qty" />
                                    <field name="out_product_qty" />
                                    <field name="out_product_scrap_qty" />
                                    <field name="company_id" invisible="1"/>
                                    <field name="qty_received" />
                                    <field name="qty_scrap" />
                                </tree>
                            </field>

                            <label for="note" string="Notes"/>
                            <field name="note" nolabel="1" placeholder="You can put your note here.."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="stock_ripening_pisang_view_tree" model="ir.ui.view">
        <field name="name">stock_ripening_pisang.view.tree</field>
        <field name="model">stock.ripening.pisang</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date" />
                <field name="name" />
                <field name="partner_id" />
                <field name="date_done" />
                <field name="state" widget="badge"
                    decoration-info="state=='confirm'"
                    decoration-success="state=='done'"/>
            </tree>
        </field>
    </record>

    <record id="stock_ripening_pisang_view_search" model="ir.ui.view">
        <field name="name">stock_ripening_pisang.view.search</field>
        <field name="model">stock.ripening.pisang</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <group expand="0" string="Group By">
                    <filter name="groupby_state" string="Status" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_ripening_pisang" model="ir.actions.act_window">
        <field name="name">Nota Ripening Pisang</field>
        <field name="res_model">stock.ripening.pisang</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_stock_ripening_pisang" action="action_stock_ripening_pisang" parent="c10i_lhm_v16.submenu_lhm_nap" groups="c10i_lhm_v16.group_plantation_operator" sequence="3"/>

</odoo>
