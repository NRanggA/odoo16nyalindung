<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lhm_transaction_view_form" model="ir.ui.view">
        <field name="name">lhm.transaction.view.form</field>
        <field name="model">lhm.transaction</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_lhm_transaction_form" />
        <field name="arch" type="xml">
            <div class="oe_title" position="before">
                <div name="button_box" class="oe_button_box">
                    <button type="object"
                            name="action_open_related_lhm_naps"  
                            class="oe_stat_button" 
                            icon="fa-folder-open"
                            attrs="{'invisible': [('unique_lhm_nap_ids', '=', 0)]}">
                        <field name="unique_lhm_nap_ids" widget="statinfo"/>
                    </button>
                </div>
            </div>

            <button name="run_progress" position="attributes">
                <attribute name="groups">c10i_lhm_v16.plantation_lhm_approver,ny_plantation.plantation_kepala_mandor_user</attribute>
            </button>

            <button name="button_confirm" position="attributes">
                <attribute name="groups">c10i_lhm_v16.plantation_lhm_approver,ny_plantation.plantation_kepala_mandor_user</attribute>
            </button>

            <button name="button_approve" position="before">
                <button string="Approve Kepala Mandor" name="action_approve_kepala_mandor" 
                    type="object" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','confirmed'),('kepala_mandor_approved','=',True)]}"
                    groups="ny_plantation.plantation_kepala_mandor_user"
                    confirm="Apakah anda menyetujui dokumen ini?"/>
            </button>

            <!-- <field name="afdeling_id" position="replace"/> -->
            <field name="asisten_mandor_id" position="replace"/>
            <field name="mandor_id" position="replace"/>
            <field name="kerani_id" position="replace"/>
            <field name="nik_kerani" position="replace"/>
            <!-- <field name="nik_mandor_1" position="replace"/>
            <field name="nik_mandor" position="replace"/> -->
            
            <field name="kemandoran_id" position="after">
                <field name="assisten_id" domain="[('kerani','=',True)]" context="{'form_view_ref':'c10i_lhm_v16.view_karyawan_form'}"/>
                <field name="kepala_mandor_id" domain="[('kerani','=',True)]" context="{'form_view_ref':'c10i_lhm_v16.view_karyawan_form'}"/>
                <field name="kepala_mandor_approved" invisible="1"/>
                <field name="mandor_id" domain="[('kerani','=',True)]" context="{'form_view_ref':'c10i_lhm_v16.view_karyawan_form'}"/>
                <field name="tap_kontrol_id" domain="[('kerani','=',True)]" context="{'form_view_ref':'c10i_lhm_v16.view_karyawan_form'}"/>
            </field>
            <field name="location" position="after">
                <field name="nik_assisten" context="{'form_view_ref':'c10i_lhm_v16.view_karyawan_form'}"/>
            </field>
            <field name="company_id" position="before">
                <field name="nik_tap_kontrol" context="{'form_view_ref':'c10i_lhm_v16.view_karyawan_form'}"/>
            </field>
        </field>
    </record>

    <record id="view_lhm_transaction_tree" model="ir.ui.view">
        <field name="name">lhm.transaction.view.form</field>
        <field name="model">lhm.transaction</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_lhm_transaction_tree" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="kepala_mandor_approved"/>
            </field>
        </field>
    </record>

    <record id="view_lhm_transaction_filter" model="ir.ui.view">
        <field name="name">view.lhm.transaction.filter</field>
        <field name="model">lhm.transaction</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_lhm_transaction_filter" />
        <field name="arch" type="xml">
            <filter name="confirmed" position="after">
                <filter name="kepala_mandor_not_approved" string="Not Approved by Kepala Mandor" domain="[('kepala_mandor_approved','=',False)]"/>
                <filter name="kepala_mandor_has_approved" string="Approved by Kepala Mandor" domain="[('kepala_mandor_approved','=',True)]"/>
            </filter>
        </field>
    </record>

    <record id="view_lhm_transaction_form" model="ir.ui.view">
        <field name="name">view.lhm.transaction.form</field>
        <field name="model">lhm.transaction</field>
        <field name="inherit_id" ref="c10i_plantation_payroll.view_lhm_transaction_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lhm_line_ids']/tree/field[@name='contract_wage_value']" position="attributes">
                <attribute name="groups">base.group_no_one,c10i_hr_payroll.group_hr_payroll_user,ny_plantation.plantation_kepala_mandor_user</attribute>
            </xpath>
            <xpath expr="//field[@name='lhm_line_ids']/tree/field[@name='contract_wage_value']" position="before">
                <field name="drc_latex" />
                <field name="drc_lump" />
                <field name="do_lansir" />
                <field name="upah_produksi_sheet" groups="base.group_no_one,c10i_hr_payroll.group_hr_payroll_user,ny_plantation.plantation_kepala_mandor_user" optional="hide"/>
                <field name="upah_produksi_compo" groups="base.group_no_one,c10i_hr_payroll.group_hr_payroll_user,ny_plantation.plantation_kepala_mandor_user" optional="hide"/>
                <field name="inst_produksi_sheet" groups="base.group_no_one,c10i_hr_payroll.group_hr_payroll_user,ny_plantation.plantation_kepala_mandor_user" optional="hide"/>
                <field name="inst_produksi_compo" groups="base.group_no_one,c10i_hr_payroll.group_hr_payroll_user,ny_plantation.plantation_kepala_mandor_user" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
