<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_filter_inherit_custom" model="ir.ui.view">
        <field name="name">hr.employee.search.inherit.custom</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="kemandoran_id" string="Kemandoran"/>
                <field name="mandor_id" string="Mandor"/>
            </xpath>

            <xpath expr="//group" position="inside">
                <filter string="Kemandoran" name="kemandoran_id" context="{'group_by': 'kemandoran_id'}"/>
                <filter string="Mandor" name="mandor_id" context="{'group_by': 'mandor_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Menambahkan validasi untuk field lokasi pada hr -->
    <record id="view_hr_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.fom.inherit.custom</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_employee_form_inherit_lhm"/>
        <field name="arch" type="xml">
            <field name="plantation_location_id" position="after">
                <field name="penyadap" invisible="1"/>
            </field>
            <field name="plantation_location_id" position="attributes">
                <attribute name="attrs">{"required": [["penyadap", "=", True]]}</attribute>
            </field>
        </field>
    </record>



</odoo>
