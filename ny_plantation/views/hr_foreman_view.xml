<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_foreman_view_form" model="ir.ui.view">
        <field name="name">hr.foreman.view.form</field>
        <field name="model">hr.foreman</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_hr_foreman_form" />
        <field name="arch" type="xml">
            <field name="foreman_id_1" position="replace"/>
            <field name="foreman_id" position="replace"/>
            <field name="admin_id_1" position="replace"/>
            <field name="admin_id" position="replace"/>
            
            <field name="code" position="after">
                <field name="assisten_id" context="{'form_view_ref':'c10i_lhm_v16.view_karyawan_form'}"/>
                <field name="kepala_mandor_id" context="{'form_view_ref':'c10i_lhm_v16.view_karyawan_form'}"/>
                <field name="mandor_id" context="{'form_view_ref':'c10i_lhm_v16.view_karyawan_form'}"/>
                <field name="tap_kontrol_id" context="{'form_view_ref':'c10i_lhm_v16.view_karyawan_form'}"/>
            </field>
            <field name="afdeling_id" position="after">
                <field name="blok_tanam_id" />
            </field>

            <field name="nik_mandor_1" position="replace"/>
            <field name="nik_mandor" position="replace"/>
            <field name="nik_kerani_1" position="replace"/>
            <field name="nik_kerani" position="replace"/>

            <field name="department_id" position="after">
                <field name="nik_assisten" />
                <field name="nik_kepala_mandor" />
                <field name="nik_mandor" />
                <field name="nik_tap_kontrol" />
            </field>
        </field>
    </record>

    <record id="hr_foreman_view_tree" model="ir.ui.view">
        <field name="name">hr.foreman.view.form</field>
        <field name="model">hr.foreman</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_hr_foreman_tree" />
        <field name="arch" type="xml">
            <field name="foreman_id_1" position="replace"/>
            <field name="foreman_id" position="replace"/>
            <field name="admin_id" position="replace"/>
            
            <field name="name" position="after">
                <field name="kepala_mandor_id"/>
                <field name="mandor_id"/>
            </field>
        </field>
    </record>

</odoo>
