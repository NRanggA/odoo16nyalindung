<?xml version="1.0"?>
<odoo>
    <record id="view_material_receipt_button" model="ir.ui.view">
        <field name="name">Material Receipt Button</field>
        <field name="model">lhm.nap</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_lhm_nap_form"/>
        <field name="arch" type="xml">
            <div class="oe_title" position="before">
                <div name="button_box" class="oe_button_box">
                    <button type="object"
                            name="action_open_related_lhm_transactions"  
                            class="oe_stat_button" 
                            icon="fa-folder-open"
                            attrs="{'invisible': [('unique_lhm_transaction_ids', '=', 0)]}">
                        <field name="unique_lhm_transaction_ids" widget="statinfo"/>
                    </button>
                    <button type="object"
                            name="action_open_material_receipt"
                            class="oe_stat_button"
                            icon="fa-truck"
                            attrs="{'invisible': [('material_receipt_count', '=', 0)]}">
                        <field name="material_receipt_count" widget="statinfo"/>
                    </button>
                </div>
            </div>
        </field>
    </record>

    <record id="view_lhm_nap_tree_inherit" model="ir.ui.view">
        <field name="name">lhm.nap.tree.inherit.material</field>
        <field name="model">lhm.nap</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_lhm_nap_tree"/>  <!-- Ganti module_name dengan modul aslinya -->
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ownership']" position="after">
                <field name="materials" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>



</odoo>
