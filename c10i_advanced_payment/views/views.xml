<odoo>
  <data>

      <record id="action_vendor_bill_advanced" model="ir.actions.act_window">
        <field name="name">Purchase Advance</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="domain">['|','|',('move_type', '=', 'in_invoice'), ('is_advanced', '=', True), ('has_advanced', '=', True)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_is_advanced': 1}</field>
      </record>

      <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">        
        <field name="domain">[('move_type', '=', 'in_invoice'), ('is_advanced', '=', False), ('has_advanced', '=', False)]</field>        
      </record>

      <menuitem action="action_vendor_bill_advanced" id="menu_purchase_advance_id" parent="account.menu_finance_payables" sequence="40"/>


