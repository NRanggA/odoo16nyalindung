<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_move_form_inherit_account_advanced_vendor" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.vendor.advanced.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']/tree" position="inside">
                <field name="advanced_move_id" readonly="1"/>
            </xpath>
            <xpath expr="//div[@name='journal_div']" position="after">

                <!-- <field name="has_advanced" attr="{'invisible':[('move_type','not in',['in_invoice','out_invoice'])]}" /> -->
                <field name="has_advanced" invisible="1"/>
                <field name="is_advanced" invisible="1"/>
                <field name="is_po_advanced" invisible="1"/>
                <field name="advanced_purchase_id" invisible="1"/>
            </xpath>

            <xpath expr="//button[@name='button_draft']" position="after">
                <button string="Add Advanced" name="action_add_advanced" type="object" attrs="{'invisible': ['|','|',('is_advanced','=',True),('has_advanced','=',True),('is_po_advanced','=',False)]}"/>
                <button string="Remove Advanced" name="action_remove_advanced" type="object" attrs="{'invisible': ['|',('is_advanced','=',True),('has_advanced','=',False)]}"/>
            </xpath>


            <!-- Menargetkan node tree pada invoice_line_ids -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('parent.move_type', '=', 'in_invoice'), ('parent.is_advanced', '=', True), ('parent.advanced_purchase_id', '!=', False)]}</attribute>
            </xpath>



        </field>
    </record>


    <record id="view_account_move_inherit_amount_residual_advance" model="ir.ui.view">
        <field name="name">account.move.view.tree.inherit,advanced.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_ids']" position="after">
                <field name="is_advanced" invisible="1"/>
                <field name="has_advanced" invisible="1"/>
                <field name="advance_residual" attrs="{'invisible': [('is_advanced', '!=', True)]}"/>
            </xpath>
        </field>
    </record>


    <record id="view_account_invoice_filter_inherit_advance" model="ir.ui.view">
        <field name="name">account.invoice.filter.inherit.advance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_check']" position="after">
                <separator/>
                <filter name="advance_residual"
                        string="Amount to Clear"
                        domain="[('advance_residual', '>', 0)]"/>
                <separator/>
            </xpath>
        </field>
    </record>



</odoo>
