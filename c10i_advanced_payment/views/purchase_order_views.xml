<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_inherit_purchase" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='button_unlock']" position="after">
                <button string="Create Advanced" name="action_create_advanced_payment" type="object" class="oe_highlight" states="purchase"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- <button name="action_view_advanced_purchase" type="object" class="oe_stat_button" icon="fa-"> -->
                <button name="action_view_advanced_purchase" type="object" class="oe_stat_button" icon="fa-money" attrs="{'invisible':[('count_advanced_purchase','&lt;=',0)]}">
                    <field name="count_advanced_purchase" string="Purchase Advanced" widget="statinfo"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
