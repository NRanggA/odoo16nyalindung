<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_advanced_payment" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.advanced</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- <xpath expr="//button[@name='action_draft']" position="after">
                <button string="Create Advanced" name="action_create_advanced_payment" type="object" states="sale" class="oe_highlight"/>
            </xpath> -->

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_advanced_sales" type="object" class="oe_stat_button" icon="fa-money" attrs="{'invisible':[('count_advanced_customer','&lt;=',0)]}">
                    <field name="count_advanced_customer" string="Sales Advance" widget="statinfo"/>
                </button>
            </xpath>

            <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d']" position="replace">
                <button string="Create Invoice" name="action_create_customer_invoice" type="object" class="oe_highlight" attrs="{'invisible': [('invoice_status', '!=', 'to invoice')]}"/>

            </xpath>

        </field>
    </record>

</odoo>
