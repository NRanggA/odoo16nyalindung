<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="product_category_cip" model="product.category">
        <field name="name">CIP Products</field>
        <field name="parent_id" ref="product.product_category_all"/>
    </record>

    <record id="product_template_cip" model="product.template">
        <field name="name">Product CIP</field>
        <field name="type">consu</field>
        <field name="categ_id" ref="product_category_cip"/> 
        <field name="purchase_ok">False</field>
        <field name="sale_ok">False</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
