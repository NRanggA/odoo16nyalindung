<odoo>
    <record id="view_mrp_production_form_inherit_karet" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.karet</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='components']" position="after">
                <page string="Alternatif FG">
                    <field name="alt_finished_ids">
                        <tree>
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="product_qty"/>
                            <field name="quantity_done"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
