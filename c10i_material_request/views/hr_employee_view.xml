<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Penambahan field approver MR pada Form Employee -->
    <record id="inherit_view_id_hr_employee_c10i_material_request" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.c10i.material.request</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="approver_mr_id"/>
            </xpath>
        </field>
    </record>

</odoo>
