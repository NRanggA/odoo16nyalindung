<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="ny_changespass.ShowPasswordEye" owl="1">
        <span class="o_field_show_password fa fa-eye" />
    </t>

    <t t-name="ny_changespass.ShowPassword" t-inherit="web.CharField" owl="1">
        <xpath expr="//input" position="after">
            <ShowPasswordEye t-on-click="toggleShow" />
        </xpath>
    </t>

</templates>