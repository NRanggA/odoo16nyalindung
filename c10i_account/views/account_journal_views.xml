<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_account_journal_form_inherit_disallowed" model="ir.ui.view">
    <field name="name">account.journal.form.disallowed.accounts</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.view_account_journal_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='account_control_ids']" position="after">
        <field name="account_disallowed_ids" widget="many2many_tags"
               options="{'no_create': True}" context="{'default_deprecated': False}" />
      </xpath>
    </field>
  </record>
</odoo>