<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_write_off_view_form" model="ir.ui.view">
        <field name="name">account.write.off.view.form</field>
        <field name="model">account.write.off</field>
        <field name="arch" type="xml">
            <form string="Account Write Off">
                <header>
                    <button name="action_post" states="draft" string="Approve" type="object" class="btn-default btn-primary"/>
                    <button name="get_outstanding" states="draft" string="Get Outstanding" type="object" class="btn-default btn-primary"/>
                    <button name="button_draft" states="posted" string="Set to draft" type="object" class="btn-default"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <!-- <div class="oe_button_box" name="button_box">
                        <button string="Journal" type="object" name="action_view_journal_entry" class="btn-secondary" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    </div> -->
                    <div class="oe_title">
                        <label for="name" string="Nama" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1" force_save="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="write_off_account_id" />
                            <field name="write_off_default_journal_id" />
                            <field name="move_type" invisible="1"/>
                            <field name="move_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Outstanding">
                            <field name="line_ids" nolabel="1" context="{'default_write_off_account_id': write_off_account_id}">
                                <tree editable="bottom">
                                    <field name="move_id"/>
                                    <field name="move_line_id" invisible="0"/>
                                    <field name="date"/>
                                    <field name="due_date"/>
                                    <field name="amount_residual"/>
                                    <field name="write_off"/>
                                    <field name="write_off_amount"/>
                                    <field name="write_off_account_id" />
                                    <field name="reason" required="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_write_off_view_tree" model="ir.ui.view">
        <field name="name">account.write.off.view.tree</field>
        <field name="model">account.write.off</field>
        <field name="arch" type="xml">
            <tree string="Account Write Off">
                <field name="name" />
                <field name="date" />
                <field name="partner_id" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="action_invoice_write_off" model="ir.actions.act_window">
        <field name="name">Invoice Write-off</field>
        <field name="res_model">account.write.off</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type','=','out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="action_bill_write_off" model="ir.actions.act_window">
        <field name="name">Bill Write-off</field>
        <field name="res_model">account.write.off</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type','=','in_invoice')]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

</odoo>
