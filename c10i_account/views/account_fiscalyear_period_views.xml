<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- VIEWS -->

        <!--  Fiscal Year -->

        <record id="view_account_fiscalyear_tree" model="ir.ui.view">
            <field name="name">account.fiscalyear.tree</field>
            <field name="model">account.fiscalyear</field>
            <field name="arch" type="xml">
                <tree sample="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="date_start"/>
                    <field name="date_stop"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
                </tree>
            </field>
        </record>

        <record id="view_account_fiscalyear_search" model="ir.ui.view">
            <field name="name">account.fiscalyear.search</field>
            <field name="model">account.fiscalyear</field>
            <field name="arch" type="xml">
                <search string="Payments">
                    <field name="name" string="Payment"
                        filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <separator/>
                    <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Closed" name="state_done" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <filter string="Status" name="state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </search>
            </field>
        </record>

        <record id="view_account_fiscalyear_form" model="ir.ui.view">
            <field name="name">account.fiscalyear.form</field>
            <field name="model">account.fiscalyear</field>
            <field name="arch" type="xml">
                <form string="Fiscal Year">
                    <header>
                        <button name="create_period" string="Create Monthly Period" type="object" class="oe_highlight"
                                attrs="{'invisible': ['|',('state', '!=', 'draft'),('period_ids', '!=', [])]}"/>
                        <button name="action_close" string="Close Fiscalyear" type="object" class="oe_highlight"
                                attrs="{'invisible': ['|',('state', '!=', 'draft'),('period_ids', '=', [])]}"/>
                        <button name="reopen_fiscalyear" string="Re-Open Fiscalyear" type="object" class="oe_highlight"
                                states='done'/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" attrs="{'readonly': [('state', '!=', 'draft')]}"/></h1>
                        </div>

                        <group>
                            <group name="group1">
                                <field name="code" 
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group name="group2">
                                <field name="date_start" 
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="date_stop" 
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                        </group>

                        <group>
                            <group>
                                <!-- <field name="create_monthly_earning_accrual" invisible="1"/> -->
                                <!-- <field name="journal_id" attrs="{'invisible':[('create_monthly_earning_accrual','=',False)]}"/> -->
                                <field name="journal_id" />
                            </group>
                            <group>
                                <!-- <field name="earning_account_id" attrs="{'invisible':[('create_monthly_earning_accrual','=',False)]}"/> -->
                                <!-- <field name="counterpart_earning_account_id" attrs="{'invisible':[('create_monthly_earning_accrual','=',False)]}"/> -->
                                <field name="move_id" attrs="{'invisible':[('move_id','=',False)]}"/>
                            </group>
                        </group>

                        <field name="period_ids" readonly="1">
                            <tree>
                                <field name="code" />
                                <field name="name" />
                                <field name="date_start" />
                                <field name="date_stop" />
                                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
                            </tree>
                        </field>
                    </sheet>
                    <!-- <div class="o_attachment_preview"/>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div> -->
                </form>
            </field>
        </record>

        <!-- PERIOD -->
        <record id="view_account_period_tree" model="ir.ui.view">
            <field name="name">account.period.tree</field>
            <field name="model">account.period</field>
            <field name="arch" type="xml">
                <tree edit="false" sample="1">
                    <header>
                        <button name="close_period" type="object" string="Close"/>
                        <button name="periodical_post_entries" type="object" string="Post All Entry"/>
                    </header>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="date_start"/>
                    <field name="date_stop"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
                </tree>
            </field>
        </record>

        <record id="view_account_period_search" model="ir.ui.view">
            <field name="name">account.period.search</field>
            <field name="model">account.period</field>
            <field name="arch" type="xml">
                <search string="Payments">
                    <field name="name" string="Period"
                        filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <separator/>
                    <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Closed" name="state_done" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <filter string="Status" name="state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </search>
            </field>
        </record>

        <record id="view_account_period_form" model="ir.ui.view">
            <field name="name">account.period.form</field>
            <field name="model">account.period</field>
            <field name="arch" type="xml">
                <form string="Fiscal Year">
                    <header>
                        <button name="close_period" string="Close Period" type="object" class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="periodical_post_entries" string="Post All Entries" type="object" class="oe_highlight"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="reopen_period" string="Re-Open Period" type="object" class="oe_highlight"
                                attrs="{'invisible': [('state', '=', 'draft')]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>

                    <field name="create_monthly_earning_accrual" invisible="1"/>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <!-- Journal Entries -->
                            <button name="button_open_entries" type="object"
                                    class="oe_stat_button" icon="fa-bars"
                                    attrs="{'invisible': [('journal_entries_count','=', 0)]}">
                                <field name="journal_entries_count" string="Journal Entries" widget="statinfo"/>
<!--                                 <span attrs="{'invisible': [('journal_entries_count','&gt;', 1)]}">Journal Entry</span>
                                <span attrs="{'invisible': [('journal_entries_count','&lt;=', 1)]}">Journal Entries</span> -->
                            </button>
                        </div>
                        <div class="oe_title">
                            <lable for="name">Name</lable>
                            <h1><field name="name" attrs="{'readonly': [('state', '!=', 'draft')]}" placeholder="Period Name"/></h1>
                        </div>

                        <group>
                            <group name="group1">
                                <field name="code" 
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group name="group2">
                                <field name="date_start" 
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="date_stop" 
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="create_monthly_earning_accrual" invisible="1"/>
                                <field name="journal_id" attrs="{'invisible':[('create_monthly_earning_accrual','=',False)]}"/>
                            </group>
                            <group>
                                <field name="earning_account_id" attrs="{'invisible':[('create_monthly_earning_accrual','=',False)]}"/>
                                <field name="counterpart_earning_account_id" attrs="{'invisible':[('create_monthly_earning_accrual','=',False)]}"/>
                                <field name="move_id" attrs="{'invisible':[('move_id','=',False)]}"/>
                            </group>
                        </group>
                    </sheet>
                    <!-- <div class="o_attachment_preview"/>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div> -->
                </form>
            </field>
        </record>

        <!-- ACTIONS -->
        <!--Fiscalyear  -->
        <record id="action_account_fiscalyear" model="ir.actions.act_window">
            <field name="name">Fiscalyear</field>
            <field name="res_model">account.fiscalyear</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{
                'search_default_state_draft': 1,
            }</field>
            <field name="view_id" ref="view_account_fiscalyear_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                  Create your New Fiscal Year
                </p><p>
                  Fiscalyear are used to register a set of accounting period.
                </p>
            </field>
        </record>

        <!--Period  -->
        <record id="action_account_period" model="ir.actions.act_window">
            <field name="name">Periods</field>
            <field name="res_model">account.period</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{
                'search_default_state_draft': 1,
            }</field>
            <field name="view_id" ref="view_account_period_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                  You are missing one step.
                </p><p>
                  Please configure your Fiscal Year first.
                </p>
            </field>
        </record>
</odoo>
