<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.c10i.account.period</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='accounting_reports']" position="after">
                    <h2>Retained Earning</h2>
                    <div class="row mt16 o_settings_container" id="earning">
                        <div class="col-12 col-lg-6 o_setting_box" id="create_closing_earning">
                            <div class="o_setting_left_pane">
                                <field name="create_monthly_earning_accrual" />
                            </div>
                            <div class="o_setting_right_pane">
                                <!-- <div class="text-muted">
                                    Record transactions in foreign currencies
                                </div> -->
                                <label for="create_monthly_earning_accrual" />
                                <div class="content-group">
                                    <div class="mt8" attrs="{'invisible': [('create_monthly_earning_accrual','=',False)], 'required': [('create_monthly_earning_accrual','=',True)]}">
                                        <label for="current_year_earning_account_id"  class="col-lg-3 o_light_label"/>
                                        <field name="current_year_earning_account_id" />
                                    </div>
                                    <div class="mt8">
                                        <label for="earning_account_id" class="col-lg-3 o_light_label"/>
                                        <field name="earning_account_id" />
                                    </div>
                                    <div class="mt8">
                                        <label for="counterpart_earning_account_id" class="col-lg-3 o_light_label"/>
                                        <field name="counterpart_earning_account_id" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>