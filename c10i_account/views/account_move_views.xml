        <record id="c10i_move_form" model="ir.ui.view">
            <field name="name">c10i.account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_right_group']/field[@name='date']" position="after">
                	<field name="period_id" string="Accounting Period"
                       attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('move_type','!=','entry')]}"/>
                </xpath>
                <group name="accounting_info_group" position="inside">
                    <field name="closing_period"/>
                    <field name="closing_period_journal"/>
                </group>
                <group name="misc_group" position="inside">
                    <field name="closing_period"/>
                    <field name="closing_period_journal"/>
                </group>

