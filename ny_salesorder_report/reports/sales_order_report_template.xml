<odoo>
    <template id="sales_order_template_custom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-size: 7px; border: 2px solid black; padding: 6px;">
                    <h2 style="text-align: center; font-size: 12px;">Sales Order</h2>

                    <!-- Informasi dari Sale Order -->
                    <table style="width: 100%; margin-bottom: 20px; font-family: Arial, sans-serif; font-size: 7px;">
                        <tr>
                            <td><strong>No Order</strong></td>
                            <td><strong>:</strong></td>
                            <td><t t-esc="doc.name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Nama Konsumen</strong></td>
                            <td><strong>:</strong></td>
                            <td><t t-esc="doc.partner_id.name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Alamat</strong></td>
                            <td><strong>:</strong></td>
                            <td><t t-esc="doc.partner_id.contact_address"/></td>
                        </tr>
                        <tr>
                            <td><strong>Tanggal Order</strong></td>
                            <td><strong>:</strong></td>
                            <td><t t-esc="doc.date_order.strftime('%d-%m-%Y')"/></td>
                        </tr>
                        <tr>
                            <td><strong>No. Telepon</strong></td>
                            <td><strong>:</strong></td>
                            <td><t t-esc="doc.partner_id.phone"/></td>
                        </tr>
                    </table>



                    <t t-if="doc.sale_order_line_melon_ids">
                        <!-- Tabel untuk Melon -->
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid black; font-size: 7px;">
                            <thead>
                                <tr style="border: 1px solid black;">
                                    <th style="border: 1px solid black;">No</th>
                                    <th style="border: 1px solid black;">Produk</th>
                                    <th style="border: 1px solid black;">Qty</th>
                                    <th style="border: 1px solid black;">Weight</th>
                                    <th style="border: 1px solid black;">Unit Price</th>
                                    <!-- <th style="border: 1px solid black;">Deskripsi</th> -->
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="index" t-value="0"/>
                                <t t-foreach="doc.sale_order_line_melon_ids" t-as="line">
                                    <t t-set="index" t-value="index + 1"/>
                                    <tr style="border: 1px solid black;">
                                        <td style="border: 1px solid black;"><t t-esc="index"/></td>
                                        <td style="border: 1px solid black;"><t t-esc="line.product_id.name"/></td>
                                        <td style="border: 1px solid black;"><t t-esc="line.product_qty"/></td>
                                        <td style="border: 1px solid black;"><t t-esc="line.weight"/></td>
                                        <td style="border: 1px solid black;"><t t-esc="'{:,}'.format(int(line.price_unit)).replace(',', '.')"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <t t-else="">
                        <!-- Tabel Produk Biasa -->
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid black; font-size: 7px;">
                            <thead>
                                <tr style="border: 1px solid black;">
                                    <th style="border: 1px solid black;">No</th>
                                    <th style="border: 1px solid black;">Produk</th>
                                    <th style="border: 1px solid black;">UoM</th>
                                    <th style="border: 1px solid black;">Qty</th>
                                    <th style="border: 1px solid black;">Unit Price</th>
                                    <th style="border: 1px solid black;">PPN</th>
                                    <th style="border: 1px solid black;">Deskripsi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="index" t-value="0"/>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-set="index" t-value="index + 1"/>
                                    <tr style="border: 1px solid black;">
                                        <td style="border: 1px solid black;"><t t-esc="index"/></td>
                                        <td style="border: 1px solid black;"><t t-esc="line.product_id.name"/></td>
                                        <td style="border: 1px solid black;"><t t-esc="line.product_uom.name"/></td>
                                        <td style="border: 1px solid black;"><t t-esc="line.product_uom_qty"/></td>
                                        <!-- <td style="border: 1px solid black;"><t t-esc="line.price_unit"/></td> -->
                                        <td style="border: 1px solid black;"><t t-esc="'{:,}'.format(int(line.price_unit)).replace(',', '.')"/></td>
                                        <td style="border: 1px solid black;"><t t-esc="str(line.tax_id.amount) + '%'"/></td>
                                        <td style="border: 1px solid black;"><t t-esc="line.name"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>


                    <!-- Tabel Produk dengan border -->
                    <!-- <table style="width: 100%; border-collapse: collapse; border: 1px solid black; font-size: 7px;">
                        <thead>
                            <tr style="border: 1px solid black;">
                                <th style="border: 1px solid black;">No</th>
                                <th style="border: 1px solid black;">Produk</th>
