    <record id="account_employee_direct_payment_sequence" model="ir.sequence">
        <field name="name">Employee Expense (Uang Muka)</field>
        <field name="code">hr.employee.expense</field>
        <field name="prefix">UM/%(year)s/%(month)s/</field>
        <field eval="1" name="number_next"/>
        <field eval="1" name="number_increment"/>
        <field eval="True" name="use_date_range"/>
        <field eval="False" name="company_id"/>
        <field name="padding">4</field>
    </record>

    <menuitem id="menu_account_direct_payment_expense_id" name="Expenses" sequence="45"
