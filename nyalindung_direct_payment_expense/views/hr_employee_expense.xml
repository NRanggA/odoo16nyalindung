<?xml version="1.0" ?>
<odoo>

    <record id="account_employee_expense_form" model="ir.ui.view">
        <field name="name">hr.employee.expense.form</field>
        <field name="model">hr.employee.expense</field>
        <field name="priority" eval="40"/>
        <field name="arch" type="xml">
            <form string="Employee Expense">
                <header>
                    <button name="employee_submit" string="Submit" type="object" class="oe_highlight" attrs="{'invisible': [('employee_expense_state','!=','draft')]}"/>
                    <button name="employee_approve" string="Approve" type="object" class="oe_highlight" attrs="{'invisible': [('employee_expense_state','!=','submit')]}"/>

                    <!-- <button name="action_post" string="Post" states="confirm" type="object" class="oe_highlight" groups="account.group_account_invoice"/>
                    <button string="Register Payment" name="action_register_payment" type="object" class="btn-primary" attrs="{'invisible': [('payment_state', '!=', 'not_paid')]}" groups="account.group_account_invoice"/> -->

                    <button name="employee_set_draft" string="Set to Draft" type="object" attrs="{'invisible': [('employee_expense_state','!=','reject')]}"/>
                    <button name="employee_reject" string="Reject" type="object" attrs="{'invisible': [('employee_expense_state','!=','submit')]}"/>
                    <button name="employee_cancel" string="Cancel" type="object" attrs="{'invisible': [('employee_expense_state','not in',['draft','submit','reject'])]}"/>
                    
                    <field name="employee_expense_state" widget="statusbar" statusbar_visible="draft,submit,approved"/>
                </header>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_settlement"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o" attrs="{'invisible':['|',('expense_report', '=', True),('employee_expense_settlement_count','=',0)]}">
                            <field name="employee_expense_settlement_count" string="Settlement" widget="statinfo"/>
                        </button>
                        <button type="object" name="action_open_employee_expense_journal"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o" attrs="{'invisible':[('employee_expense_journal_count', '=', 0)]}">
                            <field name="employee_expense_journal_count" string="Journal Item" widget="statinfo"/>
                        </button>
                        <button type="object" name="action_open_direct_payment"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o" attrs="{'invisible':[('employee_expense_direct_payment_count', '=', 0)]}">
                            <field name="employee_expense_direct_payment_count" string="Direct Payment" widget="statinfo"/>
                        </button>
                    </div>

                    <field name="state" invisible="1"/>
                    <field name="payment_state" invisible="1"/>
                    <field name="expense_report" invisible="1"/>
                    <field name="is_advance" invisible="1"/>
                    <field name="advance_found" invisible="1"/>

                    <!-- Payment status -->
                    <widget name="web_ribbon" title="Paid"
                            attrs="{'invisible': [('payment_state', '!=', 'paid')]}"/>
                    <widget name="web_ribbon" title="In Payment"
                            attrs="{'invisible': [('payment_state', '!=', 'in_payment')]}"/>
                    <!-- <widget name="web_ribbon" title="Partial"
                            attrs="{'invisible': [('payment_state', '!=', 'paid')]}"/> -->

                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create_edit': True, 'no_create': True}" required="1" attrs="{'readonly': [('employee_expense_state','!=','draft')]}"/>
                            <field name="date" required="1" attrs="{'readonly': [('employee_expense_state','!=','draft')]}"/>
                            <field name="requested_by" required="1" attrs="{'readonly': [('employee_expense_state','!=','draft')]}" options="{'no_create_edit': True, 'no_create': True}"/>
                            <field name="approved_by" readonly="1" attrs="{'invisible': [('approved_by','=',False)]}"/>
                            <field name="description" attrs="{'readonly': [('employee_expense_state','!=','draft')]}"/>
                        </group>
                        <group>
                            <!-- <field name="journal_id" options="{'no_create_edit': True, 'no_create': True}" attrs="{'invisible' : [('is_advance','!=',True)]}"/> -->
                            <field name="employee_advance_journal_id" options="{'no_create_edit': True, 'no_create': True}" readonly="1"/>
                            <field name="currency_id" options="{'no_create_edit': True, 'no_create': True}"/>
                            <field name="account_move_id" readonly="1" groups="account.group_account_user" invisible="1"/>
                            <field name="settelement_date" attrs="{'readonly' : [('employee_expense_state','!=','draft')], 'required' : [('is_advance','=',True)], 'invisible' : [('is_advance','!=',True)]}"/>
                            <field name="has_amount" invisible="1"/>
                            
                            <field name="company_id" options="{'no_create_edit': True, 'no_create': True}"/> <!-- groups="base.group_multi_company"-->
                        </group>
                    </group>
                    <group>
                        <group string="Advance to Settle" attrs="{'invisible': [('advance_found','=',False),('advance_to_settle_ids','=',[])]}">
                            <!-- <label for="advance_to_settle_ids"/> -->
                            <field name="advance_to_settle_ids" colspan="4" nolabel="1" domain="[('employee_id','=',employee_id),('employee_expense_state','=','approved'),('advance_residual','!=',0)]">
                                <tree create="false">
                                    <field name="name"/>
                                    <field name="advance_residual" sum="amount_to_settle" attrs="{'column_invisible' : [('parent.has_amount','!=',True)]}"/>
                                    <field name="amount_total" string="Amount to Clear" sum="amount_to_settle" attrs="{'column_invisible' : [('parent.has_amount','=',True)]}"/>
                                </tree>
                            </field>
                        </group>
                        <!-- <group></group> -->
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" required="1" attrs="{'readonly': [('employee_expense_state','not in',['draft', 'submit', 'approved'])]}" >
                                <tree editable="bottom">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="product_id" 
                                        options="{'no_create_edit': True, 'no_create': True}" 
                                        attrs="{'readonly': [('parent.employee_expense_state', '!=', 'draft')]}" invisible="1"/>
                                    <field name="name" attrs="{'readonly': [('parent.employee_expense_state', '!=', 'draft')]}"/>
                                    
                                    <field name="location_type_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                    <field name="varieties_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" />
                                    <field name="filtered_locations" invisible="1"/>                                    
                                    <field name="location_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" domain="[('id','in',filtered_locations)]"/>
                                    <field name="filtered_activities" invisible="1"/>
                                    <field name="activity_id" domain="[('id','in',filtered_activities)]" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                    
                                    <field name="account_id" 
                                        options="{'no_create_edit': True, 'no_create': True}" 
                                        attrs="{'readonly': ['|',('parent.employee_expense_state', 'not in', ['draft','submit','approved']),('parent.is_advance','=',True)]}" force_save="1"/>
                                    <field name="analytic_account_id" 
                                        options="{'no_create_edit': True, 'no_create': True}" 
                                        attrs="{'readonly': [('parent.employee_expense_state', 'not in', ['draft','submit','approved'])]}"
                                        groups="analytic.group_analytic_accounting"/>
                                    <field name="amount"/>
                                </tree>
                                <form>
                                    <field name="currency_id" invisible="1"/>
                                    <label for="name" />
                                    <field name="name" nolabel="1"/>
                                    <group>
                                        <group>
                                            <field name="product_id" options="{'no_create_edit': True, 'no_create': True}" invisible="1"/>
                                        </group>
                                        <group>
                                            <field name="amount"/>
                                            <field name="account_id" options="{'no_create_edit': True, 'no_create': True}"/>
                                            <field name="analytic_account_id" options="{'no_create_edit': True, 'no_create': True}" groups="analytic.group_analytic_accounting"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <label for="amount_total" string="Settlement Amount" attrs="{'invisible': [('advance_amount_settle', '=', 0.0)]}"/>
                                <field name="amount_total" nolabel="1" attrs="{'invisible': [('advance_amount_settle', '=', 0.0)]}"/>
                                <field name="amount_total" attrs="{'invisible': [('advance_amount_settle', '&lt;', 0.0)]}"/>
                                <field name="advance_amount_settle" attrs="{'invisible': [('advance_amount_settle', '=', 0.0)]}"/>
                                <field name="amount_total2" class="oe_subtotal_footer_separator" attrs="{'invisible': [('advance_amount_settle', '=', 0.0)]}"/>
                                <field name="amount_residual" class="oe_subtotal_footer_separator" attrs="{'invisible': [('state', '!=', 'posted')]}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <record id="account_employee_expense_tree" model="ir.ui.view">
        <field name="name">hr.employee.expense.tree</field>
        <field name="model">hr.employee.expense</field>
        <field name="priority" eval="40"/>
        <field name="arch" type="xml">
            <tree string="Employee Expense">
                <field name="name" />
                <field name="date"/>
                <field name="employee_id"/>
                <field name="currency_id" optional="hide"/>
                <field name="amount_total"/>
                <field name="company_id" optional="hide"/>
                <!-- <field name="state" widget="badge" decoration-danger="state=='reject'" decoration-warning="state=='submit'" decoration-success="state in ['approved','posted']"/> -->
                <field name="employee_expense_state" widget="badge" decoration-danger="employee_expense_state=='reject'" decoration-warning="employee_expense_state=='submit'" decoration-success="employee_expense_state=='approved'"/>
                <field name="payment_state" widget="badge" optional="show" decoration-warning="payment_state=='not_paid'" decoration-info="payment_state=='in_payment'" decoration-success="payment_state=='paid'"/>
            </tree>
        </field>
    </record>

    <record id="account_employee_advance_tree" model="ir.ui.view">
        <field name="name">hr.employee.advance.tree</field>
        <field name="model">hr.employee.expense</field>
        <field name="priority" eval="40"/>
        <field name="arch" type="xml">
            <tree string="Employee Advance">
                <field name="name" />
                <field name="date"/>
                <field name="employee_id"/>
                <field name="currency_id" optional="hide"/>
                <field name="amount_total"/>
                <field name="advance_residual"/>
                <!-- <field name="amount_to_clear"/> -->
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="employee_expense_state" widget="badge" decoration-danger="employee_expense_state=='reject'" decoration-warning="employee_expense_state=='submit'" decoration-success="employee_expense_state=='approved'"/>
                <field name="payment_state" widget="badge" optional="show" decoration-warning="payment_state=='not_paid'" decoration-info="payment_state=='in_payment'" decoration-success="payment_state=='paid'"/>
            </tree>
        </field>
    </record>

    <record id="account_employee_expense_search" model="ir.ui.view">
        <field name="name">hr.employee.expense.select</field>
        <field name="model">hr.employee.expense</field>
        <field name="arch" type="xml">
            <search string="Search Employee Expense">
                <field name="name"/>
                <field name="date"/>
                <field name="requested_by"/>
                <filter string="My Advance" name="my_advances" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="My Reports" name="my_reports" domain="[('employee_id.user_id', '=', uid)]"/>
                
                <separator/>
                    <filter name="submit" string="To Approve" domain="[('employee_expense_state','=','submit')]"/>
                    <filter name="approve" string="To Post" domain="[('employee_expense_state','=','approved')]"/>
                    <filter name="posted" string="Posted" domain="[('employee_expense_state', '=', 'posted')]"/>
                    <filter name="cancel" string="Cancelled" domain="[('employee_expense_state', '=', 'cancel')]"/>
                    <filter name="reject" string="Rejected" domain="[('employee_expense_state', '=', 'reject')]"/>
                <separator/>
                    <filter name="in_payment" string="In Payment" domain="[('payment_state', '=', 'in_payment'), ('state', '=', 'posted')]"/>
                    <!-- <filter name="partial" string="Partially Paid" domain="[('payment_state', '=', 'partial'), ('state', '=', 'posted')]"/> -->
                    <filter name="paid" string="Paid" domain="[('payment_state', '=', 'paid'), ('state', '=', 'posted')]"/>
                    <filter name="unpaid" string="Not Paid" domain="[('payment_state', '=', 'not_paid'), ('state', '=', 'posted')]"/>
                <group expand="0" string="Group By">
                    <filter name="status" string="Status" context="{'group_by':'employee_expense_state'}"/>
                    <separator/>
                    <filter string="Date" name="groupdate" context="{'group_by': 'date'}"/>
                </group>
             </search>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="hr_account_employee_expense_action">
        <field name="name">My Reports</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.employee.expense</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('expense_report','=',True),('is_advance','=', False)]</field>
        <field name="context">{'default_expense_report': 1, 'search_default_my_reports': 1}</field>
        <field name="search_view_id" ref="account_employee_expense_search" />
    </record>
    
    <record id="hr_account_employee_expense_action_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="account_employee_expense_tree"/>
        <field name="act_window_id" ref="hr_account_employee_expense_action"/>
    </record>

    <record id="hr_account_employee_expense_action_form" model="ir.actions.act_window.view">
