<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.account</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/> <!--ref="c10i_direct_payment.res_config_settings_view_form"-->
            <field name="arch" type="xml">
                <xpath expr="//div[child::field[@name='employee_advance_account_id']]" position="after">
                    <div class="row mt16">
                        <label for="contra_account_for_advance" class="col-lg-3 o_light_label"/>
                        <field name="contra_account_for_advance"/>
                    </div>
                    <div class="row mt16">
                        <label for="employee_advance_journal_id" class="col-lg-3 o_light_label"/>
                        <field name="employee_advance_journal_id"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>