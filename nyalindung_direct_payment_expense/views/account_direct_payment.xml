<?xml version="1.0" encoding="utf-8"?>
<odoo>


  <record id="nyalindung_direct_payment_expense_inherit_direct_payment" model="ir.ui.view">
    <field name="name">nyalindung.direct.payment.expense.inherit.direct.payment</field>
    <field name="model">account.direct.payment</field>
    <field name="inherit_id" ref="c10i_direct_payment.account_direct_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_cancel']" position="attributes">
        <attribute name="attrs">{'invisible' : [('state','not in', ['draft','confirm','posted'])]}</attribute>
      </xpath>
      <xpath expr="//button[@name='action_register_payment']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='date']" position="after">
        <field name="direct_state" widget="radio" string="Payment Type"/>
      </xpath>
      <xpath expr="//field[@name='company_id']" position="after">
        <field name="general" invisible="1"/>
        <field name="partner_bank_id" 
              domain="[('partner_id', '=', partner_id)]" 
              options="{'no_edit':True, 'no_create':True, 'no_open': True}"
              attrs="{'invisible' : [('general','=', True)]}"
              />
        <field name="partner_bank_name" attrs="{'invisible' : [('general','=', False)]}"/>
        <field name="partner_bank_number" attrs="{'invisible' : [('general','=', False)]}"/>
      </xpath>
      <xpath expr="//field[@name='line_ids']/tree/field[@name='name']" position="after">
        <field name="plantation_location_type_id" 
            options="{'no_edit':True, 'no_create':True, 'no_open': True}" 
            attrs="{'readonly': [('parent.state', '!=', 'draft')],
                'required': [('plantation_validator','=',False)]}"/>
        <!-- Akan dibuat tidak mandatory -->
        <field name="plantation_validator" invisible="1"/>
        <field name="varieties_validator" invisible="1"/>
        <field name="plantation_varieties_id" 
            options="{'no_edit':True, 'no_create':True, 'no_open': True}" 
            attrs="{'readonly': [('varieties_validator','=',False)], 
                    'required': [('varieties_validator','=',True)]}"
            />
        <field name="filtered_locations" invisible="1"/> 
        <field name="plantation_location_id" 
            domain="[('id','in',filtered_locations)]" 
            options="{'no_edit':True, 'no_create':True, 'no_open': True}" 
            attrs="{'readonly': [('parent.state', '!=', 'draft')],
                'required': [('plantation_validator','=',False)]}"/>
        <field name="filtered_activities" invisible="1"/>
        <field name="plantation_activity_id" 
            domain="[('id','in',filtered_activities)]" 
            options="{'no_edit':True, 'no_create':True, 'no_open': True}" 
            attrs="{'readonly': [('parent.state', '!=', 'draft')],
                'required': [('plantation_validator','=',False)]}"/>
      </xpath>
      <field name="account_id" position="after">
        <field name="has_plantation" invisible="1"/>
      </field>
    </field>
  </record>




  <!-- ovveride action bawaan account.direct.payment dengan menambahkan nilai default direct_state (send) -->
  <record id="c10i_direct_payment.account_direct_payment_action" model="ir.actions.act_window">
      <field name="name">Direct Payment</field>
      <field name="res_model">account.direct.payment</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[('direct_state', '=', 'send')]</field>
      <field name="context">{'default_direct_state': 'send'}</field>
  </record>

  <!-- Menambahkan Menu dan action Untuk Direct Payment Receive -->
  <record id="direct_payment_receive_action" model="ir.actions.act_window">
    <field name="name">Direct Payment Receive</field>
    <field name="res_model">account.direct.payment</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('direct_state', '=', 'receive')]</field>
    <field name="context">{'default_direct_state': 'receive'}</field>
  </record>

  <menuitem
    id="direct_payment_receive_menu"
    name="Direct Payment Receive"
    action="direct_payment_receive_action"
    parent="account.menu_finance_payables"
    sequence="30"/>
    

</odoo>
