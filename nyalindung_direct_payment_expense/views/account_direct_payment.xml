<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="nyalindung_direct_payment_expense_inherit_direct_payment" model="ir.ui.view">
    <field name="name">nyalindung.direct.payment.expense.inherit.direct.payment</field>
    <field name="model">account.direct.payment</field>
    <field name="inherit_id" ref="c10i_direct_payment.account_direct_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='account_move_id']" position="after">
        <field name="employee_expense_state" invisible="1"/>
        <field name="settelement_date" attrs="{'readonly' : [('employee_expense_state','!=','draft')]}"/>
      </xpath>
      <xpath expr="//field[@name='line_ids']/tree/field[@name='name']" position="after">
        <field name="plantation_location_type_id" 
            options="{'no_create_edit':True, 'no_create':True}" 
            attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
        <field name="plantation_location_id" 
            domain="[('type_id','=',plantation_location_type_id)]" 
            options="{'no_create_edit':True, 'no_create':True}" 
            attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
        <field name="plantation_activity_id" 
            domain="[('type_id','=',plantation_location_type_id)]" 
            options="{'no_create_edit':True, 'no_create':True}" 
            attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
      </xpath>
    </field>
  </record>

  <record model="ir.actions.act_window" id="c10i_direct_payment.account_direct_payment_action">
      <field name="domain">['|',('is_advance','=',False),('employee_expense_state', 'not in', ['draft','submit'])]</field>
  </record>

  <record id="nyalindung_direct_payment_expense_inherit_direct_payment_expense" model="ir.ui.view">
    <field name="name">nyalindung.direct.payment.expense.inherit.direct.payment.expense</field>
    <field name="model">account.direct.payment</field>
    <field name="inherit_id" ref="c10i_direct_payment_employee_expense.account_employee_expense_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/*[1]" position="before">
        <div class="oe_button_box" name="button_box">
          <button type="object" name="action_open_employee_expense_journal"
              class="oe_stat_button"
              icon="fa-pencil-square-o" attrs="{'invisible':[('employee_expense_journal_count', '=', 0)]}">
              <field name="employee_expense_journal_count" widget="statinfo"/>
          </button>
        </div>
      </xpath>
      <xpath expr="//button[@name='action_post']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//button[@name='action_register_payment']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='account_move_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='account_move_id']" position="after">
        <field name="settelement_date" attrs="{'readonly' : [('employee_expense_state','!=','draft')]}"/>
      </xpath>
      <xpath expr="//field[@name='currency_id']" position="attributes">
        <attribute name="attrs">{'readonly' : [('employee_expense_state','!=','draft')]}</attribute>
      </xpath>
      <xpath expr="//field[@name='line_ids']/tree/field[@name='name']" position="after">
        <field name="plantation_location_type_id" 
            options="{'no_create_edit':True, 'no_create':True}" 
            attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
        <field name="plantation_location_id" 
            domain="[('type_id','=',plantation_location_type_id)]" 
            options="{'no_create_edit':True, 'no_create':True}" 
            attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
        <field name="plantation_activity_id" 
            domain="[('type_id','=',plantation_location_type_id)]" 
            options="{'no_create_edit':True, 'no_create':True}" 
            attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
      </xpath>
    </field>
  </record>

</odoo>
