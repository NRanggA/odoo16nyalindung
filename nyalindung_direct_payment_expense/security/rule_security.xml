<?xml version="1.0"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_nyalindung_direct_payment_expense">
            <field name="name">Employee Expense</field>
            <field name="description">Management HR Employee Expense</field>
            <field name="sequence">800</field>
        </record>

        <record id="group_employee_expense_user" model="res.groups">
            <field name="name">Employee Expense User</field>
            <field name="category_id" ref="module_category_nyalindung_direct_payment_expense"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Users who can only see their own employee expenses.</field>
        </record>

        <record id="group_employee_expense_superuser" model="res.groups">
            <field name="name">Employee Expense Superuser</field>
            <field name="category_id" ref="module_category_nyalindung_direct_payment_expense"/>
            <field name="implied_ids" eval="[(4, ref('group_employee_expense_user'))]"/>
            <field name="comment">Superusers who can see all employee expenses.</field>
        </record>

        <record id="hr_employee_expense_user_rule" model="ir.rule">
            <field name="name">Employee Expense User Access</field>
            <field name="model_id" ref="model_hr_employee_expense"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_employee_expense_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_employee_expense_superuser_rule" model="ir.rule">
            <field name="name">Employee Expense Superuser Access</field>
            <field name="model_id" ref="model_hr_employee_expense"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_employee_expense_superuser'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
