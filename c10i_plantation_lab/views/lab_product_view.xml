<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_product_view_form" model="ir.ui.view">
        <field name="name">lab_product.view.form</field>
        <field name="model">lab.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" />
                            <field name="code" />
                        </group>
                        <group>
                            <field name="location_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="lab_product_view_tree" model="ir.ui.view">
        <field name="name">lab_product.view.tree</field>
        <field name="model">lab.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="product_id" />
            </tree>
        </field>
    </record>

    <record id="lab_product_view_search" model="ir.ui.view">
        <field name="name">lab_product.view.search</field>
        <field name="model">lab.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" />
            </search>
        </field>
    </record>

    <record id="action_lab_product" model="ir.actions.act_window">
        <field name="name">Product</field>
        <field name="res_model">lab.product</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
