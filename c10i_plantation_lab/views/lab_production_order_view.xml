<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lab_production_order_view_form" model="ir.ui.view">
        <field name="name">lab_production_order.view.form</field>
        <field name="model">lab.production.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Confirm" name="action_confirm" type="object" class="oe_highlight" states="draft"/>
                    <button string="Finish" name="action_done" type="object" class="oe_highlight" states="inprogress"/>

                    <button string="Cancel" name="action_cancel" type="object" class="btn-danger" states="inprogress"/>
                    <button string="Set to Draft" name="action_set_draft" type="object" class="btn-secondary" states="cancel"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,inprogress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-exchange" string="Moves"/>
                    </div>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="lab_product_id" />
                            <field name="product_qty" />
                            <!-- <field name="qty_done"/> -->
                        </group>
                        <group>
                            <field name="date_start" readonly="1" attrs="{'invisible': [('date_start','=',False)]}"/>
                            <field name="date_end" readonly="1" attrs="{'invisible': [('date_end','=',False)]}"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="lab_production_order_view_tree" model="ir.ui.view">
        <field name="name">lab_production_order.view.tree</field>
        <field name="model">lab.production.order</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state=='cancel'">
                <field name="name" />
                <field name="lab_product_id" />
                <field name="state" 
                    decoration-info="state=='draft'" 
                    decoration-warning="state=='inprogress'" 
                    decoration-success="state=='done'"/>
            </tree>
        </field>
    </record>

    <record id="lab_production_order_view_search" model="ir.ui.view">
        <field name="name">lab_production_order.view.search</field>
        <field name="model">lab.production.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lab_product_id" />
                <group string="Group By">
                    <filter name="groupby_lab_product" string="Product" context="{'group_by': 'lab_product_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_lab_production_order" model="ir.actions.act_window">
        <field name="name">Production Order</field>
        <field name="res_model">lab.production.order</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
