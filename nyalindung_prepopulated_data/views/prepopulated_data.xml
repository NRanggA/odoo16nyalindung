<?xml version="1.0" ?>
<odoo>
    
      <record id="prepopulated_data_view_tree" model="ir.ui.view">
          <field name="name">prepopulated.data.view.tree</field>
          <field name="model">prepopulated.data</field>
          <field name="arch" type="xml">
              <tree editable="top" js_class="import_data">
                <field name="npwp" />
                <field name="name" />
                <field name="jenis_transaksi" />
                <field name="status_pengganti" />
                <field name="nomor_faktur" />
                <field name="tanggal_faktur" />
                <field name="dpp" />
                <field name="ppn" />
                <field name="ppnbm" />
                <field name="is_dikreditkan" />
              </tree>
          </field>
      </record>
      
      <record id="prepopulated_data_view_form" model="ir.ui.view">
        <field name="name">prepopulated.data.view.form</field>
        <field name="model">prepopulated.data</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                  <group>
                    <group>
                      <field name="npwp" />
                      <field name="name" />
                      <field name="jenis_transaksi" />
                      <field name="status_pengganti" />
                      <field name="nomor_faktur" />
                      <field name="tanggal_faktur" />
                    </group>
                    <group>
                      <field name="dpp" />
                      <field name="ppn" />
                      <field name="ppnbm" />
                      <field name="is_dikreditkan" />
                    </group>
                  </group>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
            </form>
        </field>
      </record>


      
      <record id="prepopulated_data_action" model="ir.actions.act_window">
          <field name="name">Prepopulated Data</field>
          <field name="res_model">prepopulated.data</field>
          <field name="view_mode">tree,form</field>
          <field name="domain">[]</field>
          <field name="context">{}</field>          
      </record>
    

</odoo>