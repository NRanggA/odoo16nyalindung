<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_import_prepopulated_data" model="ir.ui.view">
        <field name="name">wizard.import.prepopulated.data</field>
        <field name="model">wizard.import.prepopulated.data</field>
        <field name="arch" type="xml">
            <form string="Import Data">
                <field name="file_import" />
                <footer>
                    <button name="button_upload" type="object" string="Upload" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_import_prepopulated_data" model="ir.actions.act_window">
        <field name="name">Import Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.import.prepopulated.data</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
