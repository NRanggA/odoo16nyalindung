<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_contract_inherit_wage_id" model="ir.ui.view">
        <field name="name">hr.contract.view.form.inherit.wage_id</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <!-- Locate the div that contains the wage field -->
            <xpath expr="//div[@name='wage']/.." position="inside">
                <field name="wage_id"/>
            </xpath>
            <xpath expr="//div[@name='wage']/div[@class='mb-3']" position="replace"/>
        </field>
    </record>

</odoo>
