<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="view_bank_statement_form_inherit_c10i_bank_statement" model="ir.ui.view">
            <field name="name">account.bank.statement.view.form.c10i.bank.statement.inherit</field>
            <field name="model">account.bank.statement</field>
            <field name="inherit_id" ref="account_statement_base.view_bank_statement_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                    <button string="Validate" name="button_validate" type="object" class="oe_highlight" states="draft"/>
                    <button string="Set to Draft" name="button_draft" type="object" states="validated"/>
                    <!-- <button string="Get Payment" name="button_get_payments" type="object" attrs="{'invisible': [('type','!=','cash')]}"/> -->
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="button_reconcile" type="object" class="oe_stat_button" icon="fa-bars" string="Reconcile Items"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="before">
                    <field name="type" invisible="1" />
                </xpath>
                <!-- Readonly Fields -->
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state','!=','draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='balance_start']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state','!=','draft')]}</attribute>
                </xpath>
                <field name="balance_start" position="after">
                    <button name="button_get_balance_start" type="object" icon="fa-refresh" attrs="{'invisible': ['|',('state','!=','draft'),('type','!=','cash')]}"/>
                </field>
                <xpath expr="//field[@name='balance_end_real']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state','!=','draft')]}</attribute>
                </xpath>
                
                <!-- <xpath expr="//field[@name='line_ids']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state','!=','draft')]}</attribute>
                </xpath> -->
                <field name="line_ids" position="replace" />
                <xpath expr="//sheet/group[1]" position="after">
                    <notebook>
                        <page name="statement_lines" string="Statement Lines">
                            <field name="line_ids" context="{'default_journal_id': journal_id}"/>
                        </page>
                        <page name="cash_count" string="Cash Count" attrs="{'invisible': [('type','!=','cash')]}">
                            <field name="cash_count_line_ids" >
                                <tree create="0" delete="0" editable="bottom" >
                                    <field name="cash_type_id" force_save="1" readonly="1"/>
                                    <field name="amount" string="Quantity" />
                                    <field name="total" sum="total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </xpath>
                
                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="invisible">0</attribute>
                    <attribute name="required">1</attribute>
                    <attribute name="domain">[('type','in', ['bank','cash'])]</attribute>
                    <attribute name="attrs">{'readonly': [('state','!=','draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='date']" position="attributes">
                    <attribute name="readonly">0</attribute>
                    <attribute name="required">1</attribute>
                    <attribute name="attrs">{'readonly': [('state','!=','draft')]}</attribute>
                </xpath>
                <!-- <xpath expr="//field[@name='line_ids']" position="after">
                    <separator string="Cash Count"/>
                    <field name="cash_count_line_ids" attrs="{'invisible': [('type','!=','cash')]}">
                        <tree create="0" delete="0" editable="bottom" >
                            <field name="cash_type_id" force_save="1" readonly="1"/>
                            <field name="amount" string="Quantity" />
                            <field name="total" />
                        </tree>
                    </field>
                </xpath> -->
            </field>
        </record>

        <record id="view_bank_statement_tree_inherit_c10i_bank_statement" model="ir.ui.view">
            <field name="name">account.bank.statement.view.tree.c10i.bank.statement.inherit</field>
            <field name="model">account.bank.statement</field>
            <field name="inherit_id" ref="account.view_bank_statement_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="create">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="account_journal_dashboard_kanban_view_inherit_c10i_bank_statement" model="ir.ui.view">
            <field name="name">account.journal.view.kanban.c10i.bank.statement.inherit</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account_reconcile_oca.account_journal_dashboard_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='%(account_reconcile_oca.action_bank_statement_line_reconcile)s']" position="attributes">
                    <attribute name="attrs">{'invisible': [('type','=','cash')]}</attribute>
                </xpath>
            </field>
        </record>
    
    </data>
    

</odoo>
