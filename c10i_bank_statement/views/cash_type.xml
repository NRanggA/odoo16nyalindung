<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <!-- Search View -->
        <record model="ir.ui.view" id="cash_type_search">
            <field name="name">cash.type.search</field>
            <field name="model">cash.type</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>   

        <record id="cash_type_view_form" model="ir.ui.view">
            <field name="name">cash.type.view.form</field>
            <field name="model">cash.type</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" nolabel="1" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <field name="amount"/>
                            <field name="image" widget="image"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="cash_type_view_tree" model="ir.ui.view">
            <field name="name">cash.type.view.tree</field>
            <field name="model">cash.type</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="name" />
                    <field name="amount" />
                </tree>
            </field>
        </record>  

        <record id="cash_type_action" model="ir.actions.act_window">
            <field name="name">Cash Type</field>
            <field name="res_model">cash.type</field>
            <field name="view_mode">tree,form</field>
        </record>
    
    </data>
</odoo>
