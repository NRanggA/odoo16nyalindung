<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
        <record model='ir.ui.view' id='wizard_report_inventory_form'>
            <field name="name">Laporan Inventory Plantation</field>
            <field name="model">wizard.report.inventory</field>
            <field name="arch" type="xml">
                <form string="Laporan Inventory Plantation">
                    <header>
                        <button name="create_report" type="object" default_focus="1" string="Print" class="oe_highlight" icon="fa-get-pocket"/>
                    </header>
                    <sheet>
                        <center><h1>Laporan Inventory Plantation</h1></center>
                        <group>
                            <label for="from_date" string="Periode Laporan"/>
                            <div>
                                <field name="from_date" class="oe_inline" nolabel="1" required="1" /> -
                                <field name="to_date" nolabel="1" class="oe_inline" required="1" />
                            </div>
                            <field name="report_type" string="Tipe Laporan" required="1" colspand="8"/>
                            <field name="name" string="Nama Laporan" required="1"/>
                        </group>
                        <group>
                            <field name="operating_unit_ids">
                                <tree>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model='ir.actions.act_window' id='action_wizard_report_inventory'>
            <field name="name">Laporan Inventory Plantation</field>
            <field name="res_model">wizard.report.inventory</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">form</field>
            <field name="view_id" ref="wizard_report_inventory_form"/>
            <field name="target">current</field>
        </record>

        <!-- ========== Spesifikasi Menu ========== -->
		<menuitem 	name	= "Inventory Plantation"
					 action	= "action_wizard_report_inventory"
					 id		= "c10i_report_inventory_plantation"
					 parent	= "stock.menu_warehouse_report"
					 sequence= "160" />


        <!-- ========== Spesifikasi Report ========== -->
        <record id="report_produksi_panen" model="ir.actions.report">
            <field name="name">Laporan Panen</field>
            <field name="model">wizard.report.produksi.select</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">c10i_lhm_v16.report_report_produksi_panen</field>
            <field name="report_file">c10i_lhm_v16/report/report_produksi_panen.jrxml</field>
        </record>

        <record id="report_produksi_panen_rekap" model="ir.actions.report">
            <field name="name">Laporan Rekap Panen</field>
            <field name="model">wizard.report.produksi.select</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">c10i_lhm_v16.report_report_produksi_panen_rekap</field>
            <field name="report_file">c10i_lhm_v16/report/report_produksi_panen_rekap.jrxml</field>
        </record>

        <record id="report_produksi_restan" model="ir.actions.report">
            <field name="name">Laporan Restan</field>
            <field name="model">wizard.report.produksi.select</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">c10i_lhm_v16.report_report_produksi_restan</field>
            <field name="report_file">c10i_lhm_v16/report/report_produksi_restan.jrxml</field>
        </record>

        <record id="report_produksi_nap_perblock" model="ir.actions.report">
            <field name="name">Laporan NAP Per Blok</field>
            <field name="model">wizard.report.produksi.select</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">c10i_lhm_v16.report_report_produksi_nap_perblock</field>
            <field name="report_file">c10i_lhm_v16/report/report_produksi_nap_perblock.jrxml</field>
        </record>

        <record id="report_produksi_nap_detail" model="ir.actions.report">
            <field name="name">Laporan NAP Detail</field>
            <field name="model">wizard.report.produksi.select</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">c10i_lhm_v16.report_report_produksi_nap_detail</field>
            <field name="report_file">c10i_lhm_v16/report/report_produksi_nap_detail.jrxml</field>
        </record>

        <record id="report_produksi_nap_rekap" model="ir.actions.report">
            <field name="name">Laporan NAP Rekap</field>
            <field name="model">wizard.report.produksi.select</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">c10i_lhm_v16.report_report_produksi_nap_rekap</field>
            <field name="report_file">c10i_lhm_v16/report/report_produksi_nap_rekap.jrxml</field>
        </record>

        <record id="report_produksi_nap_afkir" model="ir.actions.report">
            <field name="name">Laporan BA TBS Afkir</field>
            <field name="model">wizard.report.produksi.select</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">c10i_lhm_v16.report_report_produksi_nap_afkir</field>
            <field name="report_file">c10i_lhm_v16/report/report_produksi_nap_afkir.jrxml</field>
        </record>

        <record id="report_produksi_panen_rotasi" model="ir.actions.report">
            <field name="name">Laporan Rotasi Panen</field>
            <field name="model">wizard.report.produksi.select</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">c10i_lhm_v16.report_report_produksi_panen_rotasi</field>
            <field name="report_file">c10i_lhm_v16/report/report_produksi_panen_rotasi.jrxml</field>
        </record>



	</data>
</odoo>
