<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Defining the Wizard View -->
    <record id="view_wizard_running_account_report_form" model="ir.ui.view">
        <field name="name">wizard.running.account.report.form</field>
        <field name="model">wizard.running.account.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Running Account">
                <group>
                    <group>
                        <field name="account_period_id"/>
                        <field name="report_type"/>
                    </group>
                    <group>
                        <field name="company_id" widget="selection"/>
                    </group>
                </group>
                <footer>
                    <button icon="fa-print" name="action_print_report" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Defining the Action for the Wizard -->
    <record id="action_running_account_report" model="ir.actions.act_window">
        <field name="name">Laporan Running Account</field>
        <field name="res_model">wizard.running.account.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_wizard_running_account_report_form"/>
    </record>

    <!-- Adding the Menu Item for the Report -->
    <menuitem id="menu_running_account_report" name="Laporan Running Account" parent="menu_plantation_report" action="action_running_account_report" sequence="9"/>
</odoo>



