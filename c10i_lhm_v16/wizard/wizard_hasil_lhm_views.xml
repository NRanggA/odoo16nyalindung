<odoo>
	
		<record id="view_wizard_hasil_lhm_form" model="ir.ui.view">
	        <field name="name">wizard.hasil.lhm.form</field>
	        <field name="model">wizard.hasil.lhm</field>
	        <field name="arch" type="xml">
	            <form string="Wizard Hasil LHM">
	                <group>
	                    <field name="product_id"/>
	                    <field name="qty"/>
	                    <field name="uom"/>
	                    <field name="hasil"/>
	                </group>
	                <footer>
	                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
	                </footer>
	            </form>
	        </field>
	    </record>


	    <record id="action_wizard_hasil_lhm" model="ir.actions.act_window">
	        <field name="name">Hasil LHM</field>
	        <field name="res_model">wizard.hasil.lhm</field>
	        <field name="view_mode">form</field>
	        <field name="target">new</field>
	        <field name="view_id" ref="c10i_lhm_v16.view_wizard_hasil_lhm_form"/>
	    </record>


</odoo>