<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lhm_wage_borongan_panen_view_form" model="ir.ui.view">
        <field name="name">lhm.wage.borongan.panen.view.form</field>
        <field name="model">lhm.wage.borongan.panen</field>
        <field name="arch" type="xml">
            <form string="Upah Borongan Panen">
                <sheet>
                    <group>
                        <field name="activity_code" />
                        <field name="activity_id" />
                        <field name="product_id" />
                        <field name="qty" />
                        <field name="satuan_id" />
                        <field name="min_drc" />
                        <field name="max_drc" />
                        <field name="price" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="lhm_wage_borongan_panen_view_tree" model="ir.ui.view">
        <field name="name">lhm.wage.borongan.panen.view.tree</field>
        <field name="model">lhm.wage.borongan.panen</field>
        <field name="arch" type="xml">
            <tree string="Upah Borongan Panen">
                <field name="activity_code" />
                <field name="activity_id" />
                <field name="product_id" />
                <field name="qty" />
                <field name="satuan_id" />
                <field name="min_drc" />
                <field name="max_drc" />
                <field name="price" />
            </tree>
        </field>
    </record>

    <record id="lhm_wage_borongan_panen_action" model="ir.actions.act_window">
        <field name="name">Upah Borongan Panen</field>
        <field name="res_model">lhm.wage.borongan.panen</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="lhm_wage_borongan_panen_menu"
        name="Upah Borongan Panen"
        action="lhm_wage_borongan_panen_action"
        parent="menu_lhm_master"
    />


</odoo>
