<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lhm_tm_category_view_form" model="ir.ui.view">
        <field name="name">lhm.tm.category.view.form</field>
        <field name="model">lhm.tm.category</field>
        <field name="arch" type="xml">
            <form string="TM Category">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="min_age" />
                        <field name="max_age" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="lhm_tm_category_view_tree" model="ir.ui.view">
        <field name="name">lhm.tm.category.view.tree</field>
        <field name="model">lhm.tm.category</field>
        <field name="arch" type="xml">
            <tree string="TM Category">
                <field name="name" />
                <field name="min_age" />
                <field name="max_age" />
            </tree>
        </field>
    </record>

    <record id="lhm_tm_category_action" model="ir.actions.act_window">
        <field name="name">TM Category</field>
        <field name="res_model">lhm.tm.category</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="lhm_tm_category_menu" name="TM Category" action="lhm_tm_category_action" parent="menu_lhm_master" />


</odoo>
