<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seed_semai_view_form" model="ir.ui.view">
        <field name="name">seed.semai.view.form</field>
        <field name="model">seed.semai</field>
        <field name="arch" type="xml">
            <form string="Form Pemasukan Bibitan">
                <header>
                    <!-- <button name="button_approve" states="draft" string="Approve" type="object" class="btn-default btn-primary"/>
                    <button name="button_draft" states="approve" string="Set to draft" type="object" class="btn-default"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approve"/> -->
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nama" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1" force_save="1"/></h1>
                    </div>
                    <group>
                        <field name="product_id" />
                        <field name="date" />
                    </group>
                    <notebook>
                        <page string="Detail">
                            <field name="line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="date" readonly="1" />
                                    <field name="product_id" />
                                    <field name="mutation_type_id"/>
                                    <field name="nursery_id" />
                                    <field name="location_src_id" domain="[('id', 'in', fil_location_src_ids)]"/>
                                    <field name="location_dest_id" domain="[('id', 'in', fil_location_dest_ids)]"/>
                                    <field name="qty" />
                                    <field name="satuan_id" />
                                    <field name="fil_location_src_ids" invisible="1"/>
                                    <field name="fil_location_dest_ids" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="seed_semai_view_tree" model="ir.ui.view">
        <field name="name">seed.semai.view.tree</field>
        <field name="model">seed.semai</field>
        <field name="arch" type="xml">
            <tree string="List Pemasukan Bibitan">
                <field name="name" />
                <field name="product_id" />
                <field name="date" />
            </tree>
        </field>
    </record>

    <record id="seed_semai_action" model="ir.actions.act_window">
        <field name="name">Form Pemasukan Bibitan</field>
        <field name="res_model">seed.semai</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="seed_semai_menu"
        name="Form Pemasukan Bibit"
        action="seed_semai_action"
        parent="menu_bibitan"/>

</odoo>
