<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree -->
    <record id="lhm_contractor_line_view_tree" model="ir.ui.view">
        <field name="name">lhm.contractor.line.view.tree</field>
        <field name="model">lhm.contractor.line</field>
        <field name="arch" type="xml">
            <tree string="LHM Contractor Line">
                <field name="date" />
                <field name="contractor_id" />
                <field name="supplier_id" />
                <field name="location_type_id" />
                <field name="location_id" />
                <field name="varieties_id" />
                <field name="activity_id" />
                <field name="product_id" />
                <field name="nilai" />
                <field name="uom_id" />
                <field name="product_id_2" />
                <field name="nilai2" />
                <field name="uom2_id" />
                <field name="unit_price" />
                <field name="total" />
                <field name="hasil_1_nap" />
                <field name="hasil_2_nap" />
                <field name="hasil_convert_latex" />
                <field name="hasil_convert_lump" />
                <!-- <field name="state" widget="badge" decoration-warning="state == 'process'" decoration-info="state == 'confirmed'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/> -->
                <field name="state" widget="badge" decoration-warning="state == 'process'" decoration-info="state == 'confirmed'" decoration-danger="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <!-- Graph -->
    <record id="view_lhm_contractor_line_graph" model="ir.ui.view">
        <field name="name">lhm.contractor.line.graph</field>
        <field name="model">lhm.contractor.line</field>
        <field name="arch" type="xml">
            <graph>
                <field name="supplier_id" type="row"/>
                <field name="activity_id" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot -->
    <record id="view_lhm_contractor_line_pivot" model="ir.ui.view">
        <field name="name">lhm.contractor.line.pivot</field>
        <field name="model">lhm.contractor.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="supplier_id" type="row"/>
                <field name="location_type_id" type="row"/>
                <field name="activity_id" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search -->
    <record id="lhm_contractor_line_view_search" model="ir.ui.view">
        <field name="name">lhm.contractor.line.view.search</field>
        <field name="model">lhm.contractor.line</field>
        <field name="arch" type="xml">
            <search string="LHM Kontractor">
                <field name="date" string="Date"/>
                <field name="supplier_id" string="Kontraktor"/>
                <field name="contractor_id" string="Buku Kontraktor"/>
                <field name="location_id" string="Lokasi"/>
                <field name="location_type_id" string="Tipe Lokasi"/>
                <field name="varieties_id" string="ORG"/>
                <field name="activity_id" string="Aktivitas"/>
                <separator/>
                <filter string="Date" name="date" date="date"/>
                <separator/>
                <filter name="draft" string="New" domain="[('state','=','draft')]"/>
                <filter name="process" string="Progress" domain="[('state','=','process')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="cancel" string="Cancel" domain="[('state','=','cancel')]"/>
                <!-- <filter name="approve" string="Approve" domain="[('state','=','done')]"/> -->
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Buku Kontraktor" name="contractor_id" context="{'group_by':'contractor_id'}"/>
                    <filter string="Kontraktor" name="supplier_id" context="{'group_by':'supplier_id'}"/>
                    <filter string="Lokasi" name="location_id" context="{'group_by':'location_id'}"/>
                    <filter string="Tipe Lokasi" name="location_type_id" context="{'group_by':'location_type_id'}"/>
                    <filter string="ORG" name="varieties_id" context="{'group_by':'varieties_id'}"/>
                    <filter string="Aktivitas" name="activity_id" context="{'group_by':'activity_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="lhm_contractor_line_action" model="ir.actions.act_window">
        <field name="name">Detail Buku Kontraktor</field>
        <field name="res_model">lhm.contractor.line</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="search_view_id" ref="lhm_contractor_line_view_search"/>
        <field name="context">
        {
            'create': False,
            'search_default_confirmed':1
        }
        </field>
    </record>

    <!-- Menu -->
    <menuitem
        id="lhm_contractor_line_menu"
        name="Detail Buku Kontraktor"
        action="lhm_contractor_line_action"
        parent="menu_plantation_report"
        sequence="98"/>


</odoo>
