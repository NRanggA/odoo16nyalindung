<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_move_form" model="ir.ui.view">
            <field name="name">view.account.move.form</field>
            <field name="model">account.move</field>
            <field name="priority">25</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="before">
                    <field name="plantation_location_type_id" 
                        options="{'no_create':True, 'no_create':True, 'no_open': True}"/>
                    <field name="plantation_validator" invisible="1"/>
                    <field name="varieties_validator" invisible="1"/>
                    <field name="plantation_varieties_id" options="{'no_edit':True, 'no_create':True, 'no_open': True}" 
                        attrs="{'readonly': [('varieties_validator','=',False)], 
                                'required': [('varieties_validator','=',True)]}" />
                    <field name="filtered_locations" invisible="1"/> 
                        <!-- domain="[('type_id','=',plantation_location_type_id)]"  -->
                    <field name="plantation_location_id" 
                        domain="[('id','in',filtered_locations)]" 
                        options="{'no_edit':True, 'no_create':True, 'no_open': True}"
                        attrs="{'readonly': [('plantation_validator','=',True)], 
                            'required': [('plantation_validator','=',False)]}"/>
                    <field name="filtered_activities" invisible="1"/> 
                        <!-- domain="[('type_id','=',plantation_location_type_id)]"  -->
                    <field name="plantation_activity_id" 
                        domain="[('id','in',filtered_activities)]" 
                        options="{'no_edit':True, 'no_create':True, 'no_open': True}"
                        attrs="{'readonly': [('plantation_validator','=',True)], 
                            'required': [('plantation_validator','=',False)]}"/>
                    <field name="plantation_src_journal_id" options="{'no_edit':True, 'no_create':True, 'no_open': True}" groups="base.group_no_one" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_move_line_form" model="ir.ui.view">
            <field name="name">view.account.move.line.form</field>
            <field name="model">account.move.line</field>
            <field name="priority">25</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <field name="account_id" position="before">
                    <field name="plantation_location_type_id" 
                        options="{'no_create':True, 'no_create':True, 'no_open': True}"/>
                    <field name="plantation_validator" invisible="1"/>
                    <field name="varieties_validator" invisible="1"/>
                    <field name="plantation_varieties_id" options="{'no_edit':True, 'no_create':True, 'no_open': True}" 
                        attrs="{'readonly': [('varieties_validator','=',False)], 
                                'required': [('varieties_validator','=',True)]}" />
                    <field name="filtered_locations" invisible="1"/> 
                        <!-- domain="[('type_id','=',plantation_location_type_id)]"  -->
                    <field name="plantation_location_id" 
                        domain="[('id','in',filtered_locations)]" 
                        options="{'no_edit':True, 'no_create':True, 'no_open': True}"
                        attrs="{'readonly': [('plantation_validator','=',True)], 
                            'required': [('plantation_validator','=',False)]}"/>
                    <field name="filtered_activities" invisible="1"/> 
                        <!-- domain="[('type_id','=',plantation_location_type_id)]"  -->
                    <field name="plantation_activity_id" 
                        domain="[('id','in',filtered_activities)]" 
                        options="{'no_edit':True, 'no_create':True, 'no_open': True}"
                        attrs="{'readonly': [('plantation_validator','=',True)], 
                            'required': [('plantation_validator','=',False)]}"/>
                    <field name="plantation_src_journal_id" groups="base.group_no_one" options="{'no_edit':True, 'no_create':True, 'no_open': True}" optional="hide"/>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="invoice_supplier_form_inherit_plantation">
            <field name="name">invoice.supplier.form.inherit.plantation</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="before">
                    <field name="plantation_location_type_id" 
                        options="{'no_create':True, 'no_create':True, 'no_open': True}"/>
                    <field name="plantation_validator" invisible="1"/>
                    <field name="varieties_validator" invisible="1"/>
                    <field name="plantation_varieties_id" options="{'no_edit':True, 'no_create':True, 'no_open': True}" 
                        attrs="{'readonly': [('varieties_validator','=',False)], 
                                'required': [('varieties_validator','=',True)]}" />
                    <field name="filtered_locations" invisible="1"/> 
                        <!-- domain="[('type_id','=',plantation_location_type_id)]"  -->
                    <field name="plantation_location_id" 
                        domain="[('id','in',filtered_locations)]" 
                        options="{'no_edit':True, 'no_create':True, 'no_open': True}"
                        attrs="{'readonly': [('plantation_validator','=',True)], 
                            'required': [('plantation_validator','=',False)]}"/>
                    <field name="filtered_activities" invisible="1"/> 
                        <!-- domain="[('type_id','=',plantation_location_type_id)]"  -->
                    <field name="plantation_activity_id" 
                        domain="[('id','in',filtered_activities)]" 
                        options="{'no_edit':True, 'no_create':True, 'no_open': True}"
                        attrs="{'readonly': [('plantation_validator','=',True)], 
                            'required': [('plantation_validator','=',False)]}"/>
                    <field name="plantation_src_journal_id" options="{'no_edit':True, 'no_create':True, 'no_open': True}" groups="base.group_no_one"  optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>