<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Account Period Form view -->
        <record id="account_period_view_form" model="ir.ui.view">
            <field name="name">account.period.view.form</field>
            <field name="model">account.period</field>
            <field name="arch" type="xml">
                <form string="Account Period">
                    <header>
                        <button name="close_period" string="Close Period" type="object" states="draft" class="oe_highlight"/>
                        <button name="reopen_period" string="Re-Open Period" type="object" states="done" groups="account.group_account_manager"/>
                        <field name="state" widget="statusbar" nolabel="1"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="year"/>
                                <label for="date_start" string="Duration"/>
                                <div>
                                    <field name="date_start" class="oe_inline" nolabel="1"/>
                                    -
                                    <field name="date_stop" nolabel="1" class="oe_inline"/>
                                </div>
                            </group>
                            <group>
                                <field name="code"/>
                                <field name="special"/>
                                <field name="company_id" widget="selection"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Account Period Tree view -->
        <record id="account_period_view_tree" model="ir.ui.view">
            <field name="name">account.period.view.tree</field>
            <field name="model">account.period</field>
            <field name="arch" type="xml">
                <tree string="Account Period">
                    <field name="name" />
                    <field name="code" />
                    <field name="special" />
                    <field name="date_start" />
                    <field name="date_stop" />
                    <field name="year" />
                    <field name="company_id" />
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Action Account Period -->
        <record id="account_period_action" model="ir.actions.act_window">
            <field name="name">Account Period</field>
            <field name="res_model">account.period</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Klik untuk menambahkan account period.
                </p>
            </field>
        </record>



        <record id="view_account_move_form" model="ir.ui.view">
            <field name="name">view.account.move.form</field>
            <field name="model">account.move</field>
            <field name="priority">25</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="before">
                    <field name="plantation_location_type_id" options="{'no_create_edit':True, 'no_create':True}"/>
                    <field name="plantation_location_id" domain="[('type_id','=',plantation_location_type_id)]" options="{'no_create_edit':True, 'no_create':True}"/>
                    <field name="plantation_activity_id" domain="[('type_id','=',plantation_location_type_id)]" options="{'no_create_edit':True, 'no_create':True}"/>
                    <field name="plantation_validator" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_account_move_line_form" model="ir.ui.view">
            <field name="name">view.account.move.line.form</field>
            <field name="model">account.move.line</field>
            <field name="priority">25</field>
            <field name="inherit_id" ref="account.view_move_line_form"/>
            <field name="arch" type="xml">
                <field name="account_id" position="before">
                    <field name="plantation_location_type_id" options="{'no_create_edit':True, 'no_create':True}"/>
                    <field name="plantation_location_id" domain="[('type_id','=',plantation_location_type_id)]" options="{'no_create_edit':True, 'no_create':True}"/>
                    <field name="plantation_activity_id" domain="[('type_id','=',plantation_location_type_id)]" options="{'no_create_edit':True, 'no_create':True}"/>
                    <field name="plantation_validator" invisible="1"/>
                </field>
            </field>
        </record>

