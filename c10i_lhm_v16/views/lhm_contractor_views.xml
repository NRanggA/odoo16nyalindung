<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <!-- Transaksi Buku Kontraktor -->
        <record id="view_lhm_contractor_form" model="ir.ui.view">
            <field name="name">view.lhm.contractor.form</field>
            <field name="model">lhm.contractor</field>
            <field name="arch" type="xml">
                <form string="Buku Kontraktor">
                    <header attrs="{'invisible': [('approval','!=',True)]}">
                        <button name="button_draft" states="cancel,confirmed" string="Set Draft" type="object" class="btn-default"/>
                        <button name="get_material" string="Material" states="draft" type="object" groups="c10i_lhm_v16.group_plantation_operator"/>
                        <button name="button_confirm" states="draft" string="Confirm" type="object" class="btn-default btn-primary"/>
                        <button name="button_cancel" states="confirmed" string="Cancel" type="object" class="btn-default"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,cancel,confirmed,done"/>
                    </header>
                    <field name="doc_type_id" invisible="1"/><field name="approval" invisible="1"/>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Nama" class="oe_edit_only"/>
                            <h1><field name="name" readonly="1" force_save="1"/></h1>
                        </div>
                        <group name="lhm_contractor">
                            <group>
                                <label for="contractor_vehicle" string="Alat"/>
                                <div>
                                    <field name="contractor_vehicle" force_save="1" class="oe_inline" nolabel="1" attrs="{'readonly': ['|',('line_ids','!=',[]),('line_vehicle_ids','!=',[])]}"/>
                                    <label for="total_type" string="Dasar Perhitungan" attrs="{'readonly': ['|',('line_ids','!=',[]),('line_vehicle_ids','!=',[])],'invisible':[('contractor_vehicle','!=',True)]}"/>
                                    <field name="total_type" class="oe_inline" nolabel="1" force_save="1" attrs="{'readonly': ['|',('line_ids','!=',[]),('line_vehicle_ids','!=',[])],'invisible':[('contractor_vehicle','!=',True)],'required':[('contractor_vehicle','!=',False)]}"/>
                                </div>

                                <field name="supplier_id" force_save="1" context="{'search_default_supplier':1, 'default_supplier':1, 'default_customer':0}" required="1" attrs="{'readonly': ['|',('line_ids','!=',[]),('line_vehicle_ids','!=',[])]}" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="payment_type" force_save="1" attrs="{'readonly': ['|',('line_ids','!=',[]),('line_vehicle_ids','!=',[])]}" required="0"/>

                                <field name="account_period_id" force_save="1" required="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" attrs="{'readonly': ['|',('line_ids','!=',[]),('line_vehicle_ids','!=',[])]}" domain="[('special','=',False),('state','=','draft')]"/>
                                <label for="date_start" string="Periode Pembayaran"/>
                                <div>
                                    <field name="date_start" force_save="1" class="oe_inline" nolabel="1" required="1" attrs="{'readonly': ['|',('line_ids','!=',[]),('line_vehicle_ids','!=',[])]}"/> -
                                    <field name="date_end" force_save="1" nolabel="1" class="oe_inline" required="1" attrs="{'readonly': ['|',('line_ids','!=',[]),('line_vehicle_ids','!=',[])]}"/>
                                </div>
                            </group>
                            <group>
                                <field name="supplier_code"/>
                                <field name="type"/>
                                <field name="company_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="user_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="operating_unit_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="invoice_id" readonly="1" options="{'no_create_edit':True, 'no_create':True}"/>
                                <field name="amount_total" widget="monetary"/>
                                <field name="date_stop" readonly="1" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detail Aktivitas">
                                <field name="line_vehicle_ids" force_save="1" nolabel="1" attrs="{'invisible':[('contractor_vehicle','!=',True)],'readonly': [('state','!=','draft'),('approval','=',True)]}" options="{'always_reload': True}" context="{'form_view_ref':'c10i_lhm_v16.view_lhm_contractor_line_form', 'line_vehicle_ids':line_vehicle_ids,'period_id':account_period_id, 'supplier_id':supplier_id, 'contractor_vehicle':contractor_vehicle}" widget="one2many_list">
                                    <tree editable="bottom">
                                        <field name="name" invisible="1"/>
                                        <field name="tidak_ditagihkan" optional="show"/>
                                        <field name="date" optional="show"/>
                                        <field name="vehicle_id" domain="[('ownership','=','rental')]" optional="show"/>
                                        <field name="start_value" optional="show"/>
                                        <field name="end_value" optional="show"/>
                                        <field name="difference_value" optional="show"/>
                                        <field name="distance_value" optional="show"/>
                                        <field name="location_type_id" domain="[('no_line','=',False)]" 
                                            options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" 
                                            optional="show"/>
                                        <field name="varieties_validator" invisible="1"/>
                                        <field name="varieties_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" 
                                            attrs="{'readonly': [('varieties_validator','=',False)], 
                                                    'required': [('varieties_validator','=',True)]}"/>
                                        <field name="filtered_locations" invisible="1" />
                                        <field name="location_id" 
                                            domain="[('id','in',filtered_locations)]" 
                                            options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="filtered_activities" invisible="1" />
                                        <field name="activity_id" 
                                            domain="[('id','in',filtered_activities)]" 
                                            options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" />
                                        <field name="uom_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" optional="show"/>
                                        <field name="nilai" optional="show"/>
                                        <field name="uom2_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" optional="show"/>
                                        <field name="nilai2" optional="show"/>
                                        <field name="unit_price" optional="show"/>
                                        <field name="total" optional="show"/>
                                        <field name="filter_charge_ids" widget="many2many_tags" invisible="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="charge_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" domain="[('id','in',filter_charge_ids[0][2])]" attrs="{'readonly':[('filter_charge_ids','=', [])]}" optional="show"/>
                                        <field name="uom_charge_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" attrs="{'readonly':[('filter_charge_ids','=', [])]}" optional="show"/>
                                        <field name="contractor_vehicle" invisible="1"/>
                                        <field name="type" invisible="1"/>
                                    </tree>
                                </field>
                                <field name="line_ids" nolabel="1" attrs="{'invisible':[('contractor_vehicle','!=',False)],'readonly': [('state','!=','draft'),('approval','=',True)]}" options="{'always_reload': True}" context="{'form_view_ref':'c10i_lhm_v16.view_lhm_contractor_line_form'}">
                                    <tree editable="bottom">
                                        <field name="name" invisible="1"/>
                                        <!-- <field name="tidak_ditagihkan" optional="show"/> -->
                                        <field name="date" required="1" optional="show"/>
                                        <field name="location_type_id" 
                                            domain="[('no_line','=',False)]" 
                                            options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="varieties_validator" invisible="1"/>
                                        <field name="varieties_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" 
                                            attrs="{'readonly': [('varieties_validator','=',False)], 
                                                    'required': [('varieties_validator','=',True)]}"/>
                                        <field name="filtered_locations" invisible="1" />
                                        <field name="location_id" 
                                            domain="[('id','in',filtered_locations)]" 
                                            options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="filtered_activities" invisible="1" />
                                        <field name="activity_id" 
                                            domain="[('id','in',filtered_activities)]" 
                                            options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        
                                        <field name="uom_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" optional="show"/>
                                        <field name="nilai" optional="show"/>
                                        <field name="uom2_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" optional="show"/>
                                        <field name="nilai2" optional="show"/>
                                        <field name="unit_price" optional="show"/>
                                        <field name="total" optional="show"/>
                                        <field name="contractor_vehicle" invisible="1"/>
                                        <field name="type" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Material" attrs="{'invisible': [('material_line_ids','=',[])]}">
                                <field name="material_line_ids" nolabel="1" >
                                    <tree editable="bottom" create="false">
                                        <field name="date" readonly="1" />
                                        <field name="name" readonly="1"/>
                                        <field name="product_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="activity_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="activity_name" readonly="1"/>
                                        <field name="location_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="move_id" invisible="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="picking_id" invisible="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="product_uom_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="real_stock_qty" readonly="1"/>
                                        <field name="stock_qty" readonly="1"/>
                                        <field name="realization"/>
                                        <field name="residual_qty" readonly="1"/>
                                        <!-- <field name="line_id" invisible="1"/> -->
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <field name="note" placeholder="Tulis Catatan Disini..." nolabel="1" colspan="8"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_lhm_contractor_tree" model="ir.ui.view">
            <field name="name">view.lhm.contractor.tree</field>
            <field name="model">lhm.contractor</field>
            <field name="arch" type="xml">
                <tree string="Buku Kontraktor">
                    <field name="name"/>
                    <field name="supplier_id"/>
                    <field name="supplier_code"/>
                    <field name="account_period_id"/>
                    <field name="payment_type"/>
                    <field name="contractor_vehicle"/>
                    <field name="company_id"/>
                    <field name="state" widget="badge" decoration-warning="state == 'process'" decoration-info="state == 'confirmed'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
                    <field name="invoice_id"/>
                    <field name="date_start" invisible="1"/>
                    <field name="date_stop" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="view_lhm_contractor_filter" model="ir.ui.view">
            <field name="name">view.lhm.contractor.filter</field>
            <field name="model">lhm.contractor</field>
            <field name="arch" type="xml">
                <search string="Buku Kontraktor">
                    <field name="name" string="Nama Kontrak"/>
                    <field name="supplier_id" string="Nama Kontraktor" filter_domain="['|',('supplier_id','ilike',self),('supplier_code','ilike',self)]"/>
                    <separator/>
                    <!-- <filter name="date_today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/> -->
                    <filter name="date_monthly" string="Monthly" domain="['&amp;', ('date_stop', '&gt;=', (context_today()-datetime.timedelta(days=5)).strftime('%Y-%m-%d')), ('date_start', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Kontraktor" name="supplier_id" context="{'group_by':'supplier_id'}"/>
                        <filter string="Periode" name="supplier_id" context="{'group_by':'account_period_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_lhm_contractor" model="ir.actions.act_window">
            <field name="name">Buku Kontraktor Bulanan</field>
            <field name="res_model">lhm.contractor</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lhm_contractor_filter"/>
            <field name="domain">[('type','=','vendor'),('date', '=', False)]</field>
            <field name="context">{'readonly_by_pass': True, 'default_type':'vendor', 'search_default_date_monthly':1}</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                Klik untuk menambahkan Buku Kontraktor.
              </p>
            </field>
        </record>
        <record model="ir.actions.act_window.view" id="action_lhm_contractor_tree">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_lhm_contractor_tree"/>
            <field name="act_window_id" ref="action_lhm_contractor"/>
        </record>
        <record model="ir.actions.act_window.view" id="action_lhm_contractor_form">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_lhm_contractor_form"/>
            <field name="act_window_id" ref="action_lhm_contractor"/>
        </record>
        <record id="action_lhm_contractor_all" model="ir.actions.act_window">
            <field name="name">Buku Kontraktor</field>
            <field name="res_model">lhm.contractor</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_lhm_contractor_filter"/>
            <field name="domain">[('type','=','vendor')]</field>
            <field name="context">{'readonly_by_pass': True, 'default_type':'vendor'}</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                Klik untuk menambahkan Buku Kontraktor.
              </p>
            </field>
        </record>
        <record model="ir.actions.act_window.view" id="action_lhm_contractor_all_tree">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_lhm_contractor_tree"/>
            <field name="act_window_id" ref="action_lhm_contractor_all"/>
        </record>
        <record model="ir.actions.act_window.view" id="action_lhm_contractor_all_form">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_lhm_contractor_form"/>
            <field name="act_window_id" ref="action_lhm_contractor_all"/>
        </record>
        

        <!-- <menuitem id="menu_lhm_contractor_group" name="Buku Kontraktor" parent="menu_lhm_transaction" sequence="29" groups="group_plantation_operator"/> -->
        <menuitem id="menu_lhm_contractor_group" name="Buku Kontraktor" parent="menu_lhm_transaction" sequence="29" />
        <menuitem id="submenu_lhm_contractor_harian" action="action_lhm_contractor_harian" parent="menu_lhm_contractor_group" sequence="1"/>
        <menuitem id="submenu_lhm_contractor" action="action_lhm_contractor" parent="menu_lhm_contractor_group" sequence="2"/>
        <!-- <menuitem id="submenu_lhm_contractor_all" action="action_lhm_contractor_all" parent="menu_plantation_transaction_all" groups="group_plantation_operator" sequence="50"/> -->
        <!-- End of Transaksi Buku Kontraktor -->


        <!-- LHM Contractor Line-->
        <record id="view_lhm_contractor_line_form" model="ir.ui.view">
            <field name="name">view.lhm.contractor.line.form</field>
            <field name="model">lhm.contractor.line</field>
            <field name="arch" type="xml">
                <form string="Daftar Aktivitas">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Nama" class="oe_edit_only"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group name="lhm_transaction">
                            <group string="Informasi Umum">
                                <field name="date"/>
                                <field name="nilai"/>
                                <field name="uom_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="nilai2"/>
                                <field name="uom2_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="unit_price"/>
                                <field name="total"/>
                            </group>
                            <group string="Location &amp; Activity">
                                <field name="location_type_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="location_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="activity_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- End Of LHM Contractor Line -->


        <!-- Transaksi Buku Kontraktor Alat-->
        <record id="view_lhm_vehicle_contractor_form" model="ir.ui.view">
            <field name="name">view.lhm.vehicle.contractor.form</field>
            <field name="model">lhm.contractor</field>
            <field name="arch" type="xml">
                <form string="Buku Kontraktor Alat">
                    <header attrs="{'invisible': [('approval','!=',True)]}">
                        <button name="button_draft" states="cancel,confirmed" string="Set Draft" type="object" class="btn-default"/>
                        <button name="button_confirm" states="draft" string="Confirm" type="object" class="btn-default btn-primary"/>
                        <button name="button_cancel" states="confirmed" string="Cancel" type="object" class="btn-default"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,cancel,confirmed,done"/>
                    </header>
                    <field name="doc_type_id" invisible="1"/><field name="approval" invisible="1"/>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Nama" class="oe_edit_only"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group name="lhm_vehicle_contractor">
                            <group>

                                <field name="supplier_id" context="{'search_default_supplier':1, 'default_supplier':1, 'default_customer':0}" required="1" attrs="{'readonly': [('line_ids','!=',[])]}" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="payment_type" attrs="{'readonly': [('line_ids','!=',[])]}" required="1"/>

                                <!-- error domain pada field ini, domain="[('special','=',False),('state','=','draft')]" -->
                                <field name="account_period_id" required="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" attrs="{'readonly': [('line_ids','!=',[])]}" domain="[('special','=',False),('state','=','draft')]"/>

                                <field name="operating_unit_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="contractor_vehicle"/>
                            </group>
                            <group>
                                <field name="supplier_code"/>
                                <field name="type"/>
                                <field name="company_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <field name="user_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                <label for="date_start" string="Periode Pembayaran"/>
                                <div>
                                    <field name="date_start" class="oe_inline" nolabel="1" required="1" attrs="{'readonly': [('line_ids','!=',[])]}"/> -
                                    <field name="date_end" nolabel="1" class="oe_inline" required="1" attrs="{'readonly': [('line_ids','!=',[])]}"/>
                                </div>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detail Aktivitas">
                                <field name="line_ids" nolabel="1" attrs="{'readonly': [('state','!=','draft'),('approval','=',True)]}" context="{'form_view_ref':'c10i_lhm_v16.view_lhm_vehicle_contractor_line_form'}">
                                    <tree editable="bottom">
                                        <field name="name" invisible="1"/>
                                        <field name="date"/>
                                        <!-- <field name="vehicle_id" domain="[('ownership','=','rental')]" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/> -->
                                        <field name="location_type_id" 
                                            options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="varieties_validator" invisible="1"/>
                                        <field name="varieties_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" 
                                            attrs="{'readonly': [('varieties_validator','=',False)], 
                                                    'required': [('varieties_validator','=',True)]}"/>
                                        <field name="filtered_locations" invisible="1" />
                                        <field name="location_id" 
                                            domain="[('id','in',filtered_locations)]" 
                                            options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="filtered_activities" invisible="1" />
                                        <field name="activity_id" 
                                            domain="[('id','in',filtered_activities)]" 
                                            options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="uom_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="nilai"/>
                                        <field name="uom2_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                        <field name="nilai2"/>
                                        <field name="unit_price"/>
                                        <field name="total"/>
                                        <field name="type" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <field name="note" placeholder="Tulis Catatan Disini..." nolabel="1" colspan="8"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_lhm_vehicle_contractor_tree" model="ir.ui.view">
            <field name="name">view.lhm.vehicle.contractor.tree</field>
            <field name="model">lhm.contractor</field>
            <field name="arch" type="xml">
                <tree string="Buku Kontraktor Alat">
                    <field name="name"/>
                    <field name="supplier_id"/>
                    <field name="supplier_code"/>
                    <field name="account_period_id"/>
                    <field name="payment_type"/>
                    <field name="contractor_vehicle"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="view_lhm_vehicle_contractor_filter" model="ir.ui.view">
            <field name="name">view.lhm.vehicle.contractor.filter</field>
            <field name="model">lhm.contractor</field>
            <field name="arch" type="xml">
                <search string="Buku Kontraktor Alat">
                    <field name="name" string="Nama Kontrak"/>
                    <field name="supplier_id" string="Nama Kontraktor" filter_domain="['|',('supplier_id','ilike',self),('supplier_code','ilike',self)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Kontraktor" name="supplier_id" context="{'group_by':'supplier_id'}"/>
