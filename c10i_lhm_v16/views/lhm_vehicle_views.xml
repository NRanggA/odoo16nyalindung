<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Transaksi Buku Kendaraan -->
    <record id="view_lhm_vehicle_form" model="ir.ui.view">
        <field name="name">view.lhm.vehicle.form</field>
        <field name="model">lhm.vehicle</field>
        <field name="arch" type="xml">
            <form string="Buku Kendaraan">
                <header>
                    <button name="button_draft" states="cancel,confirmed" string="Set Draft" type="object" class="btn-default"/>
                    <button name="button_confirm" states="draft" string="Confirm" type="object" class="btn-default btn-primary"/>
                    <button name="button_cancel" states="confirmed" string="Cancel" type="object" class="btn-default"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,cancel,confirmed,done"/>
                </header>
                <field name="doc_type_id" invisible="1"/>
                <field name="approval" invisible="1"/>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nama" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1" force_save="1"/></h1>
                    </div>
                    <group name="lhm_vehicle">
                        <group>
                            <field name="date_start" invisible="0"/>
                            <field name="date_stop" invisible="0"/>
                            <field name="vehicle_id" force_save="1" required="1" context="{'form_view_ref':'c10i_lhm_v16.view_lhm_utility_vehicle_form', 'default_type':'vh'}" attrs="{'readonly': [('line_ids','!=',[])]}" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            <field name="vehicle_code" readonly="1" force_save="1"/>
                            <!-- <field name="account_period_id" required="1" force_save="1" attrs="{'readonly': [('line_ids','!=',[])]}" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" domain="[('special','=',False),('state','=','draft')]"/> -->
                            <!-- <field name="operating_unit_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/> -->
                        </group>
                        <group>
                            <field name="reg_number" force_save="1"/>
                            <field name="uom_performance" force_save="1"/>
                            <field name="company_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            <field name="user_id" readonly="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail Aktivitas">
                            <!-- error context, 'period_id': account_period_id}" -->
                            <field name="line_ids" nolabel="1" widget="one2many_list" attrs="{'readonly': [('state','!=','draft'),('approval','=',True)]}" context="{'line_ids':line_ids, 'vehicle_id':vehicle_id}">
                                <tree editable="bottom">
                                    <field name="date" optional="show"/>
                                    <field name="name" invisible="1"/>
                                    <field name="use_hours" widget="time_float" optional="show"/>
                                    <field name="start_value" optional="show"/>
                                    <field name="end_value" optional="show"/>
                                    <field name="difference_value" optional="show"/>
                                    <!-- <field name="doc_activity_ids" widget="many2many_tags" invisible="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/> -->
                                    <field name="location_type_id" domain="[('code','not in',['WS','VH'])]"
                                        options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" />
                                    <field name="varieties_validator" invisible="1"/>
                                    <field name="varieties_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" 
                                        attrs="{'readonly': [('varieties_validator','=',False)], 
                                                'required': [('varieties_validator','=',True)]}"/>
                                    <field name="filtered_locations" invisible="1" />
                                    <field name="location_id" 
                                        domain="[('id','in',filtered_locations)]" 
                                        options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" />
                                    <field name="filtered_activities" invisible="1" />
                                    <field name="activity_id" 
                                        domain="[('id','in',filtered_activities)]" 
                                        options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" />
                                    <field name="performance1" optional="show"/>
                                    <field name="uom_performance1_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" optional="show"/>
                                    <field name="performance2" optional="show"/>
                                    <field name="uom_performance2_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" optional="show"/>
                                    <field name="filter_charge_ids" widget="many2many_tags" invisible="1" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                                    <field name="charge_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" domain="[('id','in',filter_charge_ids)]" optional="show"/>
                                    <field name="value_charge" optional="show"/>
                                    <field name="uom_charge_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" optional="show"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lhm_vehicle_tree" model="ir.ui.view">
        <field name="name">view.lhm.vehicle.tree</field>
        <field name="model">lhm.vehicle</field>
        <field name="arch" type="xml">
            <tree string="Buku Kendaraan">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="vehicle_code"/>
                <field name="date_start" />
                <field name="date_stop" />
                <field name="reg_number" />
                <field name="uom_performance" />
                <!-- <field name="account_period_id"/> -->
                <field name="company_id"/>
                <field name="date_start" invisible="1"/>
                <field name="date_stop" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_lhm_vehicle_filter" model="ir.ui.view">
        <field name="name">view.lhm.vehicle.filter</field>
        <field name="model">lhm.vehicle</field>
        <field name="arch" type="xml">
            <search string="Buku Kendaraan">
                <field name="name" string="Nama Buku Kendaraan"/>
                <field name="vehicle_id" string="Nama Kendaraan" filter_domain="['|',('vehicle_code','ilike',self),('vehicle_id','ilike',self)]"/>
                <separator/>
                <filter name="date_monthly" string="Monthly" domain="['&amp;', ('date_stop', '&gt;=', (context_today()-datetime.timedelta(days=5)).strftime('%Y-%m-%d')), ('date_start', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Kendaraan" name="vehicle_id" context="{'group_by':'vehicle_id'}"/>
                    <!-- <filter string="Periode" name="account_period_id" context="{'group_by':'account_period_id'}"/> -->
                </group>
            </search>
        </field>
    </record>

    <record id="action_lhm_vehicle" model="ir.actions.act_window">
        <field name="name">Buku Kendaraan</field>
        <field name="res_model">lhm.vehicle</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_lhm_vehicle_filter"/>
        <field name="domain">[]</field>
        <field name="context">{'readonly_by_pass': ['vehicle_id','account_period_id'], 'search_default_date_monthly':1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            Klik untuk menambahkan Buku Kendaraan.
            </p>
        </field>
    </record>
    <record id="action_lhm_vehicle_all" model="ir.actions.act_window">
        <field name="name">Buku Kendaraan</field>
        <field name="res_model">lhm.vehicle</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_lhm_vehicle_filter"/>
        <field name="domain">[]</field>
        <field name="context">{'readonly_by_pass': ['vehicle_id','account_period_id']}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            Klik untuk menambahkan Buku Kendaraan.
            </p>
        </field>
    </record>
    <menuitem id="submenu_lhm_vehicle" action="action_lhm_vehicle" parent="menu_plantation_transaction" sequence="30"/>
    <!-- End of Transaksi Buku Kendaraan -->

    <!-- LHM Vehicle Line-->
    <record id="view_lhm_vehicle_line_form" model="ir.ui.view">
        <field name="name">view.lhm.vehicle.line.form</field>
        <field name="model">lhm.vehicle.line</field>
        <field name="arch" type="xml">
            <form string="Daftar Aktivitas">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nama" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group name="lhm_transaction">
                        <group string="Informasi Umum">
                            <field name="date"/>
                            <field name="start_value"/>
                            <field name="end_value"/>
                            <field name="difference_value"/>
                            <field name="performance1"/>
                            <field name="uom_performance1_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            <field name="performance2"/>
                            <field name="uom_performance2_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            <field name="charge_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            <field name="value_charge"/>
                            <field name="uom_charge_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                        </group>
                        <group string="Location &amp; Activity">
                            <field name="location_type_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            <field name="location_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            <field name="activity_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                            <field name="sub_activity_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- End Of LHM Vehicle Line -->

</odoo>
