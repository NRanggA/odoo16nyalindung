<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- plantation.closing.account.allocation -->
    <record id="plantation_closing_account_allocation_form" model="ir.ui.view">
        <field name="name">plantation.closing.account.allocation.form</field>
        <field name="model">plantation.closing.account.allocation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                </header>
                <sheet>
                    <!-- <field name="closing_sequence_id" invisible="1" /> -->
                    <field name="type" invisible="1"/>
                    <field name="currency_id" invisible="1" />
                    <group>
                        <group>
                            <field name="infrastructure_id" attrs="{'invisible': [('type','!=','infras')]}"/>
                            <field name="total_cost" />
                        </group>
                        <group>
                        </group>
                    </group>

                    <field name="line_ids">
                    	<tree>
                            <field name="cost_allocation_id" />
                            <field name="cost_center_id" />
                            <field name="cost_activity_id" />
                            <field name="dest_account_id" />
                            <field name="cost" />
                    	</tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="plantation_closing_account_allocation_tree" model="ir.ui.view">
        <field name="name">plantation.closing.account.allocation.tree</field>
        <field name="model">plantation.closing.account.allocation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="currency_id" invisible="1" />
                <field name="type"/>
                <field name="cost_center_id" />
                <field name="total_cost" sum="cost"/>
            </tree>
        </field>
    </record>

    <record id="plantation_closing_account_allocation_search" model="ir.ui.view">
        <field name="name">plantation.closing.account.allocation.search</field>
        <field name="model">plantation.closing.account.allocation</field>
        <field name="arch" type="xml">
            <search string="Search Payslip">
                <field name="infrastructure_id"/>
                <filter name="filter_type_infras" string="Infrastructure" domain="[('type','=','infras')]"/>
                <group expand="0" string="Group By...">
                    <filter name="group_type" string="Type" domain="[]" context="{'group_by' : 'type'}"/>
                    <filter name="group_infrastructure" string="Infrastructure" domain="[]" context="{'group_by' : 'infrastructure_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_plantation_closing_account_allocation" model="ir.actions.act_window">
        <field name="name">Account Allocation</field>
        <field name="res_model">plantation.closing.account.allocation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="plantation_closing_account_allocation_search"/>
    </record>
    <!-- END: plantation.closing.account.allocation -->
</odoo>