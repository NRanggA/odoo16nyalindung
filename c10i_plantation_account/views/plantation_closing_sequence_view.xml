<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- plantation.closing.sequence -->
    <record id="plantation_closing_sequence_form" model="ir.ui.view">
        <field name="name">plantation.closing.sequence.form</field>
        <field name="model">plantation.closing.sequence</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="oe_highlight" states="draft"/>
                    
                    <!-- Inventory Closing -->
                    <button name="action_close_inventory" type="object" string="Inventory Close" class="oe_highlight" states="inventory"/>

                    <!-- Payroll Closing -->
                    <button name="action_close_payroll" type="object" string="Payroll Close" class="oe_highlight" states="payroll"/>

                    <!-- Running Workshop Closing -->
                    <button name="action_summerize_and_create_move_running_ws" type="object" string="Compute Data" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','running_ws'),('running_ws_move_id','!=',False)]}"/>
                    <button name="action_summerize_and_create_move_running_ws" type="object" string="Re-Compute Data" attrs="{'invisible': ['|',('state','!=','running_ws'),('running_ws_move_id','=',False)]}"/>
                    <button name="action_close_running_ws" type="object" string="Running Workshop Close" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','running_ws'),('running_ws_move_id','=',False)]}"/>

                    <!-- Running Vehicle Closing -->
                    <button name="action_summerize_and_create_move_running_vh" type="object" string="Compute Data" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','running_vh'),('running_vh_move_id','!=',False)]}"/>
                    <button name="action_summerize_and_create_move_running_vh" type="object" string="Re-Compute Data" attrs="{'invisible': ['|',('state','!=','running_vh'),('running_vh_move_id','=',False)]}"/>
                    <button name="action_close_running_vh" type="object" string="Running Workshop Close" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','running_vh'),('running_vh_move_id','=',False)]}"/>

                    <!-- Running Machine Closing -->
                    <button name="action_summerize_and_create_move_running_ma" type="object" string="Compute Data" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','running_ma'),('running_ma_move_id','!=',False)]}"/>
                    <button name="action_summerize_and_create_move_running_ma" type="object" string="Re-Compute Data" attrs="{'invisible': ['|',('state','!=','running_ma'),('running_ma_move_id','=',False)]}"/>
                    <button name="action_close_running_ma" type="object" string="Running Workshop Close" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','running_ma'),('running_ma_move_id','=',False)]}"/>

                    <!-- Infrastructure Allocation -->
                    <button name="action_summerize_and_create_move_infras" type="object" string="Compute Data" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','infrastructure'),('infras_allocation_move_id','!=',False)]}"/>
                    <button name="action_summerize_and_create_move_infras" type="object" string="Re-Compute Data" attrs="{'invisible': ['|',('state','!=','infrastructure'),('infras_allocation_move_id','=',False)]}"/>
                    <button name="action_close_infras" type="object" string="Infrastructure Allocation Done" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','infrastructure'),('infras_allocation_move_id','=',False)]}"/>

                    <!-- Nursery Allocation and Valuation-->
                    <button name="action_close_nursery" type="object" string="Nursery Valuation Done" class="oe_highlight" states="nursery"/>

                    <!-- Project CIP Allocation-->
                    <button name="action_summerize_and_create_move_project" type="object" string="Compute Data" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','cip'),('project_allocation_move_id','!=',False)]}"/>
                    <button name="action_summerize_and_create_move_project" type="object" string="Re-Compute Data" attrs="{'invisible': ['|',('state','!=','cip'),('project_allocation_move_id','=',False)]}"/>
                    <button name="action_close_cip" type="object" string="CIP Allocation Done" class="oe_highlight" attrs="{'invisible': ['|',('state','!=','cip'),('project_allocation_move_id','=',False)]}"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,inventory,payroll,running_ws,running_vh,running_ma,infrastructure,nursery,cip,plasma,inti,mill,close_period,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>
                        <group>
                            <field name="currency_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                            <field name="company_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="inventory" string="Inventory">
                        </page>
                        <page name="payroll" string="Payroll">
                        </page>
                        <page name="running_ws" string="Running Workshop">
                            <button name="action_view_closing_running_ws_summary" type="object" string="Open Summary"/>
                            <button name="action_view_coresponding_ws_move_line" type="object" string="All Related Moves"/>
                            <group>
                                <group>
                                    <field name="ws_running_account_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}" attrs="{'required': [('state','=','running_ws')]}"/>
                                </group>
                                <group>
                                    <field name="running_ws_move_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page name="running_vh" string="Running Vehicle">
                            <button name="action_view_closing_running_vh_summary" type="object" string="Open Summary"/>
                            <button name="action_view_coresponding_vh_move_line" type="object" string="All Related Moves"/>
                            <group>
                                <group>
                                    <field name="vh_running_account_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}" attrs="{'required': [('state','=','running_vh')]}"/>
                                </group>
                                <group>
                                    <field name="running_vh_move_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page name="running_ma" string="Running Machine">
                            <button name="action_view_closing_running_ma_summary" type="object" string="Open Summary"/>
                            <button name="action_view_coresponding_ma_move_line" type="object" string="All Related Moves"/>
                            <group>
                                <group>
                                    <field name="ma_running_account_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}" attrs="{'required': [('state','=','running_ma')]}"/>
                                </group>
                                <group>
                                    <field name="running_ma_move_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page name="infras_allocation" string="Infrastructure Allocation">
                            <button name="action_view_infras_allocation_summary" type="object" string="Open Summary"/>
                            <button name="action_view_coresponding_infras_move_line" type="object" string="All Related Moves"/>
                            <group>
                                <group>
                                    <field name="src_infras_account_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}" attrs="{'required': [('state','=','infrastructure')]}"/>
                                    <field name="infras_allocation_account_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}" attrs="{'required': [('state','=','infrastructure')]}"/>
                                </group>
                                <group>
                                    <field name="infras_allocation_move_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page name="nursery_allocation" string="Nursery Allocation">
                            <button name="action_view_coresponding_nursery_move_line" type="object" string="All Related Moves"/>
                        </page>
                        <page name="project_allocation" string="Project CIP">
                            <button name="action_view_project_allocation_summary" type="object" string="Open Summary"/>
                            <button name="action_view_coresponding_project_move_line" type="object" string="All Related Moves"/>
                            <group>
                                <group>
                                    <field name="src_project_account_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}" attrs="{'required': [('state','=','cip')]}"/>
                                    <field name="project_allocation_account_id" options="{'no_create': True, 'no_open': True, 'no_edit': True}" attrs="{'required': [('state','=','cip')]}"/>
                                </group>
                                <group>
                                    <field name="project_allocation_move_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <!-- <page name="closing_plasma" string="Closing Plasma">
                        </page>
                        <page name="closing_inti" string="Closing Inti">
                        </page>
                        <page name="mill_valuation" string="Mill Valuation">
                        </page>
                        <page name="completion" string="Review">
                        </page> -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="plantation_closing_sequence_tree" model="ir.ui.view">
        <field name="name">plantation.closing.sequence.tree</field>
        <field name="model">plantation.closing.sequence</field>
        <field name="arch" type="xml">
            <tree>
                <field name="currency_id" invisible="1" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="plantation_closing_sequence_search" model="ir.ui.view">
        <field name="name">plantation.closing.sequence.search</field>
        <field name="model">plantation.closing.sequence</field>
        <field name="arch" type="xml">
            <search string="Search Payslip">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_plantation_closing_sequence" model="ir.actions.act_window">
        <field name="name">Closing Sequence</field>
        <field name="res_model">plantation.closing.sequence</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="plantation_closing_sequence_search"/>
    </record>
    <!-- END: plantation.closing.sequence -->
</odoo>