<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <data>
  
    <record id="ny_equipment_inherit_maintenance_equipment" model="ir.ui.view">
      <field name="name">ny_equipment_inherit_maintenance_equipment</field>
      <field name="model">maintenance.equipment</field>
      <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
            <button string="Create Acquisition" name="create_asset_acquisition" type="object" class="oe_highlight" attrs="{'invisible': ['|','|',('is_lva', '!=', True), ('register_id', '=', True), ('has_acquisition', '=', True)]}"/>
        </xpath>
        <field name="cost" position="after">
          <field name="is_lva" invisible="1"/>
          <field name="has_acquisition" invisible="1"/>
        </field>
        <xpath expr="//field[@name='serial_no']" position="attributes">
          <attribute name="required">0</attribute>
        </xpath>
      </field>
    </record>
  
  </data>
  

</odoo>
