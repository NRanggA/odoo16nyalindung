<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="nyalindung_account_asset_inherit_account_asset" model="ir.ui.view">
            <field name="name">nyalindung.account.asset.inherit.account.asset</field>
            <field name="model">account.asset.asset</field>
            <field name="inherit_id" ref="om_account_asset.view_account_asset_asset_form"/>
            <field name="arch" type="xml">
                <field name="category_id" position="before">
                    <field name="register_id" />
                </field>
            </field>
        </record>

        <record id="view_asset_disposal_form_inherit_view" model="ir.ui.view">
            <field name="name">view.asset.disposal.form.inherit.view</field>
            <field name="model">account.asset.disposal</field>
            <field name="inherit_id" ref="c10i_account_asset.c10i_view_asset_disposal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='do_action']" position="attributes">
                    <attribute name="string">Disposed-off</attribute>
                </xpath>
                <xpath expr="//button[@name='do_action']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|','|',('state', '=', 'closed'),('action','=','sell'),('action','=',False)]}</attribute>
                </xpath>
                <field name="action" position="before">
                    <field name="lva" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                </field>
                <field name="asset_id" position="before">
                    <field name="equip_id" attrs="{'invisible' : [('lva', '!=',True),], 'required' : [('lva','=',True)], 'readonly': [('state', '!=', 'draft')]}"/>
                    <!-- <field name="ref" attrs="{'invisible' : [('ref', '!=',True)]}"/> -->
                </field>
                <xpath expr="//field[@name='reason']" position="attributes">
                    <attribute name="attrs">{'invisible' : [('action','not in',['sell','dispose'])], 'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='asset_id']" position="attributes">
                    <attribute name="attrs">{'invisible' : [('lva','=',True)], 'required' : [('lva','!=',True)], 'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_id']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|',('action', '!=', 'sell'),('lva','=',True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='gain_account_id']" position="attributes">
                    <attribute name="attrs">{'invisible' : ['|',('gain_or_loss', '!=', 'gain'),('lva','=',True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='loss_account_id']" position="attributes">
                    <attribute name="attrs">{'invisible' : ['|','|',('gain_or_loss', '=', 'gain'),('lva','=',True),('action','=',False)]}</attribute>
                </xpath>
                <field name="sell_account_move_id" position="after">
                    <field name="gross_value" attrs="{'invisible' : ['|',('action','=',False), ('lva', '=',True)]}"/>
                    <field name="commulative_depreciation" attrs="{'invisible' : ['|',('action','=',False), ('lva', '=',True)]}"/>
                </field>
            </field>
        </record>
    
    </data>
    

</odoo>
