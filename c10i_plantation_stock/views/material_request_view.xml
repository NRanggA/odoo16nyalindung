<?xml version="1.0" ?>
<odoo>
    <record id="material_request_form" model="ir.ui.view">
        <field name="name">material.request.form</field>
        <field name="model">material.request</field>
        <field name="inherit_id" ref="c10i_material_request.material_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="is_kontraktor" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='name']" position="after">
                <field name="filtered_cost_activity_ids" invisible="1"/>
                <field name="cost_allocation_mark" invisible="1"/>

                <field name="cost_allocation_id" options="{'no_create_edit': True, 'no_create': True}"/>
                <field name="cost_center_id" options="{'no_create_edit': True, 'no_create': True}" attrs="{'required': [('cost_allocation_mark','!=','none')]}"/>
                <field name="cost_activity_id" options="{'no_create_edit': True, 'no_create': True}" domain="[('id','in',filtered_cost_activity_ids)]" attrs="{'required': [('cost_allocation_mark','!=','none')]}"/>
            </xpath>
        </field>
    </record>
</odoo>