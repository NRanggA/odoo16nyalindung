<odoo>
    <record id="product_pricelist_view_inherit2" model="ir.ui.view">
        <field name="name">product.pricelist.form.inherit</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="before">
                <field name="partner_id"/>
                <field name="is_grade"/>

                <!-- Field untuk menandakan melon pricelist -->
                <field name="is_melon"/>

            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="product_pricelist_form_view_inherit" model="ir.ui.view">
        <field name="name">product.pricelist.form.inherit</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="button_approve" states="draft" string="Approve" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running" readonly="1"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='item_ids']/tree[@groups='!product.group_sale_pricelist']/field[@name='min_quantity']" position="attributes">
                <attribute name='attrs'>{'column_invisible': [('parent.is_grade', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='item_ids']/tree[@groups='product.group_sale_pricelist']/field[@name='min_quantity']" position="attributes">
                <attribute name='attrs'>{'column_invisible': [('parent.is_grade', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='item_ids']/tree[@groups='!product.group_sale_pricelist']/field[@name='fixed_price']" position="attributes">
                <attribute name="invisible">0</attribute>
                <!-- <field name="quantity"/> -->
            </xpath>
            <xpath expr="//field[@name='item_ids']/tree[@groups='product.group_sale_pricelist']/field[@name='price']" position="attributes">
                <attribute name="invisible">0</attribute>
                <!-- <field name="quantity"/> -->
            </xpath>
            <xpath expr="//field[@name='item_ids']/tree[@groups='!product.group_sale_pricelist']/field[@name='fixed_price']" position="before">
                <field name="quantity" attrs="{'column_invisible': [('parent.is_grade', '=', False)]}"/>
            </xpath>
            <xpath expr="//field[@name='item_ids']/tree[@groups='product.group_sale_pricelist']/field[@name='price']" position="before">
                <field name="quantity" attrs="{'column_invisible': [('parent.is_grade', '=', False)]}"/>
            </xpath>

            <!-- Inherit view untuk weight from & to -->
            <xpath expr="//field[@name='item_ids']/tree[@groups='!product.group_sale_pricelist']/field[@name='min_quantity']" position="after">
                <field name="weight_from" attrs="{'column_invisible': [('parent.is_melon', '=', False)]}"/>
                <field name="weight_to" attrs="{'column_invisible': [('parent.is_melon', '=', False)]}"/>
            </xpath>
            <!-- Inherit view untuk weight from & to -->
            <xpath expr="//field[@name='item_ids']/tree[@groups='product.group_sale_pricelist']/field[@name='min_quantity']" position="after">
                <field name="weight_from" attrs="{'column_invisible': [('parent.is_melon', '=', False)]}"/>
                <field name="weight_to" attrs="{'column_invisible': [('parent.is_melon', '=', False)]}"/>
            </xpath>


        </field>
    </record>
    <record id="product_pricelist_form_view_inherit_item" model="ir.ui.view">
        <field name="name">product.pricelist.form.inherit.item</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='min_quantity']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='min_quantity']" position="after">
                <field name="quantity" attrs="{'column_invisible': [('parent.is_grade', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
