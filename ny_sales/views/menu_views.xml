<odoo>
    <record model="ir.actions.act_window" id="action_product_pricelist_grade">
        <field name="name">Grade</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.pricelist</field>
        <!-- <field name="view_type">form</field> -->
        <field name="domain">[('name','like','Grade')]</field>
        <field name="context">{'default_is_grade': True}</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Klik Create untuk membuat Grade
            </p>
        </field>
    </record>

    <menuitem
    id="menu_product_pricelist_grade"
    name="Grade"
    action="action_product_pricelist_grade"
    parent="sale.product_menu_catalog"
    sequence="10"/>

</odoo>