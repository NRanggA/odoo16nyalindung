<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="pricelist_id" position="attributes">
                <attribute name="domain">[('is_grade', '=', False), '|', ('company_id', '=', False), ('company_id', '=', company_id)]</attribute>
            </field>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('customer_category', '=', True)]</attribute>
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
            <xpath expr="//field[@name='product_template_id']" position="attributes">
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
            <xpath expr="//field[@name='analytic_account_id']" position="attributes">
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
            <xpath expr="//field[@name='campaign_id']" position="attributes">
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
            <xpath expr="//field[@name='medium_id']" position="attributes">
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
            <xpath expr="//field[@name='source_id']" position="attributes">
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_order_form_inherit_date_order" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.date.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="groups"/>
            </xpath>
            <xpath expr="//div[label[@for='date_order'] and @class='o_td_label']" position="attributes">
                <attribute name="groups"/>
            </xpath>

            <!-- field melon setelah order_line -->
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Melon Order Lines" name="melon_order_lines">
                    <div class="oe_button_box" name="button_generate_melon">
                        <button name="action_generate_order_lines"
                                string="Generate Order Lines"
                                type="object"
                                class="btn btn-primary"
                                attrs="{'invisible': [('state', 'not in', ['draft', 'sent'])]}"
                                />
                    </div>
                    <hr/>
                    <field name="sale_order_line_melon_ids">
                        <tree editable="bottom">
                            <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_qty"/>
                            <field name="total_weight" sum="True"/>
                            <field name="weight" sum="True"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal" readonly="1" sum="True"/>
                        </tree>
                    </field>
                </page>
            </xpath>

            <!-- Menghilangkan field quotation date pada form Quotation -->
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', 'in', ['draft','sale', 'done', 'cancel'])]}</attribute>
            </xpath>
            <xpath expr="//div[label[@for='date_order']]" position="attributes">
                <attribute name="attrs">{'invisible': [('state', 'in', ['draft','sale', 'done', 'cancel'])]}</attribute>
            </xpath>



        </field>
    </record>
    
    <record id="sale_order_stock_inherit_form" model="ir.ui.view">
        <field name="name">sale.order.stock.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <field name="partner_shipping_id" position="after">
                <field name="route_id" options="{'no_create': True, 'no_open': True}" attrs="{'readonly': [('state','!=','draft')], 'required': [('state','=','draft')]}"/>
                <field name="has_melon_lines"  invisible="1" readonly="1"/>
            </field>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="context">{'default_route_id': route_id,}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="route_id" options="{'no_create': True, 'no_open': True}" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']" position="after">
                <field name="qty_butir"  attrs="{'column_invisible': [('parent.has_melon_lines', '=', False)]}"/>
            </xpath>
            <xpath expr="//kanban" position="inside">
                <field name="route_id" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>