<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!-- Cron job Auto Create Account Move-->
        <record forcecreate="True" id="ir_cron_create_auto_account_move" model="ir.cron">
            <field name="name">Auto Account Move</field>
            <field name="model_id" ref="c10i_auto_account_move.model_auto_account_move"/>
            <field name="state">code</field>
            <field name="code">model.generate_auto_account_move()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>
    </data>
    

</odoo>
