<?xml version="1.0" ?>
<odoo>

    <record id="account_direct_payment_form" model="ir.ui.view">
        <field name="name">account.direct.payment.form</field>
        <field name="model">account.direct.payment</field>
        <field name="arch" type="xml">
            <form string="Direct Payment">
                <header>
                    <button name="action_confirm" string="Confirm" states="draft" type="object" class="oe_highlight"/>
                    <button name="action_post" string="Post" states="confirm" type="object" class="oe_highlight"/>
                    <button string="Register Payment" name="action_register_payment" type="object" class="btn-primary" attrs="{'invisible': [('payment_state', '!=', 'not_paid')]}" />

                    <button name="action_draft" string="Set to Draft" states="cancel" type="object" />
                    <button name="action_cancel" string="Cancel" states="draft,confirm" type="object" />
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,posted"/>
                </header>
                <sheet>
                    <field name="payment_state" invisible="1"/>

                    <!-- <div class="oe_button_box" name="button_box">
                        <button type="object"  name="action_open_picking"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o" attrs="{'invisible':[('picking_count', '=', 0)]}"
                            groups="stock.group_stock_user">
                            <field name="picking_count" widget="statinfo"/>
                        </button>
                    </div> -->

                    <!-- Payment status -->
                    <widget name="web_ribbon" title="Paid"
                            attrs="{'invisible': [('payment_state', '!=', 'paid')]}"/>
                    <widget name="web_ribbon" title="In Payment"
                            attrs="{'invisible': [('payment_state', '!=', 'in_payment')]}"/>
                    <!-- <widget name="web_ribbon" title="Partial"
                            attrs="{'invisible': [('payment_state', '!=', 'paid')]}"/> -->

                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" required="1" attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="requested_by" required="1" attrs="{'readonly': [('state','!=','draft')]}" options="{'no_create_edit': True, 'no_create': True}"/>
                            <field name="description" attrs="{'readonly': [('state','!=','draft')]}"/>
                        </group>
                        <group>
                            <field name="journal_id" options="{'no_create_edit': True, 'no_create': True}" invisible="1"/>
                            <field name="currency_id" options="{'no_create_edit': True, 'no_create': True}"/>
                            <field name="account_move_id" readonly="1" groups="account.group_account_user"/>
                            
                            <field name="company_id" options="{'no_create_edit': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Lines">
                            <field name="line_ids" required="1" attrs="{'readonly': [('state','not in',['draft', 'confirm'])]}" >
                                <tree editable="bottom">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="product_id" 
                                        options="{'no_create_edit': True, 'no_create': True}" 
                                        attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
                                    <field name="name" attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
                                    <field name="account_id" 
                                        options="{'no_create_edit': True, 'no_create': True}" 
                                        attrs="{'readonly': [('parent.state', 'not in', ['draft','confirm'])]}"/>
                                    <field name="analytic_account_id" 
                                        options="{'no_create_edit': True, 'no_create': True}" 
                                        attrs="{'readonly': [('parent.state', 'not in', ['draft','confirm'])]}"
                                        groups="analytic.group_analytic_accounting"/>
                                    <field name="amount" attrs="{'readonly': [('parent.state', '!=', 'draft')]}"/>
                                </tree>
                                <form>
                                    <field name="currency_id" invisible="1"/>
                                    <label for="name" />
                                    <field name="name" nolabel="1"/>
                                    <group>
                                        <group>
                                            <field name="product_id" options="{'no_create_edit': True, 'no_create': True}"/>
                                        </group>
                                        <group>
                                            <field name="amount"/>
                                            <field name="account_id" options="{'no_create_edit': True, 'no_create': True}"/>
                                            <field name="analytic_account_id" options="{'no_create_edit': True, 'no_create': True}" groups="analytic.group_analytic_accounting"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total"/>
                                <!-- <field name="invoice_payments_widget" colspan="2" nolabel="1" widget="payment"/> -->
                                <field name="amount_residual" class="oe_subtotal_footer_separator" attrs="{'invisible': [('state', '!=', 'posted')]}" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <record id="account_direct_payment_tree" model="ir.ui.view">
        <field name="name">account.direct.payment.tree</field>
        <field name="model">account.direct.payment</field>
        <field name="arch" type="xml">
            <tree string="Direct Payment" decoration-muted="state=='cancel'">
                <field name="name" />
                <field name="date"/>
                <field name="requested_by"/>
                <field name="currency_id" optional="hide"/>
                <field name="amount_total"/>
                <field name="company_id" optional="hide"/>
                <field name="state" widget="badge" decoration-warning="state=='confirm'" decoration-success="state=='posted'"/>
                <field name="payment_state" widget="badge" optional="show" decoration-warning="payment_state=='not_paid'" decoration-info="payment_state=='in_payment'" decoration-success="payment_state=='paid'"/>
            </tree>
        </field>
    </record>

    <record id="account_direct_payment_search" model="ir.ui.view">
        <field name="name">account.direct.payment.select</field>
        <field name="model">account.direct.payment</field>
        <field name="arch" type="xml">
            <search string="Search Direct Payment">
                <field name="name"/>
                <field name="date"/>
                <field name="requested_by"/>
                <separator/>
                    <filter name="submit" string="To Approve" domain="[('state','=','submit')]"/>
                    <filter name="approve" string="To Post" domain="[('state','=','approved')]"/>
                    <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                    <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                    <filter name="reject" string="Rejected" domain="[('state', '=', 'reject')]"/>
                <separator/>
                    <filter name="in_payment" string="In Payment" domain="[('payment_state', '=', 'in_payment'), ('state', '=', 'posted')]"/>
                    <!-- <filter name="partial" string="Partially Paid" domain="[('payment_state', '=', 'partial'), ('state', '=', 'posted')]"/> -->
                    <filter name="paid" string="Paid" domain="[('payment_state', '=', 'paid'), ('state', '=', 'posted')]"/>
                    <filter name="unpaid" string="Not Paid" domain="[('payment_state', '=', 'not_paid'), ('state', '=', 'posted')]"/>
                <group expand="0" string="Group By">
                    <filter string="Requester" name="requester" context="{'group_by':'requested_by'}"/>
                    <filter name="status" string="Status" context="{'group_by':'state'}"/>
                    <separator/>
                    <filter string="Date" name="groupdate" context="{'group_by': 'date'}"/>
                </group>
             </search>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="account_direct_payment_action">
        <field name="name">Direct Payments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.direct.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain"></field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="account_direct_payment_search" />
    </record>

    <menuitem action="account_direct_payment_action" id="menu_account_direct_payment" parent="account.menu_finance_payables" sequence="25"/>

</odoo>