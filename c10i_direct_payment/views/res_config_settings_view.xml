<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.account</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <div data-key="account" position="inside">
                    <h2>Direct Payment</h2>
                    <div class="row mt16 o_settings_container" name="default_direct_payment_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="direct_payment_temp_account">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Temporary Account Inbound/Outbound</span>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                                <div class="text-muted">
                                    Temporary Inbound/Outbound Account when creating a Direct Payment Entry
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="outbound_direct_payment_account_id" class="col-lg-3 o_light_label"/>
                                        <field name="outbound_direct_payment_account_id"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="inbound_direct_payment_account_id" class="col-lg-3 o_light_label"/>
                                        <field name="inbound_direct_payment_account_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>