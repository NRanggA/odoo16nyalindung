<odoo>
    <record id="equipment_form_view_inherit_view" model="ir.ui.view">
        <field name="name">equipment.register.form.view.inherit</field>
        <field name="model">equipment.register</field>
        <field name="inherit_id" ref="c10i_equipment_register.equipment_register_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='equipment_assign_to']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="asset_coordinator"/>
            </xpath>
        </field>
    </record>
</odoo>