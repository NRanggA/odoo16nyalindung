<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lhm_transaction_form_inherit_nyalindung_import_lhm" model="ir.ui.view">
        <field name="name">nyalindung.import.lhm.view.form.inherit</field>
        <field name="model">lhm.transaction</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_lhm_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='skb']" position="after">
                <field name="is_import" />
                <field name="file" attrs="{'invisible': [('is_import', '!=', True)]}"/>
                <button name="import_data" class="oe_highlight" string="Import" type="object" attrs="{'invisible': [('is_import', '!=', True)]}"/>
            </xpath>
        </field>
    </record>

</odoo>
