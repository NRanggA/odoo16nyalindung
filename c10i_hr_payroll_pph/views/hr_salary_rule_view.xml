<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_grade_form" model="ir.ui.view">
        <field name="name">hr.payroll.structure.view.form</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="c10i_hr_payroll.view_hr_employee_grade_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rule_ids']/tree/field[@name='category_id']" position="after">
                <field name="pph_mark_type"/>
            </xpath>
        </field>
    </record>


    <record id="hr_salary_rule_view_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.view.form</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="c10i_hr_payroll.hr_salary_rule_form" />
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="pph_mark_type"/>
            </field>
        </field>
    </record>

    <record id="hr_salary_rule_tree" model="ir.ui.view">
        <field name="name">hr.salary.rule.tree</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="c10i_hr_payroll.hr_salary_rule_tree" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="pph_mark_type"/>
            </field>
        </field>
    </record>
</odoo>
