<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ny_view_hr_payslip_form" model="ir.ui.view">
        <field name="name">ny.hr.payslip.form.view.form</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="c10i_hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <button name="compute_sheet" position="after">
                <button string="Test Cost Mapping" name="action_map_cost" type="object" groups="base.group_no_one"/>
            </button>
            <xpath expr="//notebook/page[last()]" position="inside">
            <!-- attrs="{'invisible': [('cost_map_ids','=',[])]}" -->
                <field name="cost_map_ids"  groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>

</odoo>
