<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="30"/>
        <field name="inherit_id" ref="c10i_hr_payroll.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- <xpath expr="//div[hasclass('app_settings_block')]" position="inside"> -->
            <xpath expr="//div[@name='payroll_general_setting_container']" position="after">
                <h2>Accounting</h2>
                <div class="row mt16 o_settings_container" name="payroll_accounting_setting_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="payroll_accounting">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Tempopary Bill Account</span>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                            <div class="text-muted">
                                Temporary Bill Account when creating a Bill of Batch Payroll 
                            </div>
                            <!-- <div class="content-group"> -->
                                <div class="row mt16">
                                    <label for="payroll_bill_account_id" class="col-lg-3 o_light_label"/>
                                    <field name="payroll_bill_account_id"/>
                                </div>
                            <!-- </div> -->
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
