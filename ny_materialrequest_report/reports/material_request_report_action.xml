<odoo>
    <!-- Paper Format Legal -->
    <record id="paperformat_material_request_legal" model="report.paperformat">
        <field name="name">Material Request Paper Format Legal</field>
        <field name="default" eval="False"/>
        <field name="format">Legal</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <!-- Action Report untuk Material Request -->
    <record id="action_report_material_request" model="ir.actions.report">
        <field name="name">Material Request Report</field>
        <field name="model">material.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ny_materialrequest_report.material_request_report_template</field>
        <field name="report_file">ny_materialrequest_report.material_request_report_template</field>
        <field name="print_report_name">"Material Request - %s" % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_material_request_legal"/>
    </record>
</odoo>
