<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payroll_report_wizard_view_form" model="ir.ui.view">
        <field name="name">payroll.report.wizard.view.form</field>
        <field name="model">payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="type"  required="1" />
                        <field name="payslip_ids" invisible="1" widget="many2many_tags"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Generate" name="print_report" type="object" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="payroll_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Report Payroll</field>
        <field name="res_model">payroll.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
