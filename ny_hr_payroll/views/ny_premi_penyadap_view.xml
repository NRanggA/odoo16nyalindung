<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ny_premi_penyadap_view_form" model="ir.ui.view">
        <field name="name">ny.premi.penyadap.view.form</field>
        <field name="model">ny.premi.penyadap</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Compute" name="action_compute" type="object" states="draft"/>
                    <button string="Confirm" name="action_confirm" type="object" class="oe_highlight" states="draft"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_block" type="object" class="oe_stat_button" icon="fa-search" string="Blok Tanam"/>
                        <button name="action_view_foreman" type="object" class="oe_stat_button" icon="fa-users" string="Kemandoran"/>
                    </div>
                    <group>
                        <group>
                            <label for="date_from" string="Period"/>
                            <div>
                                <field name="date_from" class="oe_inline" attrs="{'readonly': [('state','!=','draft')]}"/>
                                -
                                <field name="date_to" class="oe_inline" attrs="{'readonly': [('state','!=','draft')]}"/>
                            </div>
                        </group>
                        <group>
                            <field name="other_input_type_id" options="{'no_create':True, 'no_edit': True, 'no_open': True}" attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="batch_other_input_id" invisible="0" groups="base.group_no_one" readonly="1"/>
                            <field name="is_import" />
                            <field name="file" attrs="{'invisible': [('is_import', '!=', True)]}"/>
                            <button name="import_data" class="oe_highlight" string="Import" type="object" 
                                    attrs="{'invisible': [('is_import', '!=', True)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="employee" string="Karyawan">
                            <field name="line_ids" attrs="{'readonly': [('state','!=','draft')]}">
                                <tree editable="bottom">
                                    <field name="employee_id" options="{'no_create':True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="block_tanam_id" readonly="1" />
                                    <field name="base_hk" optional="hide"/>
                                    <field name="base_libur" optional="hide"/>
                                    <field name="base_total_days" optional="hide"/>
                                    <field name="act_hk" optional="hide"/>
                                    <field name="act_libur" optional="hide"/>
                                    <field name="act_total_days" optional="hide"/>
                                    <field name="karet_kering_qty" />
                                    <button name="action_view_lhm" type="object" icon="fa-search"/>
                                    <field name="target_qty" />
                                    <field name="lebih_target_qty" />
                                    <field name="grade_id" />
                                    <field name="rate" />
                                    <field name="premi_amount" />
                                    <field name="other_input_id" invisible="1" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page name="mandor" string="Mandor">
                            <group>
                                <group string="Rate Premi Produksi">
                                    <field name="base_premi_rate_assisten" />
                                    <field name="base_premi_rate_mandor" />
                                    <field name="base_premi_rate_kepala_mandor" />
                                    <field name="base_premi_rate_tap_kontrol" />
                                </group>
                                <group string="Rate Premi Lebih Produksi">
                                    <field name="surplus_premi_rate_assisten" />
                                    <field name="surplus_premi_rate_mandor" />
                                    <field name="surplus_premi_rate_kepala_mandor" />
                                    <field name="surplus_premi_rate_tap_kontrol" />
                                </group>
                            </group>

                            <field name="mandor_line_ids" attrs="{'readonly': [('state','!=','draft')]}">
                                <tree editable="bottom">
                                    <!-- <field name="kemandoran_id" readonly="1" /> -->
                                    <field name="position" readonly="1" />
                                    <field name="employee_id" options="{'no_create':True, 'no_edit': True, 'no_open': True}"/>
                                    <!-- <field name="block_tanam_id" readonly="1" /> -->
                                    <field name="total_karet_kering_qty" />
                                    <button name="action_view_lhm" type="object" icon="fa-search"/>
                                    <field name="target_qty" />
                                    <button name="action_view_foreman" type="object" icon="fa-search"/>
                                    <field name="karet_kering_qty" />
                                    <field name="lebih_target_qty" />
                                    <field name="base_rate" />
                                    <field name="premi_produksi_amount" />
                                    <field name="surplus_rate" />
                                    <field name="premi_lebih_target_amount" />
                                    <field name="premi_amount" />
                                    <field name="other_input_id" invisible="1" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="ny_premi_penyadap_view_tree" model="ir.ui.view">
        <field name="name">ny.premi.penyadap.view.tree</field>
        <field name="model">ny.premi.penyadap</field>
        <field name="arch" type="xml">
            <tree>
                <field name="other_input_type_id" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <!-- <record id="ny_premi_penyadap_view_search" model="ir.ui.view">
        <field name="name">ny.premi.penyadap.view.search</field>
        <field name="model">ny.premi.penyadap</field>
        <field name="arch" type="xml">
            <search>
            </search>
        </field>
    </record> -->

    <record id="ny_premi_penyadap_action" model="ir.actions.act_window">
        <field name="name">Premi Produksi</field>
        <field name="res_model">ny.premi.penyadap</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="ny_premi_penyadap_menu"
        action="ny_premi_penyadap_action"
        parent="c10i_hr_payroll_other_inputs.hr_payroll_other_input_misc_menu"
        sequence="10"/>
</odoo>
