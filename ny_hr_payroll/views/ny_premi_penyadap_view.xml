<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ny_premi_penyadap_view_form" model="ir.ui.view">
        <field name="name">ny.premi.penyadap.view.form</field>
        <field name="model">ny.premi.penyadap</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Compute" name="action_compute" type="object" states="draft"/>
                    <button string="Confirm" name="action_confirm" type="object" class="oe_highlight" states="draft"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <label for="date_from" string="Period"/>
                            <div>
                                <field name="date_from" class="oe_inline" attrs="{'readonly': [('state','!=','draft')]}"/>
                                -
                                <field name="date_to" class="oe_inline" attrs="{'readonly': [('state','!=','draft')]}"/>
                            </div>
                        </group>
                        <group>
                            <field name="other_input_type_id" options="{'no_create':True, 'no_edit': True, 'no_open': True}" attrs="{'readonly': [('state','!=','draft')]}"/>
                            <field name="batch_other_input_id" invisible="0" groups="base.group_no_one" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" attrs="{'readonly': [('state','!=','draft')]}">
                        <tree editable="bottom">
                            <field name="employee_id" options="{'no_create':True, 'no_edit': True, 'no_open': True}"/>
                            <field name="karet_kering_qty" />
                            <field name="target_qty" />
                            <field name="lebih_target_qty" />
                            <field name="grade_id" />
                            <field name="rate" />
                            <field name="premi_amount" />
                            <field name="other_input_id" invisible="1" readonly="1"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="ny_premi_penyadap_view_tree" model="ir.ui.view">
        <field name="name">ny.premi.penyadap.view.tree</field>
        <field name="model">ny.premi.penyadap</field>
        <field name="arch" type="xml">
            <tree>
                <field name="other_input_type_id" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <!-- <record id="ny_premi_penyadap_view_search" model="ir.ui.view">
        <field name="name">ny.premi.penyadap.view.search</field>
        <field name="model">ny.premi.penyadap</field>
        <field name="arch" type="xml">
            <search>
            </search>
        </field>
    </record> -->

    <record id="ny_premi_penyadap_action" model="ir.actions.act_window">
        <field name="name">Hitung Premi Penyadap</field>
        <field name="res_model">ny.premi.penyadap</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="ny_premi_penyadap_menu"
        action="ny_premi_penyadap_action"
        parent="c10i_hr_payroll_other_inputs.hr_payroll_other_input_misc_menu"
        sequence="10"/>
</odoo>
