<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_lhm_plant_block_tree" model="ir.ui.view">
        <field name="name">edit.lhm.plant.block.target</field>
        <field name="model">lhm.plant.block</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" edit="1" delete="0">
                <field name="name" readonly="1" />
                <field name="code" readonly="1" />
                <field name="varieties_id" readonly="1" options="{'no_open': True}" />
                <field name="production_daily_target" sum="production_daily_target" />
                <!-- <field name="production_daily_target_mandor" sum="production_daily_target_mandor" /> -->
            </tree>
        </field>
    </record>

    <record id="action_edit_production_target" model="ir.actions.act_window">
        <field name="name">Blok Tanam</field>
        <field name="res_model">lhm.plant.block</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_edit_production_target_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="act_window_id" ref="ny_hr_payroll.action_edit_production_target"/>
        <field name="view_id" ref="ny_hr_payroll.edit_lhm_plant_block_tree"/>
    </record>

    <record id="edit_lhm_plant_block_tree2" model="ir.ui.view">
        <field name="name">edit.lhm.plant.block.target2</field>
        <field name="model">lhm.plant.block</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" edit="1" delete="0">
                <field name="name" readonly="1" />
                <field name="code" readonly="1" />
                <field name="varieties_id" readonly="1" options="{'no_open': True}" />
                <field name="with_ongkos_pikul" />
            </tree>
        </field>
    </record>

    <record id="action_edit_block_with_ongkos_pikul" model="ir.actions.act_window">
        <field name="name">Blok Tanam</field>
        <field name="res_model">lhm.plant.block</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_edit_block_with_ongkos_pikul_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="act_window_id" ref="ny_hr_payroll.action_edit_block_with_ongkos_pikul"/>
        <field name="view_id" ref="ny_hr_payroll.edit_lhm_plant_block_tree2"/>
    </record>

    <record id="edit_lhm_plant_block_tree3" model="ir.ui.view">
        <field name="name">edit.lhm.plant.block.target</field>
        <field name="model">lhm.plant.block</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" edit="1" delete="0">
                <field name="name" readonly="1" />
                <field name="code" readonly="1" />
                <field name="varieties_id" readonly="1" options="{'no_open': True}" />
                <field name="payroll_gc_dest_activity_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
            </tree>
        </field>
    </record>

    <record id="action_edit_payroll_gc_distribution" model="ir.actions.act_window">
        <field name="name">Alokasi GC Payroll</field>
        <field name="res_model">lhm.plant.block</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_edit_payroll_gc_distribution_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="act_window_id" ref="ny_hr_payroll.action_edit_payroll_gc_distribution"/>
        <field name="view_id" ref="ny_hr_payroll.edit_lhm_plant_block_tree3"/>
    </record>
</odoo>
