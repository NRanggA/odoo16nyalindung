<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_employee_contract_report_tree" model="ir.ui.view">
        <field name="name">employee.contract.report.tree</field>
        <field name="model">employee.contract.report</field>
        <field name="arch" type="xml">
            <tree string="Live Report Gaji">
                <!-- <field name="employee_id"/> -->
                <field name="tanggal"/>
                <field name="identification_id"/>
                <field name="kemandoran_name"/>
                <field name="contract_id"/>
                <!-- <field name="employee_type_id"/> -->
                <!-- <field name="wage_type_id"/> -->
                <field name="wage_type_name"/>
                <field name="wage"/>
                <field name="wage_day"/>
                <field name="is_lhm"/>
                <field name="total_work_day"/>
                <field name="total_contract_wage_value"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_employee_contract_report" model="ir.actions.act_window">
        <field name="name">Live Report Gaji</field>
        <field name="res_model">employee.contract.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_employee_contract_report_tree"/>
        <field name="context"></field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_employee_contract_report"
        action="action_employee_contract_report"
        parent="c10i_hr_payroll_other_inputs.hr_payroll_other_input_misc_menu"
        sequence="99"
        groups="base.group_no_one"/>

</odoo>