<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="closing_production_fg_view_form" model="ir.ui.view">
        <field name="name">closing.production.finishgood.view.form</field>
        <field name="model">closing.production.finishgood</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" />
                            <field name="prev_closing_fg_id" />
                        </group>
                        <group>
                            <field name="inventory_account_id" />
                            <field name="cogs_account_id" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="opening_qty" />
                        </group>
                        <group>
                            <field name="opening_value" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="incoming_qty" />
                        </group>
                        <group>
                            <field name="manufacturing_cost" />
                            <field name="plantation_cost" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="onhand_qty" />
                        </group>
                        <group>
                            <field name="onhand_value" />
                            <field name="new_cost_price" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="outgoing_qty" />
                        </group>
                        <group>
                            <field name="outgoing_value" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="closing_qty" />
                        </group>
                        <group>
                            <field name="closing_value" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="closing_production_fg_view_tree" model="ir.ui.view">
        <field name="name">closing.production.finishgood.view.tree</field>
        <field name="model">closing.production.finishgood</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id" />
                <field name="opening_qty" />
                <field name="opening_value" optional="hide" />
                <field name="incoming_qty" />
                <field name="manufacturing_cost" optional="hide" />
                <field name="plantation_cost" optional="hide" />
                <field name="onhand_qty" optional="hide" />
                <field name="outgoing_qty" />
                <field name="outgoing_value" optional="show"/>
                <field name="closing_qty" />
                <field name="closing_value" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="closing_production_view_form" model="ir.ui.view">
        <field name="name">closing.production.view.form</field>
        <field name="model">closing.production</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Back to Previous Stage" name="button_back" type="object" states="fg1_valuation,fg2_valuation,account_entry"/>
                    <button string="Start" name="button_start" type="object" class="oe_highlight" icon="fa-play" states="start"/>
                    <button string="Get Transaction and Cost" name="compute_initial_and_cost_rm" type="object" states="rm_valuation"/>
                    <button string="Confirm Valuation and Continue" name="button_continue_to_fg1" type="object" class="oe_highlight" states="rm_valuation"/>
                    <button string="Get Transaction and Cost" name="compute_initial_and_cost_fg1" type="object" states="fg1_valuation"/>
                    <button string="Confirm Valuation and Continue" name="button_continue_to_fg2" type="object" class="oe_highlight" states="fg1_valuation"/>
                    <button string="Get Transaction and Cost" name="compute_initial_and_cost_fg2" type="object" states="fg2_valuation"/>
                    <button string="Confirm Valuation and Continue" name="button_continue_to_account_entry" type="object" class="oe_highlight" states="fg2_valuation"/>
                    
                    <button string="Test Create Journal" name="create_move_entries" type="object" states="account_entry"/>
                    <button string="Finish Process" name="action_done" type="object" class="oe_highlight" states="account_entry"/>
                    
                    <button string="Cancel" name="button_cancel" type="object" class="btn-danger" states="start,rm_valuation,fg1_valuation,fg2_valuation,account_entry"/>
                    <button string="Back to Start" name="button_set_new" type="object" states="cancel"/>

                    <field name="state" widget="statusbar" statusbar_visible="start,rm_valuation,fg1_valuation,fg2_valuation,account_entry,done" />
                </header>
                <sheet>
                    <group>
                        <field name="date_from" attrs="{'readonly': [('state','!=','draft')]}" />
                        <field name="date_to" attrs="{'readonly': [('state','!=','draft')]}" />
                        <field name="prev_closing_id" groups="base.group_no_one" readonly="1" />
                    </group>
                    <group name="acc_config" string="Account Configuration" attrs="{'invisible': [('state','!=','account_entry')]}">
                        <group string="Account for Latex">
                            <field name="latex_inventory_account_id" string="Account Inventory Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/>
                            <field name="latex_wip_account_id" string="Account WIP Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/>
                            <field name="latex_consumption_account_id" string="Account Consumption" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/>
                        </group>
                        <group string="Account for Lump">
                            <field name="lump_inventory_account_id" string="Account Inventory Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/>
                            <field name="lump_wip_account_id" string="Account WIP Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/>
                            <field name="lump_consumption_account_id" string="Account Consumption" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/>
                        </group>
                        <group string="Account for Sheet">
                            <field name="sheet_inventory_account_id" string="Account Inventory Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/>
                            <field name="sheet_wip_account_id" string="Account WIP Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/>
                            <field name="sheet_consumption_account_id" string="Account Consumption" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="rm_valuation" string="Raw Material Valuation" 
                                    attrs="{'invisible': [('state','not in',['rm_valuation','fg1_valuation','fg2_valuation','account_entry','done'])]}">
                            <group>
                                <field name="latex_opening_qty_manual" invisible="1"/>
                                <field name="latex_opening_value_manual" invisible="1"/>
                                <field name="lump_opening_qty_manual" invisible="1"/>
                                <field name="lump_opening_value_manual" invisible="1"/>
                            </group>
                            <table class="w-100 table table-sm table-bordered table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th rowspan="2" class="text-center"></th>
                                        <th colspan="4" class="text-center">Latex</th>
                                        <th colspan="4" class="text-center">Lump</th>
                                    </tr>
                                    <tr>
                                        <th colspan="2" class="text-center">Quantity</th>
                                        <th colspan="2" class="text-center">Value</th>
                                        <th colspan="2" class="text-center">Quantity</th>
                                        <th colspan="2" class="text-center">Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="table-secondary">Opening</td>
                                        <td style="text-align: right;"><field name="latex_opening_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_opening_value" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_opening_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_opening_value" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td class="table-secondary">Receiving</td>
                                        <td style="text-align: right;"><field name="latex_incoming_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_incoming_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td rowspan="2">Plantation Cost</td>
                                        <td colspan="8" class="text-center"><field name="plantation_cost" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                    </tr>
                                    <tr>
                                        <td>% Cost for Latex</td>
                                        <td><field name="pct_cost_for_latex" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="text-align: right;"><field name="latex_plantation_cost" /></td>
                                        <td></td>
                                        <td>% Cost for Lump</td>
                                        <td><field name="pct_cost_for_lump" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="text-align: right;"><field name="lump_plantation_cost" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Onhand</td>
                                        <td style="text-align: right;"><field name="latex_onhand_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_onhand_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_onhand_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_onhand_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>New Cost Price</td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_new_cost_price" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_new_cost_price" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>WIP</td>
                                        <td style="text-align: right;"><field name="latex_wip_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_wip_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Consumed</td>
                                        <td style="text-align: right;"><field name="latex_outgoing_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_outgoing_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_outgoing_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_outgoing_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Closing</td>
                                        <td style="text-align: right;"><field name="latex_closing_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_closing_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_closing_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_closing_value" /></td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </page>
                        <page name="fg1_valuation" string="Semi-Finish Good"
                                attrs="{'invisible': [('state','not in',['fg1_valuation','fg2_valuation','account_entry','done'])]}">
                            <group>
                                <field name="sheet_opening_qty_manual" invisible="1"/>
                                <field name="sheet_opening_value_manual" invisible="1"/>
                                <field name="compound_opening_qty_manual" invisible="1"/>
                                <field name="compound_opening_value_manual" invisible="1"/>
                            </group>
                            <table class="w-100 table table-sm table-bordered table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th rowspan="2" class="text-center"></th>
                                        <th colspan="4" class="text-center">Sheet</th>
                                        <th colspan="4" class="text-center">Compound</th>
                                    </tr>
                                    <tr>
                                        <th colspan="2" class="text-center">Quantity</th>
                                        <th colspan="2" class="text-center">Value</th>
                                        <th colspan="2" class="text-center">Quantity</th>
                                        <th colspan="2" class="text-center">Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="table-secondary">Opening</td>
                                        <td style="text-align: right;"><field name="sheet_opening_qty" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="sheet_opening_value" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_opening_qty" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_opening_value" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td class="table-secondary">Produced</td>
                                        <td style="text-align: right;"><field name="sheet_incoming_qty" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_incoming_qty" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td rowspan="2">Manufacturing Cost</td>
                                        <td colspan="8" class="text-center"><field name="manufacturing_cost" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                    </tr>
                                    <tr>
                                        <td>% Cost for Sheet</td>
                                        <td><field name="pct_cost_for_sheet" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td style="text-align: right;"><field name="sheet_manufacturing_cost" /></td>
                                        <td></td>
                                        <td>% Cost for Compound</td>
                                        <td><field name="pct_cost_for_compound" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td style="text-align: right;"><field name="compound_manufacturing_cost" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Onhand</td>
                                        <td style="text-align: right;"><field name="sheet_onhand_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="sheet_onhand_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_onhand_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_onhand_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>New Cost Price</td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="sheet_new_cost_price" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_new_cost_price" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>WIP</td>
                                        <td style="text-align: right;"><field name="sheet_wip_qty" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="sheet_wip_value" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Consumed</td>
                                        <td style="text-align: right;"><field name="sheet_outgoing_qty" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="sheet_outgoing_value" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Sales</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_outgoing_qty" 
                                            attrs="{'readonly': [('state','!=','fg1_valuation')]}" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_outgoing_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Closing</td>
                                        <td style="text-align: right;"><field name="sheet_closing_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="sheet_closing_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_closing_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_closing_value" /></td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </page>
                        <page name="fg2_valuation" string="Finish Good Valuation"
                                attrs="{'invisible': [('state','not in',['fg2_valuation','account_entry','done'])]}">
                            <field name="fg2_valuation_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="closing_production_view_tree" model="ir.ui.view">
        <field name="name">closing.production.view.tree</field>
        <field name="model">closing.production</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" widget="badge"
                    decoration-info="state=='start'"
                    decoration-danger="state in ('rm_valuation','fg1_valuation','fg2_valuation')"
                    decoration-success="state=='done'"
                    />
            </tree>
        </field>
    </record>

    <record id="closing_production_view_search" model="ir.ui.view">
        <field name="name">closing.production.view.search</field>
        <field name="model">closing.production</field>
        <field name="arch" type="xml">
            <search>
                <field name="date_from" />
            </search>
        </field>
    </record>

    <record id="closing_production_action" model="ir.actions.act_window">
        <field name="name">Closing Production</field>
        <field name="res_model">closing.production</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
