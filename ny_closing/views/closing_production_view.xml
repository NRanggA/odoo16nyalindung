<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="closing_production_fg_view_form" model="ir.ui.view">
        <field name="name">closing.production.finishgood.view.form</field>
        <field name="model">closing.production.finishgood</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" />
                            <field name="prev_closing_fg_id" />
                            <field name="closing_move_id" groups="base.group_no_one" readonly="1" />
                        </group>
                        <group>
                            <field name="inventory_account_id" />
                            <field name="cogs_account_id" />
                        </group>
                    </group>
                    <table class="table table-sm table-bordered table-hover" style="width: 80%">
                        <thead class="thead-light">
                            <tr>
                                <th rowspan="2" class="text-center" style="width: 30%;"></th>
                                <th colspan="2" class="text-center" style="font-weight: bold;width: 35%;">Quantity</th>
                                <th colspan="2" class="text-center" style="font-weight: bold;width: 35%;">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="font-weight: bold;">Beginning</td>
                                <td style="width: 30%; text-align: right;"><field name="opening_qty"/></td>
                                <td style="width: 5%;"></td>
                                <td style="width: 30%; text-align: right;"><field name="opening_value"/></td>
                                <td style="width: 5%;"></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold;">Incoming</td>
                                <td style="text-align: right;"><field name="incoming_qty"/></td>
                                <td></td>
                                <td style="text-align: right;"><field name="manufacturing_cost" /></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold;">Onhand Qty</td>
                                <td style="text-align: right;"><field name="onhand_qty"/></td>
                                <td></td>
                                <td style="text-align: right;"><field name="onhand_value"/></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td style="padding-left: 20px;">New Cost Price</td>
                                <td style="text-align: right;"></td>
                                <td></td>
                                <td style="text-align: right;"><field name="new_cost_price"/></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold;">Outgoing</td>
                                <td style="text-align: right;"><field name="outgoing_qty"/></td>
                                <td></td>
                                <td style="text-align: right;"><field name="outgoing_value"/></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold;">Ending</td>
                                <td style="text-align: right;"><field name="closing_qty"/></td>
                                <td></td>
                                <td style="text-align: right;"><field name="closing_value"/></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>

                    <label for="plantation_cost_ids" groups="base.group_no_one"/>
                    <field name="plantation_cost_ids" groups="base.group_no_one">
                        <tree>
                            <field name="plantation_location_type_id" />
                            <field name="plantation_location_id" />
                            <field name="plantation_activity_id" />
                            <field name="plantation_src_journal_id" />
                            <field name="account_id" />
                            <field name="total_cost_latex" />
                            <field name="total_cost_lump" />
                            <field name="total_cost" optional="hide" />
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="closing_production_fg_view_tree" model="ir.ui.view">
        <field name="name">closing.production.finishgood.view.tree</field>
        <field name="model">closing.production.finishgood</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id" />
                <field name="opening_qty" />
                <field name="opening_value" optional="hide" />
                <field name="incoming_qty" />
                <field name="manufacturing_cost" optional="hide" />
                <field name="plantation_cost" optional="hide" />
                <field name="onhand_qty" optional="hide" />
                <field name="outgoing_qty" />
                <field name="outgoing_value" optional="show"/>
                <field name="closing_qty" />
                <field name="closing_value" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="closing_production_view_form" model="ir.ui.view">
        <field name="name">closing.production.view.form</field>
        <field name="model">closing.production</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Back to Previous Stage" name="button_back" type="object" states="fg_valuation,account_entry"/>
                    <button string="Start" name="button_start" type="object" class="oe_highlight" icon="fa-play" states="start"/>
                    <!-- <button string="Get Transaction and Cost" name="compute_initial_and_cost_rm" type="object" states="rm_valuation"/> -->
                    <button string="Get Transaction and Cost" name="compute_initial_and_cost_rm_karet" type="object" attrs="{'invisible': ['|',('state','!=','rm_valuation'),('varieties_type','!=','karet')]}"/>
                    <button string="Get Transaction and Cost" name="compute_initial_and_cost_rm_pisang" type="object" attrs="{'invisible': ['|',('state','!=','rm_valuation'),('varieties_type','!=','pisang')]}"/>
                    <button string="Confirm Valuation and Continue" name="button_continue_to_fg" type="object" class="oe_highlight" states="rm_valuation"/>
                    <!-- <button string="Get Transaction and Cost" name="compute_initial_and_cost_fg1" type="object" states="fg1_valuation"/> -->
                    <!-- <button string="Confirm Valuation and Continue" name="button_continue_to_fg2" type="object" class="oe_highlight" states="fg1_valuation"/> -->
                    <!-- <button string="Get Transaction and Cost" name="compute_initial_and_cost_fg2" type="object" states="fg2_valuation"/> -->
                    <button string="Confirm Valuation and Continue" name="button_continue_to_account_entry" type="object" class="oe_highlight" states="fg_valuation"/>
                    
                    <button string="Test Create Journal" name="create_move_entries" type="object" states="account_entry"/>
                    <button string="Finish Process" name="action_done" type="object" class="oe_highlight" states="account_entry"/>
                    
                    <button string="Cancel" name="button_cancel" type="object" class="btn-danger" states="start,rm_valuation,fg_valuation,account_entry"/>
                    <button string="Back to Start" name="button_set_new" type="object" states="cancel"/>

                    <field name="state" widget="statusbar" statusbar_visible="start,rm_valuation,fg_valuation,account_entry,done" />
                </header>
                <sheet>
                    <group>
                        <field name="date_from" attrs="{'readonly': [('state','!=','start')]}" />
                        <field name="varieties_type" invisible="1"/>
                        <field name="date_to" attrs="{'readonly': [('state','!=','start')]}" />
                        <field name="prev_closing_id" groups="base.group_no_one" readonly="1" />
                        <field name="closing_move_ids" groups="base.group_no_one" readonly="1" />
                    </group>
                    <group name="acc_config" string="Account Configuration" attrs="{'invisible': [('state','!=','account_entry')]}">
                        <group string="Account for Latex" attrs="{'invisible': [('varieties_type','!=','karet')]}">
                            <field name="latex_inventory_account_id" string="Account Inventory Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('varieties_type','=','karet'),('state','=','account_entry')]}"/>
                            <field name="latex_wip_account_id" string="Account WIP Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('varieties_type','=','karet'),('state','=','account_entry')]}"/>
                            <!-- <field name="latex_consumption_account_id" string="Account Consumption" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/> -->
                        </group>
                        <group string="Account for Lump" attrs="{'invisible': [('varieties_type','!=','karet')]}">
                            <field name="lump_inventory_account_id" string="Account Inventory Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('varieties_type','=','karet'),('state','=','account_entry')]}"/>
                            <field name="lump_wip_account_id" string="Account WIP Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('varieties_type','=','karet'),('state','=','account_entry')]}"/>
                            <!-- <field name="lump_consumption_account_id" string="Account Consumption" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/> -->
                        </group>
                        <group string="Account for Sheet" attrs="{'invisible': [('varieties_type','!=','karet')]}">
                            <!-- <field name="sheet_inventory_account_id" string="Account Inventory Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/> -->
                            <field name="sheet_wip_account_id" string="Account WIP Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('varieties_type','=','karet'),('state','=','account_entry')]}"/>
                            <!-- <field name="sheet_consumption_account_id" string="Account Consumption" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/> -->
                        </group>
                        <group string="Account for Compo" attrs="{'invisible': [('varieties_type','!=','karet')]}">
                            <!-- <field name="sheet_inventory_account_id" string="Account Inventory Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/> -->
                            <field name="compound_wip_account_id" string="Account WIP Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('varieties_type','=','karet'),('state','=','account_entry')]}"/>
                            <!-- <field name="sheet_consumption_account_id" string="Account Consumption" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('state','=','account_entry')]}"/> -->
                        </group>
                        <group string="Account for Pisang" attrs="{'invisible': [('varieties_type','!=','pisang')]}">
                            <field name="pisang_inventory_account_id" string="Account Inventory Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('varieties_type','=','pisang'),('state','=','account_entry')]}"/>
                            <field name="pisang_wip_account_id" string="Account WIP Valuation" options="{'no_create': True, 'no_edit': True, 'no_open': True}" attrs="{'required': [('varieties_type','=','pisang'),('state','=','account_entry')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="rm_valuation_karet" string="Production Computation" 
                                    attrs="{'invisible': ['|',('varieties_type','!=','karet'),('state','not in',['rm_valuation','fg_valuation','account_entry','done'])]}">
                            <group>
                                <field name="latex_opening_qty_manual" invisible="1"/>
                                <field name="latex_opening_value_manual" invisible="1"/>
                                <field name="lump_opening_qty_manual" invisible="1"/>
                                <field name="lump_opening_value_manual" invisible="1"/>
                            </group>
                            <table class="w-100 table table-sm table-bordered table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th rowspan="2" class="text-center" style="width: 20%;"></th>
                                        <th colspan="4" class="text-center" style="font-weight: bold;width: 40%;">Latex</th>
                                        <th colspan="4" class="text-center" style="font-weight: bold;width: 40%;">Lump</th>
                                    </tr>
                                    <tr>
                                        <th colspan="2" class="text-center" style="font-weight: bold;width: 15%;">Quantity</th>
                                        <th colspan="2" class="text-center" style="font-weight: bold;width: 25%;">Value</th>
                                        <th colspan="2" class="text-center" style="font-weight: bold;width: 15%;">Quantity</th>
                                        <th colspan="2" class="text-center" style="font-weight: bold;width: 25%;">Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="font-weight: bold;">Beginning</td>
                                        <td style="width: 10%; text-align: right;"><field name="latex_opening_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="width: 5%;"></td>
                                        <td style="width: 20%; text-align: right;"><field name="latex_opening_value" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="width: 5%;"></td>
                                        <td style="width: 10%; text-align: right;"><field name="lump_opening_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="width: 5%;"></td>
                                        <td style="width: 20%; text-align: right;"><field name="lump_opening_value" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="width: 5%;"></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">Incoming</td>
                                        <td style="text-align: right;"><field name="latex_incoming_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_incoming_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td rowspan="2" style="font-weight: bold;">Plantation Cost</td>
                                        <td colspan="8" class="text-center"><field name="plantation_cost" /></td>
                                    </tr>
                                    <tr>
                                        <td>% Cost for Latex</td>
                                        <td><field name="pct_cost_for_latex" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="text-align: right;"><field name="latex_plantation_cost" /></td>
                                        <td></td>
                                        <td>% Cost for Lump</td>
                                        <td><field name="pct_cost_for_lump" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="text-align: right;"><field name="lump_plantation_cost" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">Onhand</td>
                                        <td style="text-align: right;"><field name="latex_onhand_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_onhand_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_onhand_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_onhand_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">New Cost Price</td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_new_cost_price" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_new_cost_price" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">Work in Process</td>
                                        <td colspan="4" style="font-weight: bold; text-align: center;">Sheet</td>
                                        <td colspan="4" style="font-weight: bold; text-align: center;">Compo</td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">Beginning WIP</td>
                                        <td style="text-align: right;"><field name="latex_wip_opening_qty" attrs="{'readonly': [('state','!=','rm_valuation')]}"/></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_wip_opening_value" attrs="{'readonly': [('state','!=','rm_valuation')]}"/></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_opening_qty" attrs="{'readonly': [('state','!=','rm_valuation')]}"/></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_opening_value" attrs="{'readonly': [('state','!=','rm_valuation')]}"/></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">New MO</td>
                                        <td style="text-align: right;"><field name="latex_wip_incoming_qty" attrs="{'readonly': [('state','!=','rm_valuation')]}"/></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_wip_incoming_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_incoming_qty" attrs="{'readonly': [('state','!=','rm_valuation')]}"/></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_incoming_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;" rowspan="2">Manufacturing Cost
                                            <button name="action_compute_mrp_cost" type="object" icon="fa-refresh" states="rm_valuation"/>
                                            <br/>
                                            <field name="manufacturing_cost_account_ids" widget="many2many_tags" />
                                        </td>
                                        <td colspan="8" class="text-center">
                                            <field name="manufacturing_cost" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>% Cost for Sheet</td>
                                        <td><field name="pct_cost_for_sheet" attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="text-align: right;"><field name="sheet_manufacturing_cost" /></td>
                                        <td></td>
                                        <td>% Cost for Compo</td>
                                        <td><field name="pct_cost_for_compound" attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="text-align: right;"><field name="compound_manufacturing_cost" /></td>
                                        <td></td>
                                    </tr>
                                    <!-- <tr>
                                        <td>Other Raw Material</td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="sheet_raw_material_cost" readonly="0" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr> -->
                                    <!-- <tr>
                                        <td>Total Cost of Sheet</td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="sheet_production_cost" /></td>
                                        <td></td>
                                        <td>Total Cost of Compo</td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="compound_production_cost" /></td>
                                        <td></td>
                                    </tr> -->
                                    <tr>
                                        <td style="padding-left: 20px;">Total WIP</td>
                                        <td style="text-align: right;"><field name="latex_wip_onhand_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_wip_onhand_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_onhand_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_onhand_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 40px;">WIP Cost Price</td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_wip_cost_price" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_cost_price" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;" rowspan="2">Finished MO</td>
                                        <td style="text-align: right;"><field name="latex_wip_outgoing_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_wip_outgoing_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_outgoing_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_outgoing_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Raw Material Cost</td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="sheet_raw_material_cost" readonly="0" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">Ending WIP</td>
                                        <td style="text-align: right;"><field name="latex_wip_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_wip_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_wip_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">Ending</td>
                                        <td style="text-align: right;"><field name="latex_closing_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="latex_closing_value" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_closing_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="lump_closing_value" /></td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>

                            <label for="plantation_cost_ids" groups="base.group_no_one"/>
                            <field name="plantation_cost_ids" nolabel="1" readonly="1" groups="base.group_no_one">
                                <tree>
                                    <field name="plantation_location_type_id" />
                                    <field name="plantation_location_id" />
                                    <field name="plantation_activity_id" />
                                    <field name="plantation_src_journal_id" />
                                    <field name="account_id" />
                                    <field name="total_cost_latex" sum="total_cost_latex" />
                                    <field name="total_cost_lump" sum="total_cost_lump" />
                                    <field name="total_cost" sum="total_cost" optional="hide" />
                                </tree>
                            </field>
                            <label for="mrp_cost_ids" groups="base.group_no_one"/>
                            <field name="mrp_cost_ids" nolabel="1" readonly="1" groups="base.group_no_one">
                                <tree>
                                    <field name="plantation_location_type_id" />
                                    <field name="plantation_location_id" />
                                    <field name="plantation_activity_id" />
                                    <field name="plantation_src_journal_id" />
                                    <field name="account_id" />
                                    <field name="total_cost_latex" sum="total_cost_latex" />
                                    <field name="total_cost_lump" sum="total_cost_lump" />
                                    <field name="total_cost" sum="total_cost" optional="hide" />
                                </tree>
                            </field>
                        </page>
                        <page name="rm_valuation_pisang" string="Production Computation" 
                                    attrs="{'invisible': ['|',('varieties_type','!=','pisang'),('state','not in',['rm_valuation','fg_valuation','account_entry','done'])]}">
                            <group>
                                <field name="pisang_opening_qty_manual" invisible="1"/>
                                <field name="pisang_opening_value_manual" invisible="1"/>
                            </group>
                            <table class="w-100 table table-sm table-bordered table-hover" style="width: 70%;">
                                <thead class="thead-light">
                                    <tr>
                                        <th rowspan="2" class="text-center" style="width: 20%;"></th>
                                        <th colspan="4" class="text-center" style="font-weight: bold;width: 40%;">Pisang</th>
                                    </tr>
                                    <tr>
                                        <th colspan="2" class="text-center" style="font-weight: bold;width: 15%;">Quantity</th>
                                        <th colspan="2" class="text-center" style="font-weight: bold;width: 25%;">Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="font-weight: bold;">Beginning</td>
                                        <td style="width: 10%; text-align: right;"><field name="pisang_opening_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="width: 5%;"></td>
                                        <td style="width: 20%; text-align: right;"><field name="pisang_opening_value" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td style="width: 5%;"></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">Incoming</td>
                                        <td style="text-align: right;"><field name="pisang_incoming_qty" 
                                            attrs="{'readonly': [('state','!=','rm_valuation')]}" /></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">Plantation Cost</td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="plantation_cost" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">Onhand</td>
                                        <td style="text-align: right;"><field name="pisang_onhand_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="pisang_onhand_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">New Cost Price</td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="pisang_new_cost_price" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">Work in Process</td>
                                        <td colspan="4" style="font-weight: bold; text-align: center;"></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">Beginning WIP</td>
                                        <td style="text-align: right;"><field name="pisang_wip_opening_qty" attrs="{'readonly': [('state','!=','rm_valuation')]}"/></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="pisang_wip_opening_value" attrs="{'readonly': [('state','!=','rm_valuation')]}"/></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">New MO</td>
                                        <td style="text-align: right;"><field name="pisang_wip_incoming_qty" attrs="{'readonly': [('state','!=','rm_valuation')]}"/></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="pisang_wip_incoming_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">Manufacturing Cost
                                            <button name="action_compute_mrp_cost" type="object" icon="fa-refresh" states="rm_valuation"/>
                                            <br/>
                                            <field name="manufacturing_cost_account_ids" widget="many2many_tags" />
                                        </td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="manufacturing_cost" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">Total WIP</td>
                                        <td style="text-align: right;"><field name="pisang_wip_onhand_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="pisang_wip_onhand_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 40px;">WIP Cost Price</td>
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="pisang_wip_cost_price" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">Finished MO</td>
                                        <td style="text-align: right;"><field name="pisang_wip_outgoing_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="pisang_wip_outgoing_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left: 20px;">Ending WIP</td>
                                        <td style="text-align: right;"><field name="pisang_wip_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="pisang_wip_value" /></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">Ending</td>
                                        <td style="text-align: right;"><field name="pisang_closing_qty" /></td>
                                        <td></td>
                                        <td style="text-align: right;"><field name="pisang_closing_value" /></td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>

                            <label for="plantation_cost_ids" groups="base.group_no_one"/>
                            <field name="plantation_cost_ids" nolabel="1" readonly="1" groups="base.group_no_one">
                                <tree>
                                    <field name="plantation_location_type_id" />
                                    <field name="plantation_location_id" />
                                    <field name="plantation_activity_id" />
                                    <field name="plantation_src_journal_id" />
                                    <field name="account_id" />
                                    <field name="total_cost_latex" sum="total_cost_latex" />
                                    <field name="total_cost_lump" sum="total_cost_lump" />
                                    <field name="total_cost" sum="total_cost" optional="hide" />
                                </tree>
                            </field>
                            <label for="mrp_cost_ids" groups="base.group_no_one"/>
                            <field name="mrp_cost_ids" nolabel="1" readonly="1" groups="base.group_no_one">
                                <tree>
                                    <field name="plantation_location_type_id" />
                                    <field name="plantation_location_id" />
                                    <field name="plantation_activity_id" />
                                    <field name="plantation_src_journal_id" />
                                    <field name="account_id" />
                                    <field name="total_cost_latex" sum="total_cost_latex" />
                                    <field name="total_cost_lump" sum="total_cost_lump" />
                                    <field name="total_cost" sum="total_cost" optional="hide" />
                                </tree>
                            </field>
                        </page>
                        <page name="fg_valuation" string="Finish Good Valuation"
                                attrs="{'invisible': [('state','not in',['fg_valuation','account_entry','done'])]}">
                            <field name="fg2_valuation_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="closing_production_view_tree" model="ir.ui.view">
        <field name="name">closing.production.view.tree</field>
        <field name="model">closing.production</field>
        <field name="arch" type="xml">
            <tree>
                <field name="varieties_type"/>
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" widget="badge"
                    decoration-info="state=='start'"
                    decoration-danger="state in ('rm_valuation','fg_valuation')"
                    decoration-success="state=='done'"
                    />
            </tree>
        </field>
    </record>

    <record id="closing_production_view_search" model="ir.ui.view">
        <field name="name">closing.production.view.search</field>
        <field name="model">closing.production</field>
        <field name="arch" type="xml">
            <search>
                <field name="date_from" />
            </search>
        </field>
    </record>

    <record id="closing_production_action" model="ir.actions.act_window">
        <field name="name">Closing Production</field>
        <field name="res_model">closing.production</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
