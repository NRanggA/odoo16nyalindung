<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lhm_activity_view_form_inhrt" model="ir.ui.view">
        <field name="name">lhm.activity.view.form.inhrt</field>
        <field name="model">lhm.activity</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_lhm_activity_form" />
        <field name="arch" type="xml">
            <group name="accounting" position="inside">
                <field name="cost_account_id" />
                <label for="cost_account_ids" />
                <field name="cost_account_ids" nolabel="1">
                    <tree editable="bottom">
                        <field name="src_journal_id" />
                        <field name="account_id" />
                    </tree>
                </field>
            </group>
        </field>
    </record>
</odoo>
