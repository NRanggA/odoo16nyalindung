<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lhm_project_inherit_form" model="ir.ui.view">
        <field name="name">lhm.project.inherit.form</field>
        <field name="model">lhm.project</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_lhm_project_form" />
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="project_tanaman" />
            </field>
            <field name="location_type_id" position="after">
                <field name="varieties_id" attrs="{'required': [('project_tanaman','=',True)], 'invisible': [('project_tanaman','=',False)]}"/>
                <field name="plant_block_id" readonly="1" attrs="{'invisible': [('project_tanaman','=',False)]}"/>
            </field>
            <!-- <field name="date_start" position="attributes">
                <attribute name="attrs">{'required': [('project_tanaman','=',True)]}</attribute>
            <field> -->
            <field name="date_start" position="after">
                <field name="harvest_date_schedule" attrs="{'required': [('project_tanaman','=',True)], 'invisible': [('project_tanaman','=',False)]}"/>
            </field>
            <!-- <field name="date_finished" position="attributes">
                <attribute name="attrs">{'required': [('project_tanaman','=',True)]}</attribute>
            <field> -->
        </field>
    </record>

</odoo>
