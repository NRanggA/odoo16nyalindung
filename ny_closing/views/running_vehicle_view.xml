<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="running_vehicle_view_form" model="ir.ui.view">
        <field name="name">running.vehicle.view.form</field>
        <field name="model">running.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Test Summarize" name="summarize_move_line" type="object" groups="base.group_no_one"/>
                    <button string="Test Create Journal Entry" name="create_account_move" type="object" groups="base.group_no_one"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="date_from" />
                            <field name="date_to" />
                        </group>
                        <group>
                            <field name="total_usage" readonly="1"/>
                            <label for="total_cost" />
                            <div>
                                <field name="total_cost" readonly="1" nolable="1"/>
                                <button string="View Journals" name="action_view_src_move_lines" type="object" class="btn-info" icon="fa-search"/>
                            </div>
                            <field name="closing_account_id"/>
                            <field name="running_move_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <tree decoration-danger="not dest_account_id">
                            <field name="plantation_location_type_id" />
                            <field name="plantation_location_id" />
                            <field name="plantation_activity_id" />
                            <field name="dest_account_id" />
                            <field name="usage" sum="usage"/>
                            <field name="distributed_cost" sum="distributed_cost"/>
                        </tree>
                        <form>
                            <group>
                                <field name="plantation_location_type_id" />
                                <field name="plantation_location_id" />
                                <field name="plantation_activity_id" />
                                <field name="dest_account_id" />
                                <field name="usage" sum="usage"/>
                                <field name="distributed_cost" sum="distributed_cost"/>
                            </group>
                            <field name="distribution_line_ids" >
                                <tree>
                                    <field name="plantation_src_journal_id" />
                                    <field name="distributed_cost" sum="distributed_cost" />
                                </tree>
                            </field>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="running_vehicle_view_tree" model="ir.ui.view">
        <field name="name">running.vehicle.view.tree</field>
        <field name="model">running.vehicle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="vehicle_id" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="total_usage" />
                <field name="total_cost" />
                <field name="running_move_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="running_vehicle_view_search" model="ir.ui.view">
        <field name="name">running.vehicle.view.search</field>
        <field name="model">running.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id" />
            </search>
        </field>
    </record>

    <record id="running_vehicle_action" model="ir.actions.act_window">
        <field name="name">Running Vehicle Detail</field>
        <field name="res_model">running.vehicle</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
