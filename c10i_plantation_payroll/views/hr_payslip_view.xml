<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.view.form</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="c10i_hr_payroll.view_hr_payslip_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="inside">
                <separator string="LHM" attrs="{'invisible': [('lhm_line_ids','=',[])]}"/>
                <field name="lhm_line_ids" attrs="{'invisible': [('lhm_line_ids','=',[])]}" readonly="1">
                    <tree>
                        <field name="date" />
                        <field name="attendance_id" />
                        <field name="work_day" />
                        <field name="overtime_hour" />
                        <field name="location_type_id" optional="hide"/>
                        <field name="location_id" optional="hide"/>
                        <field name="activity_id" optional="hide"/>
                        <field name="contract_wage_value" sum="contract_wage_value"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
