<?xml version="1.0"?>
<odoo>
    <data>
        <record id="wizard_form_view_replace" model="ir.ui.view">
        <field name="name">replace.button.wizard</field>
        <field name="model">replace.button</field>
        <field name="arch" type="xml">
            <form string="Replace Equipment">
                    <group>
                        <field name="category_id" invisible='1'/>
                        <field name="equipment_id" required="1" options="{'no_create_edit': True, 'no_open':True,'no_create':True}"/>
                    </group>
                    <separator string="Reason" colspan="6"/>
                    <field name="reason" colspan="4" nolabel="1" required="1"/>
                    <newline/>
                    <separator colspan="6"/>
                    <footer>
                        <button name="replace_equipment" string="Replace Now" type="object" class="oe_highlight"/>
                        <button special="cancel" class="oe_highlight" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>
            
          <record id="action_wizard_replace" model="ir.actions.act_window">
            <field name="name">Reason Wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">replace.button</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="wizard_form_view_replace"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
