<?xml version="1.0"?>
<odoo>
	<data>
		<record id="wizard_form_view_reason" model="ir.ui.view">
        <field name="name">button.cancel.wizard</field>
        <field name="model">button.cancel</field>
        <field name="arch" type="xml">
            <form string="Resaon">
                    <separator string="Reason" colspan="6"/>
                    <field name="reason" colspan="4" nolabel="1" placeholder="Please mention your reason why you are cancelling this request." required='1'/>
                    <newline/>
                    <separator colspan="6"/>
                    <footer>
                        <button name="do_cancel" string="Continue" type="object" class="oe_highlight"/>
                        <button special="cancel" class="oe_highlight" string="Close"/>
                    </footer>
                </form>
            </field>
        </record>
            
          <record id="action_wizard_reason" model="ir.actions.act_window">
          	<field name="name">Cancellation Reason Wizard</field>
        	<field name="type">ir.actions.act_window</field>
        	<field name="res_model">button.cancel</field>
        	<field name="view_mode">form</field>
        	<field name="view_id" ref="wizard_form_view_reason"/>
        	<field name="target">new</field>
        </record>
    </data>
</odoo>
