<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="allocation_request_form_view" model="ir.ui.view">
			<field name="name">Allocation Details</field>
			<field name="model">allocation.request</field>
			<field name="arch" type="xml">
				<form>
					<header>
						<button name="action_submit" string="Submit" class="oe_highlight" type="object" states="new"/>
						
						<button name="action_approve" string="Approve" class="oe_highlight" type="object" states="submitted" confirm="Are you sure you want to approve this request?"/>

						<button name="action_allocate" string="Allocate" class="oe_highlight" type="object" states="approved" confirm="Are you sure you want to allocate this request?"/>
						
						<button name="confirm_return" string="Return" class="oe_highlight" type="object" states="allocated" confirm="Are you sure you want to return this request?"/>

						<button name="set_to_new" string="Set to New" type="object" states="cancel,rejected" />

						<button name="%(c10i_equipment_allocation.action_reject_wizard_reason)d" type="action" string="Reject" states="submitted" confirm="Are you sure you want to reject this request?"/>

						<!-- <button name="%(action_wizard_replace)d" string="Replace" type="action" attrs="{'invisible':['|',('state','!=','allocated'),('allocation_type','=','on_demand')]}"/> -->

						<button string="Cancel" name="%(c10i_equipment_allocation.action_wizard_reason)d" type="action" states="new,submitted,approved"/>
						
						<field name="state" widget="statusbar" statusbar_visible="new,submitted,approved,allocated,returned"/>
					</header>
					<sheet>
						<div class="oe_title">
							<label for="name" class="oe_edit_only"/>
							<h1>
								<field name="name" string="Subject" placeholder="Request for laptop"/>
							</h1>
						</div>
						<group>
							<group string="Equipment Details" name="equipment_details">
								<field name="allocation_type" widget="radio" attrs="{'readonly':[('state','!=','new')]}"/>
								<field name="category_id" required='1' attrs="{'readonly':[('state','!=','new')]}" options="{'no_create': True}"/>
								<field name="equipment_id" required='1' domain="[('category_id','=',category_id), ('state','=','available')]" attrs="{'readonly':[('state','!=','new')]}" options="{'no_create': True}" />
								<field name="product" readonly='1'/>
								<field name="scheduled_date" required='1' attrs="{'readonly':[('state','!=','new')]}"/>
								<field name="return_date" readonly='1' attrs="{'invisible':[('state','!=','returned')]}"/>
								<field name="priority" widget="priority"/>
							</group>
							<group string="Person Information" name="employee_information">
								<field name="assigned_contact_type" required='1' attrs="{'readonly':[('state','!=','new')]}"/>
								<field name="assigned_id" attrs="{'readonly':[('state','!=','new')], 'required': [('assigned_contact_type','=','employee')], 'invisible': [('assigned_contact_type','!=','employee')]}"/>
								<field name="assigned_partner_id" attrs="{'readonly':[('state','!=','new')], 'required': [('assigned_contact_type','=','partner')], 'invisible': [('assigned_contact_type','!=','partner')]}"/>
								<field name="approved_by" readonly='1' attrs="{'invisible':[('state','=','new')]}"/>
								<field name="cancelled_by" readonly='1' attrs="{'invisible':[('state','!=','cancel')]}"/>
								<field name="return_to" readonly='1' attrs="{'invisible':[('state','!=','returned')]}"/>
								<field name="created_by" readonly='1'/>
								<field name="created_date" readonly='1'/>
							</group>
						</group>
						<field name="note" placeholder="Internal Note ......"/>
					</sheet>
					<div class="oe_chatter">
						<field name="message_follower_ids" widget="mail_followers"/>
						<field name="message_ids" widget="mail_thread"/>
					</div>
				</form>
			</field>
		</record>

		<record id="allocation_request_tree_view" model="ir.ui.view">
			<field name="name">Allocation Details</field>
			<field name="model">allocation.request</field>
			<field name="arch" type="xml">
				<tree decoration-danger="state == 'cancel'" decoration-success="state == 'returned'" decoration-info="state == 'new'" decoration-warning="state in ['allocated','approved']">
					<field name="name"/>
					<field name="equipment_id"/>
					<field name="scheduled_date" string="Request Date"/>
					<field name="assigned_contact_type" invisible="1"/>
					<field name="assigned_id" string="Allocated to" attrs="{'column_invisible': [('assigned_contact_type','!=','employee')]}"/>
					<field name="assigned_partner_id" string="Allocated to" attrs="{'column_invisible': [('assigned_contact_type','!=','partner')]}"/>
					<field name="approved_by" readonly='1' attrs="{'invisible':[('state','=','new')]}"/>
					<field name="category_id"/>
					<field name="allocation_type"/>
					<field name="state" string="Stage"/>
				</tree>
			</field>
		</record>

		<record model="ir.ui.view" id="allocation_request_search_view">
			<field name="name">Allocation Details</field>
			<field name="model">allocation.request</field>
			<field name="arch" type="xml">
				<search string="Search Invoice">
					<field name="name" string="Allocation" filter_domain="[('name', 'ilike', self)]"/>
					<field name="equipment_id" string="Equipment"/>
					<filter name="filter_today" string="Today"  domain="[('scheduled_date','&gt;=',current_date),('scheduled_date','&lt;=',current_date)]"/>
					<filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
					<filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
					<filter name="filter_allocated" string="Allocated" domain="[('state', '=', 'allocated')]"/>
					<filter name="filter_returned" string="Returned" domain="[('state', '=', 'returned')]"/>
					<filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
					<filter name="filter_top_priorities" string="Top Priorities" domain="[('priority', '=', '3')]"/>
					<separator/>
					<filter name="filter_my_requests" string="My Requests" domain="[('assigned_id', '=', uid)]"/>
					<separator/>
					<filter name="filter_unread_messages" string="Unread Message" domain="[('message_needaction','=',True)]"/>
					<separator/>
					<filter name="filter_on_demand" string="On-demand" domain="[('allocation_type','=','on_demand')]"/>
					<filter name="filter_permanent" string="Permanent" domain="[('allocation_type','=','permanent')]"/>
					<separator/>
				</search>
			</field>
		</record>

		<record id="allocation_request_kanban_view" model="ir.ui.view">
			<field name="name">allocation.request.kanban</field>
			<field name="model">allocation.request</field>
			<field name="arch" type="xml">
				<kanban default_group_by="state">
					<field name="state"/>
					<field name="priority"/>
					<field name="equipment_id"/>
					<field name="assigned_contact_type"/>
					<field name="assigned_id"/>
					<field name="assigned_partner_id"/>
					<field name="approved_by"/>
					<field name="category_id"/>
					<templates>
						<t t-name="kanban-tooltip">
							<ul class="oe_kanban_tooltip">
								<li>
									<b>Category:</b>
									<field name="category_id"/>
								</li>
								<li>
									<b>Assigned to:</b>
									<field name="assigned_id"/>
								</li>
								<li>
									<b>Allocated by:</b>
									<field name="approved_by"/>
								</li>
							</ul>
						</t>
						<t t-name="kanban-box">
						   <div>
								<div class="o_dropdown_kanban dropdown">
									<a role="button" class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
										<span class="fa fa-bars fa-lg"/>
									</a>
									<ul class="dropdown-menu" role="menu" aria-labelledby="dLabel">
										<t t-if="widget.deletable">
											<li>
												<a type="delete">Delete</a>
											</li>
										</t>
									</ul>
								</div>
								<div class="oe_kanban_content" tooltip="kanban-tooltip">
									<div>
										<b>
											<field name="name"/>
										</b>
										<br/>
										<span name="assigned_id" t-if="record.assigned_id">
											<b>Assigned to: </b>
											<field name="assigned_id"/>
										</span>
										<br/>
										<span class="oe_grey" t-if="record.equipment_id">
											<b>Equipment: </b>
											<field name="equipment_id"/>
											<br/>
										</span>
									</div>
									<div class="oe_kanban_footer_left" style="margin-top:2px;">
										<t t-if="record.message_needaction_counter">
											<span class="oe_kanban_mail_new" title="Unread Messages">
												<i class="fa fa-comments"/>
												<t t-raw="record.message_needaction_counter"/>
											</span>
										</t>
										<span t-if="record.category_id">
											<b>Category: </b>
											<field name="category_id"/>
										</span>
									</div>
									<div class="oe_kanban_bottom_right">
										<img t-att-src="kanban_image('res.users', 'image_small', record.assigned_id)" t-att-title="record.assigned_id.value" width="24" height="24" class="oe_kanban_avatar pull-right" t-att-alt="record.assigned_id.value"/>
										<div class="pull-left" groups="base.group_user">
											<field name="priority" widget="priority"/>
										</div>
									</div>
								</div>
								<div class="oe_clear"/>
							</div>
						</t>
					</templates>
				</kanban>
			</field>
		</record>

