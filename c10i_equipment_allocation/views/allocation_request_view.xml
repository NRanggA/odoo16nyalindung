		<record id="allocation_request_kanban" model="ir.actions.act_window">
			<field name="name">Allocation Requests</field>
			<field name="res_model">allocation.request</field>
			<field name="view_mode">kanban</field>
		</record>

		<record id="allocation_request_actions" model="ir.actions.act_window">
			<field name="name">Allocation Requests</field>
			<field name="res_model">allocation.request</field>
			<field name="view_mode">form</field>
			<field name="context">{'search_default_filter_today': 1,'search_default_filter_on_demand':2}</field>
			<field name="view_mode">tree,form,kanban,pivot</field>
		</record>

		<record id="allocation_request_calendar_view" model="ir.ui.view">
			<field name="name">allocation.request</field>
			<field name="model">allocation.request</field>
			<field name="arch" type="xml">
				<calendar string="Calendar View" date_start="scheduled_date">
					<field name="assigned_id"/>
				</calendar>
			</field>
		</record>

		<record id="allocation_request_actions_calendar" model="ir.actions.act_window">
			<field name="name">Allocation Requests</field>
			<field name="res_model">allocation.request</field>
			<field name="view_mode">form</field>
			<field name="view_mode">calendar,kanban,tree,form,pivot</field>
		</record>

		<menuitem
			id="menu_allocation"
			name="Allocation"
			parent="maintenance.menu_maintenance_title"/>

		<menuitem
			id="menu_m_allocation_requests"
			name="Allocation Requests"
			parent="menu_allocation"
			action="allocation_request_actions"/>

		<menuitem
			id="menu_m_allocation_calendar"
			name="Allocation Calendar"
			parent="menu_allocation"
			action="allocation_request_actions_calendar"/>

		<menuitem
			id="menu_product"
			name="Product"
			parent="maintenance.menu_maintenance_title"/>

		<menuitem
			id="menu_m_stockable_products"
			name="Stockable Products"
			parent="menu_product"
			action="product.product_template_action"/>

		<menuitem
			id="menu_m_product_categories"
			name="Products Categories"
			parent="menu_product"
			action="product.product_category_action_form"/>
	</data>
</odoo>