<odoo>
		<record id="view_orm_onscreen_tree" model="ir.ui.view">
			<field name="name">orm.onscreen.tree</field>
			<field name="model">orm.onscreen</field>
			<field name="arch" type="xml">
				<tree>
					<field name="name" />
				</tree>
			</field>
		</record>

		<record id="view_orm_onscreen_search" model="ir.ui.view">
			<field name="name">orm.onscreen.search</field>
			<field name="model">orm.onscreen</field>
			<field name="arch" type="xml">
				<search>
					<field name="name" string="Search" filter_domain="[('name','ilike', self)]"/>
				</search>
			</field>
		</record>
		
		<record id="view_orm_onscreen_form" model="ir.ui.view">
			<field name="name">orm.onscreen.form</field>
			<field name="model">orm.onscreen</field>
			<field name="arch" type="xml">
				<form>
					<header>
						<button name="execute_procedure" type="object" string="Execute"/>
					</header>
					<sheet>
					<h1>
						<field name="name" class="oe_inline"/>
					</h1>
					<notebook>
						<page string="Procedure to Execute" >
							<separator string="Exec"/>
							<field name="exec_text" widget="ace" options="{'mode': 'python'}" nolabel="1"/>
						</page>
						<page string="Result Text" >
							<field name="result" widget="ace" options="{'mode': 'python'}" nolabel="1"/>
						</page>
					</notebook>
					</sheet>
				</form>
			</field>
		</record>

		<record id="action_orm_onscreen" model="ir.actions.act_window">
			<field name="name">ORM Onscreen</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">orm.onscreen</field>
			<field name="view_mode">tree,form</field>
			<field name="search_view_id" ref="view_orm_onscreen_search"/>
		</record>
		<menuitem id="menu_orm_access" parent="base.menu_custom" sequence="12" name="ORM"/>
		<menuitem action="action_orm_onscreen" id="menu_orm_onscreen" parent="menu_orm_access" sequence="1" />
</odoo>
