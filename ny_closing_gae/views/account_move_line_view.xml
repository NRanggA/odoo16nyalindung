<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_account_move_line_set_gae_distribution" model="ir.actions.server">
        <field name="name">Set GAE Distribution</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
    action = records.action_set_gae_distribution()
        </field>
    </record>

    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="name">account.move.line.tree.inherit.set.gae</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="analytic_distribution" position="before">
                <field name="gae_distribution_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
