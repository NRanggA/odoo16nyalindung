<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_asset_form_inherit" model="ir.ui.view">
        <field name="name">Account Asset Form Inherit</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="om_account_asset.view_account_asset_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='analytic_distribution']" position="after">
                <field name="gae_dest_type" required="1"/>
                <field name="plantation_varieties_ids" widget="many2many_tags" attrs="{'invisible': [('gae_dest_type','=','indirect')], 'required': [('gae_dest_type','=','direct')]}"/>
                <field name="gae_direct_activity_id" attrs="{'invisible': [('gae_dest_type','=','indirect')], 
                            'required': [('gae_dest_type','=','direct')]}"/>
                <field name="gae_distribution_id" attrs="{'invisible': [('gae_dest_type','=','direct')], 
                            'required': [('gae_dest_type','=','indirect')]}"/>
                <field name="gae_expense_depre_account_id" attrs="{'invisible': [('gae_dest_type','=','direct')], 
                            'required': [('gae_dest_type','=','indirect')]}"/>
            </xpath>
        </field>
    </record>

</odoo>
