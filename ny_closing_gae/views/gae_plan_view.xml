<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gae_plan_view_form" model="ir.ui.view">
        <field name="name">gae.plan.view.form</field>
        <field name="model">gae.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page name="gae_plan_lines" string="GAE Plan Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="varieties_id" />
                                    <field name="distribution_percentage" sum="Total Distribution Percentage"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gae_plan_view_tree" model="ir.ui.view">
        <field name="name">gae.plan.view.tree</field>
        <field name="model">gae.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="gae_plan_view_search" model="ir.ui.view">
        <field name="name">gae.plan.view.search</field>
        <field name="model">gae.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Search"/>
            </search>
        </field>
    </record>

    <record id="gae_plan_action" model="ir.actions.act_window">
        <field name="name">GAE Plan</field>
        <field name="res_model">gae.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
