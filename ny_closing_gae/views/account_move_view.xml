<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="priority">25</field>
        <!-- <field name="inherit_id" ref="c10i_lhm_v16.view_move_form"/> -->
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree/field[@name='balance']" position="after">
                <field name="gae_distribution_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="before">
                <field name="gae_distribution_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
