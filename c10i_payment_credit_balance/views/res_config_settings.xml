<odoo>
    <record id="res_config_settings_view_form_inherit_credit_balance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.credit.balance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//group[@name='accounting']" position="inside">
                <field name="account_credit_balance_id" options="{'no_create': True}" context="{'default_user_type_id': ref('account.data_account_type_current_liabilities')}"/>
            </xpath> -->
            <xpath expr="//div[@id='pay_invoice_online_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="customer_credit_balance">
                    <div class="o_setting_left_pane"></div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <div>
                                <span class="o_form_label">Customer Credit/Overpayment Account</span>
                            </div>
                            <div class="row mt8">
                                <label for="account_credit_balance_id" class="col-lg-4 o_light_label" string="Account" />
                                <field name="account_credit_balance_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            
        </field>
    </record>
</odoo>