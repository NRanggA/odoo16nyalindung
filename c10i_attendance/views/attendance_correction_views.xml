<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_attendance_correction_view_tree" model="ir.ui.view">
            <field name="name">hr.attendance.correction.view.tree</field>
            <field name="model">hr.attendance.correction</field>
            <field name="arch" type="xml">
                <tree string="Perbaikan Absensi">
                    <field name="name"/>
                    <field name="date"/>
                    <!-- <field name="kemandoran_id"/> -->
                    <field name="date_attendance"/>
                    <field name="attendance_type_id"/>
                    <field name="state" widget="badge" decoration-success="state == 'approve'" decoration-warning="state == 'reject'" decoration-info="state == 'progres'" decoration-danger="state == 'cancel'"/>
                </tree>
            </field>
        </record>

        <record id="hr_attendance_correction_view_form" model="ir.ui.view">
            <field name="name">hr.attendance.correction.view.form</field>
            <field name="model">hr.attendance.correction</field>
            <field name="arch" type="xml">
                <form string="Perbaikan Absensi">
                    <header>
                        <button string="Request Approval" name="request_approval" states="draft" type="object" class="oe_highlight"/>
                        <button string="Approve" name="button_approve" states="review" type="object" class="oe_highlight"/>
                        <button string="Reject" name="button_reject" states="review" type="object" class="oe_highlight"/>
                        <button string="Review" name="button_review" states="progres" type="object" class="oe_highlight"/>
                        <button string="Cancel" name="button_cancel" states="progres" type="object" class="oe_highlight"/>
                        <button string="Set to draft" name="set_to_draft" states="approve,reject,cancel" type="object" class="oe_stat_button"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,progres,review,cancel,reject,approve"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Nama" class="oe_edit_only"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <field name="date" attrs="{'readonly': [('state','!=','draft')]}"/>
                            <!-- <field name="kemandoran_id"/> -->
                            <field name="attendance_type_id" attrs="{'readonly': [('state','!=','draft')]}"  options="{'no_create_edit':True, 'no_create':True, 'no_open':False}"/>
                            <field name="date_attendance" attrs="{'readonly': [('state','!=','draft')]}"/>
                        </group>
                        <notebook>
                            <page string="Karyawan">
                                <field name="line_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                    <tree editable="bottom">
                                        <field name="employee_id"/>
                                        <field name="nik"/>
                                        <field name="attendance_sheet_id" invisible="1" required="0" />
                                        <field name="attendance_type"/>
                                        <field name="check_in" readonly="0"/>
                                        <field name="check_out" readonly="0"/>
                                        <field name="reason"/>
                                        <field name="correction"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_hr_attendance_correction" model="ir.actions.act_window">
            <field name="name">Perbaikan Absensi</field>
            <field name="res_model">hr.attendance.correction</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
