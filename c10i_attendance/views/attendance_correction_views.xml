<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="hr_attendance_correction_view_tree" model="ir.ui.view">
            <field name="name">hr.attendance.correction.view.tree</field>
            <field name="model">hr.attendance.correction</field>
            <field name="arch" type="xml">
                <tree string="Perbaikan Absensi">
                    <field name="name" />
                    <field name="date" />
                    <field name="kemandoran_id" />
                    <field name="date_attendance" />
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <record id="hr_attendance_correction_view_form" model="ir.ui.view">
            <field name="name">hr.attendance.correction.view.form</field>
            <field name="model">hr.attendance.correction</field>
            <field name="arch" type="xml">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <form string="Perbaikan Absensi">
                    <sheet>
                        <div class="oe_title">
                                <label for="name" string="Nama" class="oe_edit_only"/>
                                <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <field name="date" />
                            <field name="kemandoran_id" />
                            <field name="date_attendance" />
                        </group>
                        <notebook>
                                <page string="Karyawan">
                                    <field name="line_ids">
                                        <tree editable="bottom">
                                            <field name="employee_id" />
                                            <field name="nik" />
                                            <field name="attendance_type" />
                                            <field name="check_in" /> 
                                            <field name="check_out" /> 
                                            <field name="reason" /> 
                                        </tree>
                                    </field>
                                </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_attendance_correction" model="ir.actions.act_window">
            <field name="name">Perbaikan Absensi</field>
            <field name="res_model">hr.attendance.correction</field>
            <field name="view_mode">tree,form</field>
        </record>
    
    </data>
    
</odoo>
