<odoo>
	
	<record model='ir.ui.view' id='attendance_sheet_tree'>
	    <field name='name'>attendance.sheet.tree</field>
	    <field name='model'>hr.attendance.sheet</field>
	    <field name='arch' type='xml'>
	        <tree string='Sheet Absensi'>
	            <field name='employee_id'/>
	            <field name='date'/>
	            <field name="type_id"/>
	        </tree>
	    </field>
	</record>

	<record id="action_attendance_sheet" model="ir.actions.act_window">
		<field name="name">Sheet Absensi</field>
		<field name="res_model">hr.attendance.sheet</field>
		<field name="view_mode">tree,form</field>
	</record>

</odoo>