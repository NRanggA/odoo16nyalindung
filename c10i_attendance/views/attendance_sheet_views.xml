<odoo>
	
	<record model='ir.ui.view' id='attendance_sheet_tree'>
	    <field name='name'>attendance.sheet.tree</field>
	    <field name='model'>hr.attendance.sheet</field>
	    <field name='arch' type='xml'>
	        <tree string='Sheet Absensi'>
	            <field name='employee_id'/>
	            <field name="date" />
				<field name="type_id"/>
	            <field name="check_in" />
	            <field name="check_out" />
	        </tree>
	    </field>
	</record>

	<record id="attendance_sheet_search" model="ir.ui.view">
        <field name="name">attendance.sheet.search</field>
        <field name="model">hr.attendance.sheet</field>
        <field name="arch" type="xml">
            <search string="Search Attendance Sheets">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="type_id"/>
                <group expand="1" string="Group By">
                    <filter name="group_by_date" string="Tanggal" context="{'group_by':'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_attendance_sheet" model="ir.actions.act_window">
        <field name="name">Sheet Absensi</field>
        <field name="res_model">hr.attendance.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="attendance_sheet_tree"/>
        <field name="search_view_id" ref="attendance_sheet_search"/>
        <field name="context">{'group_by': 'date'}</field>
    </record>

</odoo>