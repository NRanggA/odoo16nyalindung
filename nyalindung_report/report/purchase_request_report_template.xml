<odoo>
    <data>

        <template id="purchase_request_report_template">
            <t t-call="web.html_container"> 
                <t t-foreach="docs" t-as="o">
                    <div class="header" style="margin: 0; padding: 0">
                        <table width="100%" style="border-collapse: collapse;" border="1">
                            <tr>
                                <td width="20%" style="padding : 10px">
                                    <!-- <img src="/nyalindung_report/static/img/ny_logo.jpg" width="180px" height="44px"/> -->
                                    <img t-att-src="'%s/nyalindung_report/static/img/ny_logo.png' % (request.env['ir.config_parameter'].sudo().get_param('web.base.url'))" width="180px" height="44px" alt="Logo"/>
                                </td>
                                <td style="font-size : 28px; text-align : center; font-style : italic; vertical-align : center; padding : 10px">
                                    PURCHASE REQUEST
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="page" style="font-family: 'Arial', sans-serif; margin-top : 40px">
                        <t t-set="months" t-value="{
                            '01': 'Januari',
                            '02': 'Februari',
                            '03': 'Maret',
                            '04': 'April',
                            '05': 'Mei',
                            '06': 'Juni',
                            '07': 'Juli',
                            '08': 'Agustus',
                            '09': 'September',
                            '10': 'Oktober',
                            '11': 'November',
                            '12': 'Desember'
                        }"/>

                        <t t-set="day" t-value="o.date_start.strftime('%d')"/>
                        <t t-set="month" t-value="months[o.date_start.strftime('%m')]"/>
                        <t t-set="year" t-value="o.date_start.strftime('%Y')"/>
                        <t t-set="formatted_date" t-value="day + '  ' + month + '  ' + year"/>

                        <p>Blok / Bagian :</p>
                        <t t-set="seq" t-value="1"/>
                        <table width="100%" style="border-collapse: collapse; margin-top : 10px" border="1">
                            <tbody>
                                <tr style="text-align : center" height="34px">
                                    <td>NO</td>
                                    <td>NAMA BARANG</td>
                                    <td>JUMLAH</td>
                                    <td>SATUAN</td>
                                    <td>KETERANGAN</td>
                                </tr>
                                <tr height="34px" t-foreach="o.line_ids" t-as="item">
                                    <td style="text-align : center"> <t t-esc="seq"/> </td>
                                    <td style="padding-left: 8px"><t t-esc="item.product_id.name"/></td>
                                    <td style="text-align: center"><t t-esc="item.product_qty" t-options='{"widget": "float", "precision": 0}'/></td>
                                    <td style="text-align: center"><t t-esc="item.product_uom_id.name"/></td>
                                    <td style="text-align: center"></td>
                                    <t t-set="seq" t-value="seq + 1"/>
                                </tr>
                            </tbody>
                        </table>
                        <table width="90%" style="margin-left : 48px; margin-top: 48px">
                            <tbody>
                                <tr>
                                    <td width="64%">Mengetahui</td>
                                    <td>Nyalindung : <t t-esc="formatted_date"/></td>
                                </tr>
                                <tr>
                                    <td>Kepala Bagian</td>
                                    <td>Pemohon</td>
                                </tr>
                                <tr height="100px">
                                </tr>
                                <tr>
                                    <td>
                                        <p><t t-esc="o.assigned_to.name"/></p>
                                    </td>
                                    <td>
                                        <p><t t-esc="o.requested_by.name"/></p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="footer">
                        <div style="text-align: center; font-size: 8px">
                            <span class="page"/>
                        </div>
                    </div>   
                </t>
            </t>
        </template>

        <record id="paperformat_purchase_request_report" model="report.paperformat">
            <field name="name">Purchase Request</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="page_width">0</field>
            <field name="page_width">0</field>
            <field name="margin_top">24</field>
            <field name="margin_bottom">10</field>
            <field name="margin_right">24</field>
            <field name="margin_left">24</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">18</field>
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>
