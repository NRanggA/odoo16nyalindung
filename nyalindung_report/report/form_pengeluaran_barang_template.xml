<odoo>
    <data>
        <template id="form_pengeluaran_barang_template">
            <t t-call="web.html_container"> 
                <t t-foreach="docs" t-as="o">      
                    <div class="header" style="font-family: 'Arial', sans-serif;">
                    </div>
                    <div class="page" style="font-family: 'Arial', sans-serif;">
                        <table class="no-border" width="100%">
                            <tr>
                                <td rowspan="3" colspan="3" style="width: 50%; text-align: center;">
                                    <div style="font-size: 12px;">PERKEBUNAN KARET DAN BUAH</div>
                                    <div style="font-size: 18px; font-weight: bold;">PT. NYALINDUNG</div>
                                    <div style="font-size: 12px; text-decoration : underline;">POST ADDRESS PADALARANG BANDUNG</div>
                                </td>
                                <td colspan="3" style="font-size: 18px; font-weight: bold; text-align: center;">
                                    BON PENGELUARAN BARANG
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">Bagian.: <t t-esc="o.afdeling_id.name or ''"/></td>
                                <td>No.: <t t-esc="o.name or ''"/></td>
                            </tr>
                        </table>

                        <table width="89%" style="margin-top: 14px; margin-left: 58px; border-collapse: collapse;" border="1">
                            <tbody>
                                <tr>
                                    <td style="text-align: center; border-left: 1px solid white">No.</td>
                                    <td style="text-align: center;">Nama Barang</td>
                                    <td style="text-align: center;">Dikeluarkan</td>
                                    <td style="text-align: center;">Satuan</td>
                                    <td style="text-align: center; border-right: 1px solid white">Keterangan</td>
                                </tr>
                                <t t-set="counter" t-value="0"/>
                                <t t-foreach="o.move_ids_without_package" t-as="line">
                                    <t t-set="counter" t-value="counter + 1"/>
                                    <tr>
                                        <td style="border-left: 1px solid white; text-align: center;"><t t-esc="counter"/></td>
                                        <td style="text-align: center;"><t t-esc="line.product_id.name"/></td>
                                        <td style="text-align: center;"><t t-esc="line.quantity_done"/></td>
                                        <td style="text-align: center;"><t t-esc="line.product_uom.name"/></td>
                                        <td style="text-align: center; border-right: 1px solid white;"><t t-esc="line.description_picking or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <p style="margin-top: 18px; text-align: right; padding-right: 40px">
                            Nyalindung, <t t-esc="o.date_done and o.date_done.strftime('%d-%m-%Y') or ''"/>
                        </p>
                        
                        <!-- pakai yang dibawah ini kalau mau tanggal hari ini -->
                        <!-- <p style="margin-top: 18px; text-align: right; padding-right: 40px">
                            Nyalindung, <t t-esc="o.date.today().strftime('%d-%m-%Y') or ''"/>
                        </p> -->

                        <table width="89%" style="margin-top: 20px; text-align: center; margin-left: 58px;">
                            <tbody>
                                <tr>
                                    <td>Menyetujui,</td>
                                    <td>Kepala Gudang,</td>
                                    <td>Penerima,</td>
                                    <td>Pemohon,</td>
                                </tr>
                                <tr height="100px"></tr>
                                <tr>
                                    <td>( WAHYU WIDIYANTO )</td>
                                    <td>( BUDI PURWANDI )</td>
                                    <td>( .............................. )</td>
                                    <td>( <t t-esc="o.employee_id.name or ''"/> )</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="footer">
                        <div style="text-align: center; font-size: 8px">
                            <span class="page"/>
                        </div>
                    </div>   
                </t>
            </t>
        </template>

        <record id="paperformat_form_pengeluaran_barang" model="report.paperformat">
            <field name="name">Sales Quatation Karet</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="page_width">0</field>
            <field name="page_width">0</field>
            <field name="margin_top">24</field>
            <field name="margin_bottom">10</field>
            <field name="margin_right">10</field>
            <field name="margin_left">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">18</field>
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>
