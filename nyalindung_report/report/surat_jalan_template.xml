<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template t-name="nyalindung_report.report_surat_jalan">
        <t t-call="web.html_container">
            <head>
                <meta charset="utf-8"/>
                <style>
                table {
                    font-family: arial, sans-serif;
                    border-collapse: collapse;
                    width: 100%;
                    font-size: 8px;
                }

                td, th {
                    <!-- border: 1px solid #181C14; -->
                    text-align: left;
                    padding: 4px;
                    padding: 2;
                }
                .header-1, .header-2 {
                    width: 50%;
                }
                .header-logo {
                    text-align: left; 
                    width: 100%;
                }
                .content-table td {
                    border: 1px solid #181C14;
                    text-align:center;
                    padding: 2;
                }
                </style>
            </head>
            <body>
                <t t-set="o" t-value="doc"/>
                <t t-foreach="docs" t-as="o">
                    <table>
                        <tr>
                            <th colspan="2" style="border: 1px solid #181C14">
                                <table>
                                    <tr>
                                        <th rowspan="4" width="20%">
                                            <!-- <img src="" width="170px" height="40px" alt="Logo"/> -->
                                            <img t-att-src="'%s/nyalindung_report/static/img/ny_logo.png' % (request.env['ir.config_parameter'].sudo().get_param('web.base.url'))" width="150px" height="40px" alt="Logo"/>
                                        </th>
                                        <th>SURAT JALAN</th>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">PT. NYALINDUNG</td>
                                    </tr>
                                    <tr>
                                        <td>Jl. Raya Purwakarta No. 625 Km.9</td>
                                    </tr>
                                    <tr>
                                        <td>Padalarang / Kab. Bandung Barat</td>
                                    </tr>
                                </table>
                            </th>
                        </tr>
                        <tr>
                            <td class="header-1" style="border :1px solid #181C14">Kepada Yth,  <span t-field="o.partner_id.name"/></td>
                            <td class="header-2" style="border : 1px solid #181C14">
                                <p style="text-align:center; margin:0;">Bukti Pengiriman Barang dan Pertambangan</p>
                                <table>
                                    <tr>
                                        <td style="width: 20%">No. Do</td>
                                        <td style="width: 80%">:  <span t-field="o.name"/></td>
                                    </tr>
                                    <tr>
                                        <td>Expedisi</td>
                                        <td>: ... </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="border :1px solid #181C14">
                                <table>
                                    <tr>
                                        <td>Dengan Kendaraan</td>
                                        <td>: ... </td>
                                        <td>No. Pol</td>
                                        <td>: ... kami kirimkan barang-barang sebagai berikut</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="border :1px solid #181C14">
                                <table class="content-table">
                                    <tr>
                                        <td rowspan="2">No.</td>
                                        <td rowspan="2">Nama Barang</td>
                                        <td rowspan="2">Satuan</td>
                                        <td rowspan="2">Pak</td>
                                        <td colspan="3">Volume</td>
                                        <td rowspan="2">Keterangan</td>
                                    </tr>
                                    <tr>
                                        <td>Brutto</td>
                                        <td>Tarra</td>
                                        <td>Netto</td>
                                    </tr>
                                    <t t-set="i" t-value="0" />
                                    <t t-foreach="o.move_ids_without_package" t-as="product">
                                        <tr>
                                            <td t-esc="i + 1"/>
                                            <td t-esc="product.product_id.name" />
                                            <td/>
                                            <td/>
                                            <td/>
                                            <td/>
                                            <td/>
                                            <td/>
                                        </tr>
                                        <t t-set="i" t-value="i + 1" />
                                    </t>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="border:1px solid #181C14; text-align:center;">
                                <table>
                                    <tr>
                                        <td>Diterima Tgl : ........</td>
                                        <td>Diperiksa/disetujui : ....</td>
                                        <td>Dikirim Tgl : .....</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>(.................)</td>
                                        <td>(.................)</td>
                                        <td>(.................)</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </t>
            </body>
        </t>
    </template>

    <record id="paperformat_surat_jalan_report" model="report.paperformat">
        <field name="name">Surat Jalan Report</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="orientation">Landscape</field>
        <field name="page_height">165</field>
        <field name="page_width">110</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_right">0</field>
        <field name="margin_left">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">50</field>
    </record>

</odoo>
