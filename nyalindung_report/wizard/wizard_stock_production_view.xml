<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_stock_production_view_form" model="ir.ui.view">
        <field name="name">wizard.stock.production.view.form</field>
        <field name="model">wizard.stock.production</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                    </group>
                    <group>
                    </group>
                </group>
                <footer>
                    <button name="print_excel" string="Export Excel" type="object" class="btn-primary"/>
                    or
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_stock_production" model="ir.actions.act_window">
        <field name="name">Mutasi Stok Produksi</field>
        <field name="res_model">wizard.stock.production</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_wizard_stock_production"
        action="action_wizard_stock_production"
        parent="mrp.menu_mrp_reporting"
        sequence="101"/>

</odoo>
