<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_report_production_view_form" model="ir.ui.view">
        <field name="name">wizard.report.production.view.form</field>
        <field name="model">wizard.report.production</field>
        <field name="arch" type="xml">
            <form string="Report Production">
                <sheet>
                    <group>
                        <group>
                            <field name="from_date" required="1"/>
                        </group>
                        <group>
                            <field name="to_date" required="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="kemandoran_id" options="{'no_create': True}"/>
                    </group>
                    <footer>
                        <button string="Print" type="object" name="create_report" class="btn-primary"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wizard_report_production_action" model="ir.actions.act_window">
        <field name="name">Report Produksi Karet Detail</field>
        <field name="res_model">wizard.report.production</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="wizard_report_production_menu"
        name="Report Produksi Karet Detail"
        action="wizard_report_production_action"
        parent="c10i_lhm_v16.menu_plantation_report"
        sequence="99"/>
</odoo>
