<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ny_attendance_log_view_form" model="ir.ui.view">
        <field name="name">ny.attendance.log.view.form</field>
        <field name="model">ny.attendance.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h2>
                        <label for="employee_id"/><field name="employee_id" placeholder="Employee"/>
                    </h2>
                    <group>
                        <group>
                            <!-- <field name="version"/> -->
                            <field name="longitude"/>
                            <field name="latitude"/>
                            <field name="waktu"/>
                        </group>
                        <group>
                            <field name="foto"/>
                            <field name="statusmasuk"/>
                            <field name="keterangan"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ny_attendance_log_view_tree" model="ir.ui.view">
        <field name="name">ny.attendance.log.view.tree</field>
        <field name="model">ny.attendance.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="waktu"/>
                <field name="longitude" optional="hide"/>
                <field name="latitude" optional="hide"/>
                <field name="statusmasuk"/>
            </tree>
        </field>
    </record>

    <record id="ny_attendance_log_view_search" model="ir.ui.view">
        <field name="name">ny.attendance.log.view.search</field>
        <field name="model">ny.attendance.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
            </search>
        </field>
    </record>

    <record id="ny_attendance_log_action" model="ir.actions.act_window">
        <field name="name">MyDaya Attendance</field>
        <field name="res_model">ny.attendance.log</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
