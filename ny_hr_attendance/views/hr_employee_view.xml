<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_mydaya_user_form" model="ir.ui.view">
        <field name="name">hr.employee.mydaya.user.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="c10i_hr_16.view_karyawan_form_inherit"/>
        <field name="arch" type="xml">
            <page name="hr_settings" position="before">
                <page name="mydaya" string="Akses My Daya">
                    <group>
                        <group>
                            <field name="mydaya_user_login" />
                            <field name="mydaya_user_pwd" password="1" attrs="{'required': [('mydaya_user_login', '!=', False)]}"/>
                        </group>
                        <group>
                            <!-- <field name="lat_acuan" />
                            <field name="long_acuan" />
                            <field name="value_jarak" /> -->
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
    <record id="hr_foreman_user_form_inherit" model="ir.ui.view">
        <field name="name">hr.foreman.user.form.inherit</field>
        <field name="model">hr.foreman</field>
        <field name="inherit_id" ref="c10i_lhm_v16.view_hr_foreman_form"/>
        <field name="arch" type="xml">
            <field name="user_input_id" position="after">
                <field name="attendance_correction_user_id" string="Attendance Correction User" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
            </field>
        </field>
    </record>
</odoo>
