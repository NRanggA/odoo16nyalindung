<odoo>
    <record id="view_purchase_revision_wizard_form" model="ir.ui.view">
        <field name="name">purchase.revision.wizard.form</field>
        <field name="model">purchase.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Revision Number">
                <group>
                    <field name="current_revision" readonly="1"/>
                    <field name="new_revision"/>
                </group>
                <footer>
                    <button name="purchase_revision" string="Revision" type="object" class="btn-primary"/>
                    <!-- <button name="close_wizard" string="Cancel" type="object" class="btn-secondary"/> -->
                </footer>
            </form>
        </field>
    </record>
</odoo>