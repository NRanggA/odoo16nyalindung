<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_request_make_purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.request.line.make.purchase.order.form</field>
        <field name="model">purchase.request.line.make.purchase.order</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_line_make_purchase_order"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_id']" position="replace">
                <field name="supplier_ids" widget="many2many_tags" domain="[('supplier_rank', '>', 0)]"/>
            </xpath>
            <xpath expr="//field[@name='purchase_order_id']" position="attributes">
                <attribute name="domain">[('partner_id', 'in', supplier_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>