<odoo>
    <record id="view_order_form_inherit_non_credit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.non.credit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="non_credit"/>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="termin_pembayaran"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('vendor_category', '=', True)]</attribute>
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
            <xpath expr="//field[@name='product_packaging_id']" position="attributes">
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_order_form_inherit_readonly_advanced" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.readonly.advanced</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="boolean_cancel_advanced" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('state', 'not in', ('draft', 'sent', 'to approve', 'purchase')), ('count_advanced_purchase', '&gt;', 0)], 'force_save': [('count_advanced_purchase', '&gt;', 0)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="attributes">
                <attribute name="attrs">{'readonly': [('count_advanced_purchase', '&gt;', 0)],'force_save': [('count_advanced_purchase', '&gt;', 0)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='non_credit']" position="attributes">
                <attribute name="attrs">{'readonly': [('count_advanced_purchase', '&gt;', 0), ('boolean_cancel_advanced', '=', False)],'force_save': [('count_advanced_purchase', '&gt;', 0)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('count_advanced_purchase', '&gt;', 0)],'force_save': [('count_advanced_purchase', '&gt;', 0)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="attrs">{'readonly': [('count_advanced_purchase', '&gt;', 0)],'force_save': [('count_advanced_purchase', '&gt;', 0)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='incoterm_id']" position="attributes">
                <attribute name="attrs">{'readonly': [('count_advanced_purchase', '&gt;', 0)],'force_save': [('count_advanced_purchase', '&gt;', 0)]}</attribute>
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
            <xpath expr="//field[@name='incoterm_location']" position="attributes">
                <attribute name="attrs">{'readonly': [('count_advanced_purchase', '&gt;', 0)],'force_save': [('count_advanced_purchase', '&gt;', 0)]}</attribute>
                <attribute name="options">{"no_create": True, "no_edit": True}</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="attrs">{'readonly': ['|', '|', ('invoice_status', '=', 'invoiced'), ('state', '=', 'done'), ('count_advanced_purchase', '&gt;', 0)], 'force_save': [('count_advanced_purchase', '&gt;', 0)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
                <attribute name="attrs">{'readonly': ['|', '|', ('invoice_status', '=', 'invoiced'), ('state', '=', 'done'), ('count_advanced_purchase', '&gt;', 0)], 'force_save': [('count_advanced_purchase', '&gt;', 0)]}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//sheet" position="inside">
                <group string="Revision Info">
                    <field name="revision_number" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="open_revision_wizard"
                        string="Set Revision"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': ['|', ('state', '!=', 'purchase'), ('revision_number', '&lt;', 0)]}"/>
            </xpath> -->
            <xpath expr="//header" position="inside">
                <button name="create_revision" 
                        string="Create Revision"
                        type="object"
                        states="purchase"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>
    <record id="view_purchase_order_inherit" model="ir.ui.view">
        <field name="name">purchase.order.tree_inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='name']" position="after">
                <field name="pr_names"/>
            </xpath>
        </field>
    </record>
</odoo>