<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Definisi Tree View -->
    <record id="purchase_order_report_outstanding_view_tree" model="ir.ui.view">
        <field name="name">purchase.order.report.outstanding.view.tree</field>
        <field name="model">purchase.order.report.outstanding</field>
        <field name="arch" type="xml">
            <tree string="Purchase Order Outstanding">
                <field name="date" widget="date" />
                <field name="purchase_request_id" />
                <field name="purchase_request_date" widget="date" />
                <field name="purchase_order_id" />
                <field name="purchase_order_date" widget="date" />
                <field name="product_id" />
                <field name="date_planned" widget="date" />
                <field name="days_count" decoration-danger="1"/>
            </tree>
        </field>
    </record>


    <!-- Definisi Action -->
    <record id="purchase_order_report_outstanding_action" model="ir.actions.act_window">
        <field name="name">Outstanding Report Purchase Order</field>
        <field name="res_model">purchase.order.report.outstanding</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="context">{'create': false}</field>
    </record>

    <!-- Definisi Menu -->
    <menuitem
        id="purchase_order_report_outstanding_menu"
        name="Outstanding Report PO"
        action="purchase_order_report_outstanding_action"
        parent="purchase.purchase_report_main"
        sequence="99"/>
</odoo>
