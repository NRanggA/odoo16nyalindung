<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="purchase_request_report_outstanding_view_tree" model="ir.ui.view">
        <field name="name">purchase.request.report.outstanding.view.tree</field>
        <field name="model">purchase.request.report.outstanding</field>
        <field name="arch" type="xml">
            <tree string="Purchase Request Outstanding">
                <field name="date" widget="date" />
                <field name="purchase_request_id" />
                <field name="purchase_request_date" widget="date" />
                <field name="product_id" />
                <field name="date_required" widget="date" />
                <field name="days_count" decoration-danger="days_count &lt; 0" decoration-success="days_count &gt;= 0"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="purchase_request_report_outstanding_action" model="ir.actions.act_window">
        <field name="name">Outstanding Report Purchase Request</field>
        <field name="res_model">purchase.request.report.outstanding</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="context">{'create': false}</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_report_outstanding_purchase_request"
              name="Report"
              parent="purchase_request.parent_menu_purchase_request"
              sequence="10"/>

    <menuitem id="submenu_report_outstanding_purchase_request"
              name="Outstanding Purchase Request"
              parent="ny_purchase.menu_report_outstanding_purchase_request"
              action="purchase_request_report_outstanding_action"
              sequence="10"/>
</odoo>
