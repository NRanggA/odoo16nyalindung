<?xml version="1.0" ?>
<odoo>
    <record id="c10i_view_asset_disposal_form" model="ir.ui.view">
        <field name="name">c10i.view.asset.disposal.form</field>
        <field name="model">account.asset.disposal</field>
        <field name="arch" type="xml">
            <form string="Asset Disposal">
                <header>
                    <button name="do_action" string="Sell or Dispose" type="object" class="oe_highlight" attrs="{'invisible': [('state', '=', 'closed')]}"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight" attrs="{'invisible':['|', ('action', '!=', 'sell'), ('invoice_id', '!=', False)]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,closed" statusbar_colors='{"closed":"blue"}'/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="action" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="asset_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="gross_value" force_save="1" readonly="1" />
                            <field name="value_residual" attrs="{'invisible': [('value_residual', '=', 0)]}" force_save="1" readonly="1"/>
                            <field name="cumulative_depreciation" attrs="{'invisible': [('cumulative_depreciation', '=', 0)]}" force_save="1" readonly="1"/>
                            <field name="sell_value" attrs="{'invisible':[('action', '!=', 'sell')], 'required': [('invoice_id', '=', False)], 'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="select_invoice_line_id" invisible="1"/>
                            <field name="reason" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="gain_or_loss" invisible="1"/>
                        </group>
                        <group>
                            <field name="partner_id" required="1" options="{'no_create': True}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="invoice_id" options="{'no_create': True}" attrs="{'invisible': [('action', '!=', 'sell')]}" force_save="1" readonly="1"/>
                            <field name="sales_profit" />
                            <field name="invoice_line_id" options="{'no_create': True}" attrs="{'invisible': [('select_invoice_line_id', '=', False)], 'required': [('select_invoice_line_id', '=', True)], 'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="gain_account_id" attrs="{'invisible': [('gain_or_loss', '!=', 'gain')], 'required': [('gain_or_loss', '=', 'gain')], 'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="loss_account_id" attrs="{'invisible': [('gain_or_loss', '!=', 'loss')], 'required': [('gain_or_loss', '=', 'loss')], 'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="sell_account_move_id" attrs="{'invisible':[('sell_account_move_id', '=', False)], 'readonly': 1}"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
    <record id="c10i_view_asset_disposal_tree" model="ir.ui.view">
        <field name="name">c10i.view.asset.disposal.tree</field>
        <field name="model">account.asset.disposal</field>
        <field name="arch" type="xml">
            <tree string="Asset Disposal">
                <field name="name" />
                <field name="asset_id" />
                <field name="action"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <record id="c10i_view_asset_disposal_search" model="ir.ui.view">
        <field name="name">c10i.view.asset.disposal.select</field>
        <field name="model">account.asset.disposal</field>
        <field name="arch" type="xml">
            <search string="Search Asset Disposal">
                <field name="name" string="Asset Disposal" />
                <field name="asset_id" />
            </search>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="c10i_asset_disposal_form_action">
        <field name="name">Asset Disposal</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.disposal</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="c10i_view_asset_disposal_search" />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            Click to start a new asset disposal process.
          </p>
        </field>
    </record>

    <menuitem id="c10i_menu_asset_disposal" name="Asset Disposal" parent="account.menu_finance_entries_management" action="c10i_asset_disposal_form_action" sequence="99"/>

</odoo>