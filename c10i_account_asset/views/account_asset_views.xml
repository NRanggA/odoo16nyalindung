<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="c10i_view_account_asset_form">
        <field name="name">c10i.account.asset.form</field>
        <field name="model">account.asset.asset</field>
        <!-- <field name="model">account.account.asset</field> -->
        <field name="inherit_id" ref="om_account_asset.view_account_asset_asset_form"/>
        <!-- <field name="inherit_id" ref="account_asset.view_account_asset_form"/> -->
        <field name="arch" type="xml">
        	<field name="date" position="after">
                <field name="gain_account_id" attrs="{'readonly': [('state', '!=', 'draft')]}" />
                <field name="loss_account_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                <field name="write_on_asset_sales_account_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
        		<field name="asset_acquisition_id" readonly="1"/>
        	</field>
            <xpath expr="//page[child::field[@name='depreciation_line_ids']]" position="after">
                <page string="Sell / Disposal Info" attrs="{'invisible': [('disposal_id', '=', False)]}">
                    <group>
                        <group>
                            <field name="disposal_id" readonly="1"/>
                            <field name="sell_account_move_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="reason" readonly="1"/>
                        </group>
                    </group>                    
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit form asset om_account_asset -->
    <record id="account_asset_asset_inherit_view_form" model="ir.ui.view">
        <field name="name">account_asset_asset_inherit_view_form</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="om_account_asset.view_account_asset_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='set_to_close']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_category_form_inherit_c10i_account_asset" model="ir.ui.view">
        <field name="name">account.asset.category.view.form.inherit</field>
        <field name="model">account.asset.category</field>
        <field name="inherit_id" ref="om_account_asset.view_account_asset_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group[2]" position="after">
                <group string="Disposal Information">
                    <field name="gain_account_id" />
                    <field name="loss_account_id" />
                    <field name="write_on_asset_sales_account_id" />
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit View search -->
    <record id="view_account_asset_search_inherit" model="ir.ui.view">
        <field name="name">account.asset.search.inherit</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="om_account_asset.view_account_asset_search"/>
        <field name="arch" type="xml">
            <filter name="closed" position="after">
                <filter string="Archive" name="archive" domain="[('active', '=', False)]" help="Inactive assets"/>
            </filter>
        </field>
    </record>


</odoo>
