<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_report_asset_view_form" model="ir.ui.view">
        <field name="name">wizard.report.asset.view.form</field>
        <field name="model">wizard.report.asset</field>
        <field name="arch" type="xml">
            <form string="Report Asset">
                <sheet>
                    <group>
                        <group>
                            <field name="date" string="As Of Date" />
                            <field name="company_id" readonly="1"/>
                        </group>
                        <!-- <group>
                            <field name="to_date" />
                        </group> -->
                    </group>
                    <group name="asset_category_ids" string="Asset Category">
                        <field name="asset_category_ids" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <button string="print" type="object" name="create_report" class="btn-primary"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wizard_report_asset_action" model="ir.actions.act_window">
        <field name="name">Report Account Asset </field>
        <field name="res_model">wizard.report.asset</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="wizard_report_asset_menu"
        name="Report Asset"
        action="wizard_report_asset_action"
        parent	= "account.menu_finance_reports"
        sequence="163"/>

</odoo>
