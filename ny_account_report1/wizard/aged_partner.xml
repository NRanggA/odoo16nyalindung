<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ny_account_aged_balance_view" model="ir.ui.view">
        <field name="name">Aged Partner Balance</field>
        <field name="model">account.aged.trial.balance</field>
        <field name="inherit_id" ref="accounting_pdf_reports.account_aged_balance_view"/>
        <field name="arch" type="xml">
            <field name="partner_ids" position="after">
                <field name="account_ids" widget="many2many_tags"
                               options="{'no_open': True, 'no_create': True}"/>
            </field>
            <field name="date_from" position="attributes">
                <attribute name="string">As of Date</attribute>
            </field>
            <button name="check_report" position="after">
                <button name="check_report" context="{'xlsx': True}" string="Download Excel" type="object" default_focus="1" class="oe_highlight" data-hotkey="w"/>
            </button>
        </field>
    </record>

</odoo>
