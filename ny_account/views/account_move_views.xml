<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_register_payment']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="account_view_skip_efaktur_inherit" model="ir.ui.view">
        <field name="name">account.view.skip.efaktur.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_id_efaktur.account_move_efaktur_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_id_tax_number']" position="attributes">
                <attribute name="attrs">{'invisible': [('move_type', '=', 'entry')]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
