<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_asset_form_inherit" model="ir.ui.view">
        <field name="name">Account Asset Form Inherit</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="om_account_asset.view_account_asset_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='analytic_distribution']" position="after">
                <field name="charge_to_activity" />
                <field name="lokasi" />
                <label for="luas"/>
                <div class="o_input_group">
                    <field name="luas" nolabel="1"/>
                    <div class="o_form_label">m²</div>
                </div>
            </xpath>

            <xpath expr="//field[@name='currency_id']" position="before">
                <field name="beginning_balance" />
            </xpath>
            
            <xpath expr="//field[@name='value']" position="after">
                <field name="accumulated_depreciation" attrs="{'invisible': [('beginning_balance', '=', False)]}"/>
            </xpath>


            <xpath expr="//notebook" position="inside">
                <page name="charge_to_activity" string="Charge To Activity" attrs="{'invisible': [('charge_to_activity', '=', False)]}">
                    <group string="Plantation">
                        <!-- <field name="location_type_id" />
                        <field name="varieties_id" domain="[('type_id', '=', location_type_id)]"/>
                        <field name="location_id" domain="[('type_id', '=', location_type_id)]"/>
                        <field name="activity_id" domain="[('type_id', '=', location_type_id)]"/> -->
                        
                        
                        <field name="location_type_id" domain="[('no_line','=',False)]" 
                                options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" 
                                optional="show"/>
                        <field name="varieties_validator" invisible="1"/>
                        <field name="varieties_id" options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" 
                                attrs="{'readonly': [('varieties_validator','=',False)], 
                                        'required': [('varieties_validator','=',True)]}"/>
                        <field name="filtered_locations" invisible="1" />
                        <field name="location_id" 
                                domain="[('id','in',filtered_locations)]" 
                                options="{'no_create_edit':True, 'no_create':True, 'no_open':True}"/>
                        <field name="filtered_activities" invisible="1" />
                        <field name="activity_id" 
                            domain="[('id','in',filtered_activities)]" 
                            options="{'no_create_edit':True, 'no_create':True, 'no_open':True}" />
                        <field name="account_activity_id" readonly="1" />
                        <field name="account_activity_cost_id" readonly="1" />


                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
