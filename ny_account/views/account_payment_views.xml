<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vendor_payment_form_inherit" model="ir.ui.view">
        <field name="name">Vendor Payment Form Inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Menambahkan tombol di dalam form -->
            <xpath expr="//header" position="inside">
                <button name="report_data" type="object"
                string="Print Vendor Payment Report" class="btn-primary"
                attrs="{'invisible': ['|', '|', ('payment_type', '!=', 'outbound'), ('partner_type', '!=', 'supplier'), ('id', '=', False)]}"/>
            </xpath>

            <xpath expr="//header" position="inside">
                    <button name="report_amount_charge" type="object"
                        string="Print Report Amount Adm" class="btn-primary"
                        attrs="{'invisible': ['|', ('charge_account_id', '=', False), ('join_payment', '=', True)]}"/>
                                            <!-- '|',
                                            ('amount_charge', '=', 0),
                                            ('charge_account_id', '=', False),
                                            '&amp;',  -->
                                            <!-- ('no_memo', '!=', False), 
                                            ('date_memo', '!=', False)]}"/> -->
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="customer_payment_report" type="object"
                string="Print Customer Payment Report" class="btn-primary"
                attrs="{'invisible': ['|', '|', ('payment_type', '!=', 'inbound'), ('partner_type', '!=', 'customer'), ('id', '=', False)]}"/>
            </xpath>

            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="amount_charge" attrs="{'invisible': ['|',('payment_type', '!=', 'outbound'), ('partner_type', '!=', 'supplier')], 'readonly': [('state','!=','draft')]}"/>
                <field name="memo_charge" attrs="{'invisible': ['|',('payment_type', '!=', 'outbound'), ('partner_type', '!=', 'supplier')], 'readonly': [('state','!=','draft')]}"/>
                <field name="charge_account_id" attrs="{'invisible': ['|',('payment_type', '!=', 'outbound'), ('partner_type', '!=', 'supplier')], 'readonly': [('state','!=','draft')]}"/>
                <field name="no_memo" />
                <field name="date_memo" />
                <field name="join_payment" />
            </xpath>

            <xpath expr="//field[@name='ref']" position="after">
                <field name="department_id" />
                <field name="alokasi" />
                <field name="jenis_pembayaran" />
                <field name="atas_nama" />
            </xpath>

            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='write_off_account_id']" position="after">
                <field name="description" />
            </xpath>

        </field>
    </record>


</odoo>
