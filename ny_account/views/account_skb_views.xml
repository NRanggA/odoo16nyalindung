<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_partner_form_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group/group" position="inside">
                    <field name="is_skb"/>
                    <field name="no_skb" attrs="{'invisible': [('is_skb', '!=', True)]}"/>
                    <field name="masa_berlaku" attrs="{'invisible': [('is_skb', '!=', True)]}"/>
                    <!-- <field name="taxes_exclude" attrs="{'invisible': [('is_skb', '!=', True)]}"/> -->
                    <field name="taxes_exclude" widget="many2many_tags" attrs="{'invisible': [('is_skb', '!=', True)]}"/>
                </xpath>
                <xpath expr="//group/group" position="inside">
                    <field name="employee_category"/>
                    <field name="customer_category"/>
                    <field name="vendor_category"/>
                </xpath>
            </field>
        </record>
        <record id="view_res_partner_tree_vendor_filter" model="ir.ui.view">
            <field name="name">res.partner.tree.vendor.filter</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.res_partner_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='supplier']" position="attributes">
                    <attribute name="domain">[('vendor_category', '=', True)]</attribute>
                </xpath>
                <xpath expr="//filter[@name='customer']" position="attributes">
                    <attribute name="domain">[('customer_category', '=', True)]</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
