<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ny_account_inherit_direct_payment" model="ir.ui.view">
        <field name="name">Direct Payment Form Inherit</field>
        <field name="model">account.direct.payment</field>
        <field name="inherit_id" ref="c10i_direct_payment.account_direct_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="report_data" type="object"
                string="Print Direct Payment Report" class="btn-primary"
                attrs="{'invisible': [('id', '=', False)]}"/>
            </xpath>
            
            <!-- view di product_id tree di hide -->
            <xpath expr="//field[@name='line_ids']/tree//field[@name='product_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- view di form product_id di hide -->
            <xpath expr="//field[@name='line_ids']/form//field[@name='product_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- Menambahkan field jenis pembayaran -->
            <xpath expr="//field[@name='description']" position="after">
                <field name="jenis_pembayaran"/>
                <field name="atas_nama"/>
            </xpath>

        </field>
    </record>

</odoo>
