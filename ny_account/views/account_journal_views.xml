<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="account_journal_form_view" model="ir.ui.view">
            <field name="name">account.journal.form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_sequence']" position="before">
                    <field name="sequence_id" attrs="{'invisible': [('type', 'not in', ['bank', 'cash'])]}"/>
                    <field name="sequence_out_id" attrs="{'invisible': [('type', 'not in', ['bank', 'cash'])]}"/>
                </xpath>
                <!-- Penambahan ORG setelah field type -->
                <xpath expr="//field[@name='type']" position="after">
                    <field name="varieties_id" attrs="{'invisible': [('type', '!=', 'sale')]}"/>
                </xpath>
            </field>
        </record>
    </data>

</odoo>
