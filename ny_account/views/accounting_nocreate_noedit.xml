<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_accounting_nocreate_no_edit" model="ir.ui.view">
        <field name="name">accounting.nocreate.noedit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='advanced_move_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_user_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//group[@id='other_tab_group']//field[@name='partner_bank_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_incoterm_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='campaign_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='medium_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='source_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_accounting_nocreate_no_edit_payment" model="ir.ui.view">
        <field name="name">accounting.nocreate.noedit.payment</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='write_off_account_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='destination_journal_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_accounting_nocreate_no_edit_direct_payment" model="ir.ui.view">
        <field name="name">accounting.nocreate.noedit.direct.payment</field>
        <field name="model">account.direct.payment</field>
        <field name="inherit_id" ref="c10i_direct_payment.account_direct_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>