                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr class="signature-box-footer">
                                        <td>(Isi Nama dan Tanggal)</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </t>
            </body>
        </t>
    </template>
</odoo>
