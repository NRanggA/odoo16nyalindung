        <record id="action_report_direct_payment_cash" model="ir.actions.report">
            <field name="name">Report Payment Vendor (Cash)</field>
            <field name="model">account.direct.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ny_account.report_direct_payment_cash</field>
            <field name="report_file">ny_account.report_direct_payment_cash</field>
            <field name="print_report_name">('Report Direct Payment (Cash)')</field>
            <field name="paperformat_id" ref="paperformat_payment_vendor_report"/>
        </record>


    </data>
    

</odoo>
