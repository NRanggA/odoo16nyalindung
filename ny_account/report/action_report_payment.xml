<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <!-- Vendor Payment -->
        <record id="action_report_payment_vendor_bank" model="ir.actions.report">
            <field name="name">Report Payment Vendor Bank</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ny_account.report_payment_vendor_bank</field>
            <field name="report_file">ny_account.report_payment_vendor_bank</field>
            <field name="print_report_name">('Report Payment Vendor Bank')</field>
            <field name="paperformat_id" ref="paperformat_payment_vendor_report"/>
        </record>
        <record id="action_report_payment_vendor_cash" model="ir.actions.report">
            <field name="name">Report Payment Vendor (Cash)</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ny_account.report_payment_vendor_cash</field>
            <field name="report_file">ny_account.report_payment_vendor_cash</field>
            <field name="print_report_name">('Report Payment Vendor (Cash)')</field>
            <field name="paperformat_id" ref="paperformat_payment_vendor_report"/>
        </record>

        <!-- Direct Payment -->
        <record id="action_report_direct_payment_bank" model="ir.actions.report">
            <field name="name">Report Direct Payment Bank</field>
            <field name="model">account.direct.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ny_account.report_direct_payment_bank</field>
            <field name="report_file">ny_account.report_direct_payment_bank</field>
