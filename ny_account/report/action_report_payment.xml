<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <!-- Vendor Payment -->
        <record id="action_report_payment_vendor_bank" model="ir.actions.report">
            <field name="name">Report Payment Vendor Bank</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ny_account.report_payment_vendor_bank</field>
            <field name="report_file">ny_account.report_payment_vendor_bank</field>
            <field name="print_report_name">("Report Vendor Payment Bank %s" % (object.partner_id.name))</field>
            <field name="paperformat_id" ref="paperformat_payment_vendor_report"/>
        </record>
