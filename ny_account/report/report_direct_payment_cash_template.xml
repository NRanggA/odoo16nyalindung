<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template t-name="ny_account.report_direct_payment_cash">
        <t t-call="web.html_container">
            <head>
                <meta charset="utf-8"/>
                <style>
                    table {
                        border-collapse: collapse;
                        width: 100%;
                    }

                    .header-left{
                        width:50%;
                    }

                    .header-right{
                        width:50%;
                    }
                    .header-table td, th{
                        padding: 3px;
                    }
                    td, th {
                        text-align: left;
                        padding: 5px;
                    }
                    .signature-box, td, th{
                        padding:4px;
                    }
                    .signature-box .signature-box-header{
                        background-color: orange;
                        vertical-align: top;
                    }
                    .signature-box .signature-box-footer{
                        vertical-align: buttom;
                    }
                </style>
            </head>
            <body>
                <t t-set="o" t-value="doc"/>
                <t t-foreach="docs" t-as="o">
                    <table style="border: 1px solid black; text-align: left; padding: 5px;">
                        <tr style="border: 1px solid black;" class="header-table">
                            <th class="header-left" style="border: 1px solid black;">
                                <table style="border: none; font-size: 8px; text-align: left;">
                                    <tr>
                                        <th rowspan="4" width="40%">
                                            <img t-att-src="'%s/ny_account/static/src/img/logo1.png' % (request.env['ir.config_parameter'].sudo().get_param('web.base.url'))" width="170px" height="40px" alt="Logo"/>
                                        </th>
                                        <th style="font-size: 13px;">BUKTI KAS KELUAR</th>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">PT. Nyalindung</td>
                                    </tr>
                                    <tr>
                                        <td>Jl. Raya Purwakarta No. 625 Km.9</td>
                                    </tr>
                                    <tr>
                                        <td>Padalarang / Kab. Bandung Barat</td>
                                    </tr>
                                </table>
                            </th>
                            <th class="header-right" colspan="2">
                                <table style="border: none; font-size: 8px;">
                                    <!-- <tr>
                                        <th>No. DBIS</th>
                                        <td> : </td>
                                    </tr> -->
                                    <tr>
                                        <th>No. Invoice</th>
                                        <td>
                                            :
                                            <span t-field="o.account_move_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>No. Payment</th>
                                        <td> : <span t-field="o.name"/></td>
                                    </tr>
                                </table>
                            </th>
                        </tr>
                        <tr style="border: 1px solid black;" class="header-table">
                            <td class="header-left" rowspan="2" style="border: 1px solid black;">
                                <table style="border: none; font-size: 8px;">
                                    <tr>
                                        <th>Dibayar Kepada</th>
                                        <td> : <span t-field="o.partner_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <th>Nominal</th>
                                        <td> : <span t-esc="o.format_amount(o.amount_total)"/></td>
                                    </tr>
                                    <tr>
                                        <th>Terbilang</th>
                                        <td style="font-weight: bold; font-style: italic;"> : # <span t-field="o.amount_text"/> rupiah #</td>
                                    </tr>
                                </table>
                            </td>
                            <td class="header-right" colspan="2">
                                <table style="border: none; font-size: 8px;">
                                    <tr>
                                        <th style="width: 20%">Alokasi</th>
                                        <td style="width: 80%">:</td>
                                    </tr>
                                    <tr>
                                        <th>Dept/Divisi</th>
                                        <td>:</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr class="header-table">
                            <td class="header-left" colspan="2">
                                <t t-set="row_count" t-value="len(o.line_ids) + 1"/>
                                <table style="border: 1px solid black; font-size: 8px;">
                                    <tr style="border: 1px solid black;">
                                        <th t-att-rowspan="row_count" style="background-color: orange; border: 1px solid black; text-align:center;">
                                            Rincian COA
                                        </th>
                                        <th style="background-color: orange; border: 1px solid black;">Keterangan</th>
                                        <th style="background-color: orange; border: 1px solid black;">No COA</th>
                                        <th style="background-color: orange; border: 1px solid black;">Nilai</th>
                                    </tr>
                                    <t t-foreach="o.line_ids" t-as="payment">
                                        <tr style="border: 1px solid black;">
                                            <td style="border: 1px solid black;" t-esc="payment.name"/>
                                            <td t-esc="payment.account_id.name" style="border: 1px solid black;"/>
                                            <td style="text-align:right; border: 1px solid black;"><span t-esc="o.format_amount(payment.amount)"/></td>
                                        </tr>
                                    </t>
                                </table>
                            </td>
                        </tr>
                        <tr class="header-table">
                            <td class="header-left" style="background-color: orange; font-size: 8px; border: 1px solid black;">Untuk Pembayaran :</td>
                            <td class="header-right" style="background-color: orange; font-size: 8px; border: 1px solid black;" colspan="2">Penyelesaian bon sementara : (diisi kasir)</td>
                        </tr>
                        <tr class="header-table">
                            <td class="header-left" style="font-size: 8px; border: 1px solid black; vertical-align: top;">
                                <p><span t-field="o.description"/></p>
                            </td>
                            <td class="header-right" colspan="2">
                                <table style="border: none; font-size: 8px;">
                                    <tr>
                                        <th style="width: 20%">Nama PIC BS</th>
                                        <td>: </td>
                                    </tr>
                                    <tr>
                                        <th>No Invoicing BS</th>
                                        <td>: </td>
                                    </tr>
                                    <tr>
                                        <th>Jumlah BS</th>
                                        <td>: Rp</td>
                                    </tr>
                                    <tr>
                                        <th>Pembayaran/Pengembalian BS</th>
                                        <td>: Rp</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr style="border: 1px solid black;">
                            <td rowspan="8" style="width:50%; border: 1px solid black; vertical-align: top; padding: 0; margin: 0;">
                                <table style="font-size: 8px; width: 100%; height: 100%; border-collapse: collapse;" class="signature-box">
                                    <tr class="signature-box-header">
                                        <th style="border-right: 1px solid black; border-bottom: 1px solid black; text-align: center;">Dibuat Oleh</th>
                                        <th style="border-right: 1px solid black; border-bottom: 1px solid black; text-align: center;">Diperiksa Oleh</th>
                                        <th style="border-right: 1px solid black; border-bottom: 1px solid black; text-align: center;">Disetujui Oleh</th>
                                        <th style="text-align: center; border-bottom: 1px solid black;">Kasir</th>
                                    </tr>
                                    <tr>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="height: 100%;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="height: 100%;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="height: 100%;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="height: 100%;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="height: 100%;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="height: 100%;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="height: 100%;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="height: 100%;"></td>
                                    </tr>
                                    <tr>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="height: 100%;"></td>
                                    </tr>
                                    <!-- <tr>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="border-right: 1px solid black; height: 100%;"></td>
                                        <td style="height: 100%;"></td>
                                    </tr> -->
                                    <tr class="signature-box-footer">
                                        <td style="border-right: 1px solid black; text-align: center; padding: 0;">Isi Nama jelas dan Tgl</td>
                                        <td style="border-right: 1px solid black; text-align: center; padding: 0;">Isi Nama jelas dan Tgl</td>
                                        <td style="border-right: 1px solid black; text-align: center; padding: 0;">Isi Nama jelas dan Tgl</td>
                                        <td style="text-align: center; padding: 0;">Isi Nama jelas dan Tgl</td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width:30%; border: 1px solid black;" class="header-table">
                                <table style="border: none; font-size: 8px;">
                                    <tr>
                                        <th style="width: 40%">Jenis Pembayaran</th>
                                        <td>: </td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <th style="text-decoration: underline;">Transfer ke rekening</th>
                                    </tr>
                                    <tr>
                                        <th>Atas Nama</th>
                                        <td>: </td>
                                    </tr>
                                    <tr>
                                        <th>No. Rekening</th>
                                        <td>: </td>
                                    </tr>
                                    <tr>
                                        <th>Bank</th>
                                        <td>: </td>
                                    </tr>
                                </table>
                            </td>
                            <td style="width:20%; border: 1px solid black; vertical-align: top;">
                                <table style="border: none; font-size: 8px; width: 100%; height: 100%;" class="signature-box">
                                    <tr>
                                        <th style="text-align:center;">
                                            Bandung
                                            <span style="display:block;margin-top:5px;">Yang Menerima</span>
                                        </th>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                    </tr>
                                    <!-- <tr>
                                        <td></td>
                                    </tr> -->
                                    <!-- <tr>
                                        <td></td>
                                    </tr> -->
                                    <!-- <tr>
                                        <td></td>
                                    </tr> -->
                                    <tr class="signature-box-footer">
                                        <td style="text-align:center;">Isi Nama jelas dan Tgl</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </t>
            </body>
        </t>
    </template>
</odoo>
